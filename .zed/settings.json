{
  "file_types": {
    "Rust": ["**/*.rs"]
  },
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer"],
      "format_on_save": "on"
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "JSONC": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "Astro": {
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": [
            "--filter",
            "@xmtp/docs",
            "exec",
            "prettier",
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    // nil is disabled: it prompts repeatedly to fetch missing flake inputs.
    // nixd gives the same completion, diagnostics, and navigation.
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "formatter": "language_server"
    },
    "Kotlin": {
      "language_servers": ["kotlin-language-server", "!kotlin-lsp"],
      "format_on_save": "off"
    }
  },
  "lsp": {
    "kotlin-language-server": {
      "settings": {
        "compiler": {
          "jvm": {
            "target": "17"
          }
        }
      }
    },
    "nixd": {
      "settings": {
        "nixd": {
          "formatting": {
            "command": ["nixfmt"]
          }
        }
      }
    },
    "rust-analyzer": {
      "binary": {
        "path": "/bin/bash",
        "arguments": [
          "-c",
          "exec ./dev/nix-shell --shell default --command rust-analyzer"
        ]
      },
      "initialization_options": {
        "cargo": {
          "sysroot": "discover",
          "allTargets": false,
          "buildScripts": {
            "enable": true
          },
          "features": [],
          "extraEnv": {
            "SQLX_OFFLINE": "true"
          }
        },
        "check": {
          "command": "check",
          "workspace": false,
          "allTargets": false,
          "features": []
        },
        "linkedProjects": ["Cargo.toml"],
        "procMacro": {
          "enable": true,
          "attributes": {
            "enable": true
          },
          "ignored": {
            "tracing": ["instrument"],
            "async-recursion": ["async_recursion"],
            "ctor": ["ctor"],
            "tokio": ["test"],
            "async-stream": ["stream", "try_stream"]
          }
        },
        "diagnostics": {
          "enable": true,
          "disabled": [
            "unlinked-file",
            "unresolved-macro-call",
            "unresolved-proc-macro",
            "macro-error"
          ]
        },
        "files": {
          "exclude": ["bindings/wasm"]
        }
      }
    }
  }
}
