{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSameLine": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    "apps/cli/.test-data/**",
    "apps/cli/oclif.manifest.json",
    "apps/cli/dist/**",
    "apps/docs/**/*.astro",
    "apps/docs/.astro/**",
    "apps/docs/.starlight-links-validator/**",
    "apps/docs/._site-*/**",
    "apps/docs/_site/**",
    "apps/docs/dist/**",
    "apps/docs/generated/**",
    "apps/docs/playwright-report/**",
    "apps/docs/src/content/docs/reference/agent-sdk/**",
    "apps/docs/src/content/docs/reference/browser-sdk/**",
    "apps/docs/src/content/docs/reference/node-sdk/**",
    "apps/docs/test-results/**",
    "apps/web-chat/dist/**",
    "dev/release-tools/dist/**",
    "sdks/*/dist/**",
    // Stock ubrn output has any and as casts; see apps/xmtp_sdk_bindgen/GENERATED_LINT.md.
    // The copied runtime and the generated files are checked.
    "target/sdk-generated/*/xmtp_sdk*",
    "target/sdk-generated/*/binding.ts",
    "target/sdk-generated/*/snippets/**"
  ],
  "printWidth": 80,
  "proseWrap": "preserve",
  "semi": true,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "trailingComma": "all"
}
