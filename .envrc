# The cached environment of the default shell (dev/nix-shell). Watch the same
# files as its key, so direnv reloads exactly when the key can change.
watch_file flake.nix flake.lock package.json webdriver.json dev/kache-env dev/kache-darwin-wrapper dev/nix-shell
watch_dir nix
eval "$(dev/nix-shell --print-env default)"
