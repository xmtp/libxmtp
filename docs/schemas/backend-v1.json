{
  "$id": "https://raw.githubusercontent.com/xmtp/libxmtp/self-hosted/docs/schemas/backend-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "Complete backend configuration.",
  "type": "object",
  "properties": {
    "server": {
      "$ref": "#/$defs/ServerConfig",
      "default": {
        "listen": "0.0.0.0:5050",
        "max_drain_duration_ms": 10000
      }
    },
    "database": {
      "$ref": "#/$defs/DatabaseConfig"
    },
    "publishing": {
      "$ref": "#/$defs/PublishingConfig",
      "default": {
        "max_publish_duration_ms": 10000,
        "max_barrier_wait_ms": 1000
      }
    },
    "streams": {
      "$ref": "#/$defs/StreamsConfig",
      "default": {
        "poll_interval_ms": 100,
        "max_gap_ranges": 10000,
        "keepalive_interval_ms": 30000,
        "max_pong_wait_ms": 90000
      }
    },
    "retention": {
      "$ref": "#/$defs/RetentionConfig",
      "default": {
        "group_message_seconds": 7776000,
        "welcome_seconds": 7776000,
        "key_package_seconds": 7776000
      }
    },
    "chains": {
      "type": "object",
      "propertyNames": {
        "pattern": "^eip155:\\+?0*(18446744073709551615|[0-9]{1,19}|[0-0][0-9]{19}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$(?![\\s\\S])"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^\\s/?#]+[^\\s]*$"
          },
          {
            "type": "string",
            "pattern": "^env:[^=\\x00]+$(?![\\s\\S])"
          }
        ]
      },
      "default": {}
    },
    "validation": {
      "$ref": "#/$defs/ValidationConfig",
      "default": {
        "max_scw_cache_entries": 10000
      }
    },
    "limits": {
      "$ref": "#/$defs/LimitsConfig",
      "default": {
        "max_query_topics": 1000,
        "default_query_limit": 100,
        "max_query_limit": 1000,
        "max_newest_metadata_topics": 1000,
        "max_newest_full_topics": 100,
        "max_publish_topics": 1000,
        "max_envelope_bytes": 1048576,
        "max_request_bytes": 26214400,
        "max_response_bytes": 26214400,
        "max_update_adds": 100000,
        "max_update_removes": 100000,
        "max_stream_topics": 100000,
        "max_static_topics": 10000,
        "max_lookup_identifiers": 250,
        "max_scw_signatures": 100,
        "max_identity_entries": 256,
        "max_http2_streams": 100,
        "max_update_frames_per_second": 10,
        "max_update_burst": 100,
        "max_ping_frames_per_second": 10,
        "max_ping_burst": 100
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "database"
  ],
