{
  "containers": [
    {
      "name": "db",
      "image": "postgres:18.6",
      "env": {
        "POSTGRES_PASSWORD": "xmtp",
        "POSTGRES_USER": "xmtp",
        "POSTGRES_DB": "xmtp_backend"
      },
      "healthchecks": [
        {
          "exec": {
            "command": [
              "pg_isready",
              "-U",
              "xmtp",
              "-d",
              "xmtp_backend"
            ]
          },
          "interval": 5,
          "timeout": 3,
          "grace_period": 10
        }
      ]
    },
    {
      "name": "anvil",
      "image": "ghcr.io/foundry-rs/foundry",
      "cmd": [
        "--host",
        "0.0.0.0",
        "--base-fee",
        "100"
      ],
      "healthchecks": [
        {
          "tcp": {
            "port": 8545
          },
          "interval": 5,
          "timeout": 3,
          "grace_period": 10
        }
      ],
      "entrypoint": [
        "anvil"
      ]
    },
    {
      "name": "backend",
      "image": "ghcr.io/xmtp/backend:self-hosted",
      "env": {
        "XMTP_DATABASE_URL": "postgres://xmtp:xmtp@localhost:5432/xmtp_backend",
        "XMTP_CHAIN_31337_URL": "http://localhost:8545"
      },
      "cmd": [
        "--config",
        "/config.toml"
      ],
      "depends_on": [
        {
          "name": "db",
          "condition": "healthy"
        }
      ],
      "healthchecks": [
        {
          "tcp": {
            "port": 5050
          },
          "interval": 5,
          "timeout": 3,
          "grace_period": 30
        }
      ]
    }
  ],
  "services": [
    {
      "internal_port": 5050,
      "protocol": "tcp",
      "ports": [
        {
          "port": 443,
          "handlers": [
            "tls",
            "http"
          ],
          "tls_options": {
            "alpn": [
              "h2"
            ]
          },
          "http_options": {
            "h2_backend": true
          }
        }
      ]
    }
  ],
  "guest": {
    "cpu_kind": "shared",
    "cpus": 8,
    "memory_mb": 8192
  }
}
