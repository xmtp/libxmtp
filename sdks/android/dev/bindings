#!/bin/bash
# Stage matched generated Kotlin and Android JNI libraries.
source "$(dirname "$0")/.setup"
ensure_nix_shell "$@"

if [[ "${1:-}" == "--release" ]]; then
    package="android-sdk-libs"
else
    package="android-sdk-libs-fast"
fi
nix build "${ROOT}#${package}" --out-link "${SDK_ROOT}/.build/bindings"
echo "Generated Android SDK staged in ${SDK_ROOT}/.build/bindings"
