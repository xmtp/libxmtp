#!/usr/bin/env python3
"""Forward the owned emulator's S3 route and hold GET responses for a test."""
import json
import os
import signal
import socket
import socketserver
import subprocess
import sys
import threading

PREFIX = b"/_xmtp_attachment_test/"

class Gate(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True

    def __init__(self, upstream):
        self.upstream = upstream
        self.release = threading.Event()
        self.release.set()
        self.lock = threading.Lock()
        self.held = 0
        self.sockets = set()
        super().__init__(("127.0.0.1", 0), Forward)

    def handle_error(self, request, client_address):
        pass

    def close_connections(self):
        self.release.set()
        with self.lock:
            connections = list(self.sockets)
        for connection in connections:
            try:
                connection.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            connection.close()

class Forward(socketserver.BaseRequestHandler):
    def handle(self):
        client = self.request
        upstream = None
        try:
            first = bytearray()
            while b"\r\n\r\n" not in first and len(first) < 65536:
                part = client.recv(4096)
                if not part:
                    return
                first.extend(part)
            words = first.split(b"\r\n", 1)[0].split(b" ")
            if len(words) < 2:
                return
            method, target = words[:2]
            if target.startswith(PREFIX):
                command = target[len(PREFIX):].split(b"?", 1)[0]
                if command == b"hold":
                    self.server.release.clear()
                elif command == b"release":
                    self.server.release.set()
                with self.server.lock:
                    held = self.server.held
                body = json.dumps({"held_gets": held, "released": self.server.release.is_set()}).encode()
                client.sendall(b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: " + str(len(body)).encode() + b"\r\n\r\n" + body)
                return
            upstream = socket.create_connection(("127.0.0.1", self.server.upstream), timeout=10)
            upstream.settimeout(None)
            with self.server.lock:
                self.server.sockets.update((client, upstream))
            header, body = bytes(first).split(b"\r\n\r\n", 1)
            lines = header.split(b"\r\n")
            # Force a new connection for each response gate. Signed headers and body stay intact.
            lines = [line for line in lines if not line.lower().startswith(b"connection:")]
            upstream.sendall(b"\r\n".join(lines) + b"\r\nConnection: close\r\n\r\n" + body)

            def request_body():
                try:
                    while part := client.recv(65536):
                        upstream.sendall(part)
                except OSError:
                    pass
                finally:
                    try:
                        upstream.shutdown(socket.SHUT_WR)
                    except OSError:
                        pass

            threading.Thread(target=request_body, daemon=True).start()
            if method == b"GET" and not self.server.release.is_set():
                with self.server.lock:
                    self.server.held += 1
                try:
                    self.server.release.wait()
                finally:
                    with self.server.lock:
                        self.server.held -= 1
            while part := upstream.recv(65536):
                client.sendall(part)
        except OSError:
            pass
        finally:
            with self.server.lock:
                self.server.sockets.discard(client)
                if upstream is not None:
                    self.server.sockets.discard(upstream)
            if upstream is not None:
                upstream.close()


def main():
    if len(sys.argv) < 2:
        raise SystemExit("Supply the scoped test command")
    gate = Gate(int(os.environ["XMTP_S3_PORT"]))
    threading.Thread(target=gate.serve_forever, daemon=True).start()
    env = dict(os.environ, XMTP_ANDROID_S3_GATE_PORT=str(gate.server_address[1]))
    print("Owned attachment S3 response gate ready", flush=True)
    child = subprocess.Popen(sys.argv[1:], env=env, start_new_session=True)
    forwarded = False

    def stop(signum, frame):
        nonlocal forwarded
        if not forwarded and child.poll() is None:
            forwarded = True
            os.killpg(child.pid, signum)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        return child.wait()
    finally:
        if child.poll() is None:
            os.killpg(child.pid, signal.SIGTERM)
            try:
                child.wait(timeout=30)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.wait()
        gate.close_connections()
        gate.shutdown()
        gate.server_close()
        print("Owned attachment S3 response gate removed", flush=True)

if __name__ == "__main__":
    sys.exit(main())
