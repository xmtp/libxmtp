{
  "extends": "../../dev/js/tsconfig.node.json",
  "compilerOptions": {
    "isolatedModules": false,
    "noEmit": true,
    "paths": {
      "@test/*": ["./test/*"]
    },
    "preserveConstEnums": true,
    "sourceMap": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "scripts/**/*",
    "test/**/*",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
