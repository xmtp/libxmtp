{
  "extends": "../../dev/js/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals", "react"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/react/**/*.ts",
    "test/react/**/*.tsx",
    "test/public/**/*.ts"
  ]
}
