{
  "extends": "../../dev/js/tsconfig.node.json",
  "compilerOptions": {
    "isolatedModules": false,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "~/*": ["./*"]
    },
    "preserveConstEnums": true,
    "sourceMap": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tsdown.config.ts", "vitest.config.ts", "vitest.setup.ts"]
}
