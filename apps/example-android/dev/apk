#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="$(cd "$APP_ROOT/../.." && pwd)"
VERSION="${XMTP_EXAMPLE_VERSION:-local}"
if ! [[ "$VERSION" =~ ^[a-zA-Z0-9][a-zA-Z0-9.+_-]*$ ]]; then
  echo 'XMTP_EXAMPLE_VERSION must be a filename-safe version.' >&2
  exit 1
fi
OUTPUT="$APP_ROOT/build/apk/xmtp-messenger-$VERSION.apk"
rm -f "$OUTPUT"

# The derivation owns compilation, all four ABIs, and testing-key signing.
RESULT="$APP_ROOT/.build/apk"
env -u LD_LIBRARY_PATH nix build "$ROOT#example-android-apk" --out-link "$RESULT"
if [[ -n "${XMTP_EXAMPLE_VERSION:-}" && "$(cat "$RESULT/version")" != "$VERSION" ]]; then
  echo 'XMTP_EXAMPLE_VERSION must match the Android SDK version in gradle.properties.' >&2
  exit 1
fi

mkdir -p "$(dirname "$OUTPUT")"
cp "$RESULT/xmtp-messenger.apk" "$OUTPUT"
printf '\nTesting APK: %s\n' "$OUTPUT"
