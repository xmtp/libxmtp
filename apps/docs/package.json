{
  "name": "@xmtp/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "pnpm check:examples && astro build",
    "check:examples": "node scripts/check-ts-regions.mjs && node --test tests/sdk-examples.integration.mjs",
    "check:agent-docs": "node scripts/agent-doc-coverage.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "lint": "oxlint -c .oxlintrc.json . && markdownlint '**/*.md' '**/*.mdx' --ignore node_modules --ignore dist --ignore .astro --ignore generated --ignore '_site/**' --ignore 'src/content/docs/reference/*-sdk/**' --ignore CLAUDE.md",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.2",
    "rehype-mermaid": "3.0.0",
    "starlight-links-validator": "0.26.0",
    "starlight-llms-txt": "0.11.0",
    "starlight-typedoc": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "expressive-code": "0.41.7",
    "expressive-code-twoslash": "^0.6.1",
    "lighthouse": "^13.0.0",
    "markdownlint-cli": "0.49.1",
    "pinata": "^2.5.6",
    "prettier": "catalog:",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "catalog:",
    "@xmtp/node-sdk": "workspace:*",
    "@xmtp/browser-sdk": "workspace:*",
    "@xmtp/agent-sdk": "workspace:*",
    "@xmtp/content-type-primitives": "catalog:",
    "viem": "catalog:",
    "chrome-launcher": "^1.2.1",
    "playwright": "catalog:",
    "@types/node": "catalog:node26"
  }
}
