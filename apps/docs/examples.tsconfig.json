{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@xmtp/node-sdk": ["../../sdks/js/node-sdk/dist/index.d.ts"],
      "@xmtp/browser-sdk": ["../../sdks/js/browser-sdk/dist/index.d.ts"],
      "@xmtp/agent-sdk": ["../../sdks/js/agent-sdk/dist/index.d.ts"],
      "@xmtp/agent-sdk/*": ["../../sdks/js/agent-sdk/dist/index.d.ts"]
    }
  },
  "include": ["examples/**/*.ts"]
}
