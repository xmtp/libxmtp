---
import { buildPrompt, type PromptId } from "../../data/homepage-prompts";
interface Props {
  id: PromptId;
  label: string;
  backendField?: boolean;
  variant?: "panel" | "compact" | "group";
}
const { id, label, backendField = false, variant = "compact" } = Astro.props;
---

<home-prompt
  class:list={["prompt", variant]}
  data-prompt={id}
  data-pagefind-ignore
>
  <slot />
  <div class="prompt-actions">
    <button class="home-button copy" type="button" hidden
      >{label} <span aria-hidden="true">↗</span></button
    >
    <slot name="link" />
  </div>
  {
    backendField && (
      <details class="backend" hidden>
        <summary>
          Already have a backend URL? <span aria-hidden="true">+</span>
        </summary>
        <label for={`${id}-backend`}>Backend URL</label>
        <input
          id={`${id}-backend`}
          name="backend"
          type="url"
          placeholder="https://your-backend.example.com"
          autocomplete="off"
          spellcheck="false"
          aria-describedby={`${id}-hint ${id}-status`}
        />
        <p id={`${id}-hint`}>
          Optional. Your coding assistant will check your setup first.
        </p>
      </details>
    )
  }
  <details class="home-disclosure full-prompt">
    <summary>Read the full prompt</summary>
    <pre tabindex="0" aria-label={`${label}, full text`}>{buildPrompt(id)}</pre>
  </details>
  <slot name="code" />
  <p class="status" id={`${id}-status`} role="status" aria-live="polite"></p>
  {
    variant === "panel" && (
      <p class="home-caption">
        For coding assistants with access to your project and terminal.
      </p>
    )
  }
</home-prompt>

<script>
  import {
    buildPrompt,
    prompts,
    type PromptId,
  } from "../../data/homepage-prompts";
  class HomePrompt extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const id = this.dataset.prompt as PromptId;
      if (!(id in prompts)) return;
      const button = this.querySelector<HTMLButtonElement>(".copy");
      const input = this.querySelector<HTMLInputElement>("input");
      const preview = this.querySelector<HTMLPreElement>("pre");
      const status = this.querySelector<HTMLElement>(".status");
      const disclosure = this.querySelector<HTMLDetailsElement>(".full-prompt");
      if (!button || !preview || !status || !disclosure) return;
      const initialLabel = button.innerHTML;
      const update = () => {
        button.innerHTML = initialLabel;
        try {
          const value = buildPrompt(id, input?.value);
          preview.textContent = value;
          status.textContent = "";
          input?.removeAttribute("aria-invalid");
          button.disabled = false;
          return value;
        } catch (error) {
          status.textContent =
            error instanceof Error ? error.message : "Check the backend URL.";
          input?.setAttribute("aria-invalid", "true");
          button.disabled = true;
          return undefined;
        }
      };
      button.hidden = false;
      this.querySelector<HTMLElement>(".backend")?.removeAttribute("hidden");
      input?.addEventListener("input", update, { signal });
      button.addEventListener(
        "click",
        async () => {
          const value = update();
          if (value === undefined) return;
          try {
            await navigator.clipboard.writeText(value);
            if (signal.aborted) return;
            button.textContent = "Copied ✓";
            status.textContent =
              "Prompt copied. Paste it into your coding agent.";
          } catch {
            if (signal.aborted) return;
            disclosure.open = true;
            status.textContent =
              "Could not copy. Select and copy the full prompt below.";
            preview.focus();
          }
        },
        { signal },
      );
    }
    disconnectedCallback() {
      this.controller?.abort();
    }
  }
  if (!customElements.get("home-prompt"))
    customElements.define("home-prompt", HomePrompt);
</script>

<style>
  .prompt.group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 20px;
    align-items: start;
    margin-top: 27px;
  }
  .group .prompt-actions {
    justify-self: end;
    text-align: center;
  }
  .group .full-prompt {
    margin-top: 0;
  }
  .group .status {
    grid-column: 1 / -1;
  }
  @media (max-width: 760px) {
    .prompt.group {
      grid-template-columns: 1fr;
    }
    .group .prompt-actions {
      justify-self: stretch;
    }
    .group .copy {
      width: 100%;
    }
  }
  .prompt {
    display: block;
    min-width: 0;
  }
  .panel {
    border: 1px solid var(--home-line);
    border-radius: 8px;
    background: var(--home-panel);
    padding: 25px 28px;
  }
  .copy {
    margin: 0;
  }
  .compact .copy {
    width: 100%;
    justify-content: space-between;
    font-size: 14px;
    gap: 14px;
    padding: 13px 15px;
  }
  .backend {
    margin-top: 23px;
    border-top: 1px solid var(--home-line);
    padding-top: 15px;
    font-size: 14px;
    color: var(--home-muted);
  }
  .backend summary {
    display: flex;
    justify-content: space-between;
  }
  .backend summary span {
    font-size: 18px;
  }
  .backend[open] summary span {
    transform: rotate(45deg);
  }
  label {
    display: block;
    margin: 18px 0 8px;
    color: var(--home-ink);
  }
  input {
    width: 100%;
    min-width: 0;
    border: 1px solid #ccd2df;
    padding: 12px;
    background: #fff;
    border-radius: 4px;
    font: 14px var(--home-mono);
    color: var(--home-ink);
  }
  .backend p {
    font-size: 14px;
    line-height: 1.6;
    margin-top: 12px;
  }
  .full-prompt {
    margin-top: 12px;
  }
  .compact .full-prompt,
  .group .full-prompt {
    border: 1px solid var(--home-line);
    border-radius: 5px;
    background: var(--home-panel);
    overflow: hidden;
  }
  .compact summary,
  .group summary {
    padding: 13px 14px;
    font-size: 13px;
    color: #505c70;
  }
  pre {
    display: block;
    min-width: 0;
    width: 100%;
    height: 190px;
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font: 13px/1.65 var(--home-mono);
    background: #f3f5f9;
    border: 1px solid var(--home-line);
    border-radius: 5px;
    padding: 14px;
    margin: 12px 0 0;
    color: #465266;
    scrollbar-width: thin;
  }
  .compact pre,
  .group pre {
    border: 0;
    border-top: 1px solid var(--home-line);
    border-radius: 0;
    margin: 0;
    font-size: 12px;
    background: transparent;
    height: 180px;
  }
  .status {
    font-size: 13px;
    color: var(--home-muted);
    margin-top: 12px;
    line-height: 1.5;
  }
  .status:empty {
    display: none;
  }
  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  @media (max-width: 680px) {
    .panel {
      padding: 22px;
    }
    .copy {
      max-width: 100%;
    }
  }
</style>
