---
const { entry } = Astro.locals.starlightRoute;
const generated = /^reference\/(node|browser|agent)-sdk\//.test(entry.id);
---

<h1
  id="_top"
  data-pagefind-weight={generated ? "0.1" : "10"}
  data-pagefind-meta={generated ? undefined : "guideTitle"}
>
  {entry.data.title}
</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
