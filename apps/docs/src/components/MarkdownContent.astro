---
import MarkdownContent from "@astrojs/starlight/components/MarkdownContent.astro";
import { isHomepage } from "../lib/homepage-route";
const generated = /^reference\/(node|browser|agent)-sdk\//.test(
  Astro.locals.starlightRoute.entry.id,
);
---

<div data-pagefind-weight={generated ? "0.1" : "1"}>
  {
    isHomepage(Astro.locals.starlightRoute.entry.id) ? (
      <slot />
    ) : (
      <MarkdownContent>
        <slot />
      </MarkdownContent>
    )
  }
</div>
