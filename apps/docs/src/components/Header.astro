---
import Header from "@astrojs/starlight/components/Header.astro";
import HomeHeader from "./home/HomeHeader.astro";
import { isHomepage } from "../lib/homepage-route";
import { links } from "../data/homepage";
import homeStyles from "../styles/home.css?url";
const home = isHomepage(Astro.locals.starlightRoute.entry.id);
const sections = [
  ["Get started", "/get-started/quickstart/"],
  ["SDK guide", "/sdk/client/"],
  ["Content types", "/content-types/overview/"],
  ["Agents", "/agents/quickstart/"],
  ["Protocol", "/protocol/overview/"],
  ["Specs", "/specs/001-backend-api/"],
  ["Reference", "/reference/limits/"],
];
---

{
  home ? (
    <>
      <link rel="stylesheet" href={homeStyles} />
      <HomeHeader links={links} />
    </>
  ) : (
    <>
      <Header {...Astro.props} />
      <nav class="section-nav" aria-label="Sections">
        {sections.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </nav>
    </>
  )
}
