    "settings.signOut.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your messages and account keys will stay on this device."
          }
        }
      }
    },
    "settings.reset.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes this account and its messages from this device. This cannot be undone."
          }
        }
      }
    },
    "settings.otherHandles.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are still yours, and people can still find you by them."
          }
        }
      }
    },
    "settings.server.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change servers, sign out and join another server."
          }
        }
      }
    },
    "settings.privacy.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message requests let you choose who can contact you. Files are verified before they can be opened or saved. Request files are not downloaded automatically."
          }
        }
      }
    },
    "settings.developer.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unread counts use local insertion time. Equal timestamps and imported messages can change these counts. Open conversation details for raw metadata fields."
          }
        }
      }
    },
    "settings.device.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out ends this session and clears its access token. Your identity and saved messages stay on this device. Delete local data removes this server’s identity, saved messages and local files from this device."
          }
        }
      }
    },
    "Message requests": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message requests"
          }
        }
      }
    },
    "settings.appearance.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how Chats looks on this device."
          }
        }
      }
    }
