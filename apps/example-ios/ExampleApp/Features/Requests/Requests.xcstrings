{
  "sourceLanguage": "en",
  "strings": {
    "requests.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message requests"
          }
        }
      }
    },
    "requests.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages from people you have not accepted yet."
          }
        }
      }
    },
    "requests.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a request to read it. Files in requests stay closed until you choose to download them."
          }
        }
      }
    },
    "requests.accept": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        }
      }
    },
    "requests.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "requests.block": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block"
          }
        }
      }
    },
    "requests.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        }
      }
    },
    "requests.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete or block request?"
          }
        }
      }
    },
    "requests.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading conversations…"
          }
        }
      }
    },
    "requests.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No message requests"
          }
        }
      }
    },
    "requests.empty.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New requests will appear here. You can review them before you reply."
          }
        }
      }
    },
    "requests.block.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block conversation?"
          }
        }
      }
    },
    "requests.block.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This hides this conversation from Chats and Message requests. It does not block other conversations."
          }
        }
      }
    },
    "requests.delete.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete request?"
          }
        }
      }
    },
    "requests.delete.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes this request from the list on this device."
          }
        }
      }
    }
  },
  "version": "1.0"
}
