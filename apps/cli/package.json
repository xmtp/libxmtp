{
  "name": "@xmtp/cli",
  "version": "0.3.0",
  "description": "A command-line interface for XMTP",
  "keywords": [
    "javascript",
    "js",
    "messaging",
    "node",
    "nodejs",
    "web3",
    "xmtp"
  ],
  "homepage": "https://github.com/xmtp/libxmtp/tree/main/apps/cli",
  "bugs": {
    "url": "https://github.com/xmtp/libxmtp/issues"
  },
  "license": "MIT",
  "author": "XMTP Labs <eng@xmtp.com>",
  "repository": {
    "type": "git",
    "url": "git+https://git@github.com/xmtp/libxmtp.git",
    "directory": "apps/cli"
  },
  "bin": {
    "xmtp": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "oclif.manifest.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx bin/dev.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "manifest": "oclif manifest",
    "prepack": "pnpm build && pnpm manifest",
    "start": "tsx bin/run.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oclif/core": "^4.8.0",
    "@oclif/plugin-autocomplete": "^3.2.40",
    "@oclif/plugin-help": "^6.2.37",
    "@oclif/plugin-not-found": "^3.2.74",
    "@oclif/plugin-warn-if-update-available": "^3.1.55",
    "@xmtp/node-bindings": "workspace:*",
    "@xmtp/node-sdk": "workspace:*",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@oclif/plugin-legacy": "^2.0.27",
    "@types/node": "catalog:node26",
    "execa": "^9.6.1",
    "oclif": "^4.22.70",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "oclif": {
    "bin": "xmtp",
    "commands": {
      "identifier": "COMMANDS",
      "strategy": "explicit",
      "target": "./dist/index.js"
    },
    "dirname": "xmtp",
    "helpClass": {
      "identifier": "CustomHelp",
      "target": "./dist/index.js"
    },
    "plugins": [
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-warn-if-update-available"
    ],
    "topicSeparator": " ",
    "topics": {
      "client": {
        "description": "Manage your XMTP client identity and installations"
      },
      "conversation": {
        "description": "Interact with a specific conversation (group or DM)"
      },
      "conversations": {
        "description": "List, create, and stream conversations"
      },
      "preferences": {
        "description": "Manage consent and sync preferences"
      }
    },
    "warn-if-update-available": {
      "frequency": 1,
      "frequencyUnit": "days",
      "message": "<%= config.name %> update available from <%= chalk.greenBright(config.version) %> to <%= chalk.greenBright(latest) %>.",
      "timeoutInDays": 7
    }
  },
  "engines": {
    "node": ">=24"
  }
}
