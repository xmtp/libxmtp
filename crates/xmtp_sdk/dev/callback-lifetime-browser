#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
nix build --no-link .#ubjs-core
core="$(nix path-info .#ubjs-core)"
mkdir -p target/sdk-callback-lifetime/node_modules/@ubjs node_modules/@vitest
ln -sfn "$core/lib/node_modules/@ubjs/core" target/sdk-callback-lifetime/node_modules/@ubjs/core
ln -sfn ../sdks/browser/node_modules/vitest node_modules/vitest
ln -sfn ../../sdks/browser/node_modules/@vitest/browser node_modules/@vitest/browser
ln -sfn ../../sdks/browser/node_modules/@vitest/browser-playwright node_modules/@vitest/browser-playwright
NODE_OPTIONS=--preserve-symlinks sdks/browser/node_modules/.bin/vitest run \
  --config crates/xmtp_sdk/conformance/browser/vitest.callback-lifetime.config.mts
