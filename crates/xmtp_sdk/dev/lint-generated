#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"

generated=target/sdk-generated
crates/xmtp_sdk/dev/check-fork-pin
dev/agent-run cargo clippy -p xmtp-sdk-bindgen --all-targets --no-deps -- -Dwarnings
crates/xmtp_sdk/dev/check-id-spelling \
  "$generated/swift" "$generated/kotlin" \
  "$generated/typescript-napi" "$generated/typescript-wasm"
crates/xmtp_sdk/dev/check-test-hooks --self-test
crates/xmtp_sdk/dev/check-test-hooks "$generated"
crates/xmtp_sdk/dev/check-conformance-exports "$generated"
crates/xmtp_sdk/dev/check-worker-kinds "$generated"
crates/xmtp_sdk/dev/check-encoded-content-shape "$generated"
python3 crates/xmtp_sdk/dev/check-storage-path-async "$generated"
crates/xmtp_sdk/dev/check-message-lifts "$generated"
if rg -n '@xmtp-pure' "$generated" --glob '*.swift' --glob '*.kt' --glob '*.ts'; then
  echo 'pure metadata marker leaked into generated bindings' >&2
  exit 1
fi
crates/xmtp_sdk/dev/check-consumer-types-ts

echo "Stock generated TypeScript is excluded from Oxlint and Oxfmt: upstream templates emit any and as casts (95 no-explicit-any findings)."
echo "Linting only the TypeScript runtime bridge maintained in this repository."
node_modules/.bin/oxlint --config .oxlintrc.json apps/xmtp_sdk_bindgen/runtime
node_modules/.bin/oxfmt --config .oxfmtrc.json --check apps/xmtp_sdk_bindgen/runtime
node_modules/.bin/tsc --noEmit --skipLibCheck --target es2022 --module esnext --moduleResolution bundler \
  crates/xmtp_sdk/conformance/ts/logging.typecheck.ts
