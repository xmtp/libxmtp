#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"

crates/xmtp_sdk/dev/check-file-sizes

generated=target/sdk-generated
# The checks below read every target root. A missing root makes rg exit 2,
# and a check that tests `if rg ...` then passes without reading a file.
for language in swift kotlin typescript-napi typescript-wasm typescript-pure; do
  if [ ! -d "$generated/$language" ]; then
    echo "missing $generated/$language: run \`just sdk generate\` (or \`just sdk render\` after \`just sdk build\`) first" >&2
    exit 1
  fi
done
crates/xmtp_sdk/dev/check-fork-pin
dev/agent-run cargo clippy -p xmtp-sdk-bindgen --all-targets --no-deps -- -Dwarnings
crates/xmtp_sdk/dev/check-public-names "$generated"
crates/xmtp_sdk/dev/check-test-hooks --self-test
crates/xmtp_sdk/dev/check-test-hooks "$generated"
crates/xmtp_sdk/dev/check-conformance-exports "$generated"
crates/xmtp_sdk/dev/check-encoded-content-shape "$generated"
python3 crates/xmtp_sdk/dev/check-storage-path-async "$generated"
crates/xmtp_sdk/dev/check-message-lifts "$generated"
node crates/xmtp_sdk/dev/test-pure-wasm.mjs
node crates/xmtp_sdk/dev/check-pure-wasm.mjs
# Any @xmtp-name is marker text, unless it starts a package path (@xmtp-org/pkg).
if rg -n '@xmtp-[a-z][a-z0-9-]*([^a-z0-9/-]|$)' "$generated" --glob '*.swift' --glob '*.kt' --glob '*.ts'; then
  echo 'a metadata marker leaked into generated bindings' >&2
  exit 1
fi
crates/xmtp_sdk/dev/check-consumer-types-ts

echo "Linting bridge runtime and generated bridge files; stock ubrn output stays excluded."
bash crates/xmtp_sdk/dev/check-wasm-init
node_modules/.bin/oxlint --config .oxlintrc.json apps/xmtp_sdk_bindgen/runtime/ts
node_modules/.bin/oxfmt --config .oxfmtrc.json --check apps/xmtp_sdk_bindgen/runtime/ts
node_modules/.bin/oxlint --config .oxlintrc.json "$generated/typescript-wasm/"*.gen.ts "$generated/typescript-wasm/"*.gen.test.ts "$generated/typescript-wasm/index.ts"
node_modules/.bin/oxfmt --config apps/xmtp_sdk_bindgen/templates/bridge/oxfmt.json --check "$generated/typescript-wasm/"*.gen.ts "$generated/typescript-wasm/"*.gen.test.ts
sdks/node/node_modules/.bin/tsc --noEmit --strict --skipLibCheck --module preserve --moduleResolution bundler --target es2022 --allowImportingTsExtensions --typeRoots sdks/node/node_modules/@types --types node "$generated/typescript-wasm/"*.gen.ts
node crates/xmtp_sdk/dev/check-bridge-casts.mjs
# The pure module's public entry: lint and strict types.
node_modules/.bin/oxlint --config .oxlintrc.json "$generated/typescript-pure/"*.gen.ts "$generated/typescript-pure/index.ts"
sdks/node/node_modules/.bin/tsc --noEmit --strict --skipLibCheck --module preserve --moduleResolution bundler --target es2022 --allowImportingTsExtensions "$generated/typescript-pure/index.ts"
node_modules/.bin/tsc --noEmit --skipLibCheck --target es2022 --module esnext --moduleResolution bundler \
  crates/xmtp_sdk/conformance/ts/logging.typecheck.ts
node_modules/.bin/tsc --noEmit --strict --skipLibCheck --target es2022 --module preserve --moduleResolution bundler --typeRoots sdks/node/node_modules/@types --types node \
  crates/xmtp_sdk/conformance/ts/parity.test-d.ts
python3 crates/xmtp_sdk/dev/check-parity-signatures.py
node_modules/.bin/tsc --noEmit --skipLibCheck --target es2022 --module preserve --moduleResolution bundler --allowImportingTsExtensions \
  crates/xmtp_sdk/conformance/browser/suite.chromium.ts crates/xmtp_sdk/conformance/browser/suite.worker.ts \
  crates/xmtp_sdk/conformance/browser/attachments.chromium.ts crates/xmtp_sdk/conformance/browser/attachment-lifetime.chromium.ts \
  crates/xmtp_sdk/conformance/browser/storage.layout.chromium.ts
