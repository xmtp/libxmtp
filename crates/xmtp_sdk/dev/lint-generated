#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"

prepared="${XMTP_SDK_PREPARED_PRODUCTS:-0}"
generated=target/sdk-generated
if [[ "$prepared" == 1 ]]; then
  generated="${XMTP_SDK_GENERATED_DIR:?Prepared checks need the verified generated union}"
  # Some runtime checks import the union through fixed repository paths.
  # Do not lint a different tree while those checks read the union.
  if [[ "$(realpath -m "$generated")" != "$root/target/sdk-generated" ]]; then
    echo 'Prepared checks require the verified target/sdk-generated union' >&2
    exit 1
  fi
  runtime_root="${XMTP_SDK_RUNTIME_DIR:?Prepared checks need the verified pinned runtimes}"
  for package in core node wasm; do
    if [[ ! -f "$runtime_root/$package/package.json" &&
          ! -f "$runtime_root/lib/node_modules/@ubjs/$package/package.json" ]]; then
      echo "Prepared pinned runtime is missing: $package" >&2
      exit 1
    fi
  done
elif [[ "$prepared" != 0 ]]; then
  echo 'XMTP_SDK_PREPARED_PRODUCTS must be 0 or 1' >&2
  exit 1
fi

crates/xmtp_sdk/dev/check-file-sizes

# The checks below read every target root. A missing root makes rg exit 2,
# and a check that tests `if rg ...` then passes without reading a file.
for language in swift kotlin typescript-napi typescript-wasm typescript-pure; do
  if [ ! -d "$generated/$language" ]; then
    echo "missing $generated/$language: run \`just sdk generate\` (or \`just sdk render\` after \`just sdk build\`) first" >&2
    exit 1
  fi
done
crates/xmtp_sdk/dev/check-fork-pin
if [[ "$prepared" != 1 ]]; then
  dev/agent-run cargo clippy -p xmtp-sdk-bindgen --all-targets --no-deps -- -Dwarnings
fi
crates/xmtp_sdk/dev/check-public-names "$generated"
crates/xmtp_sdk/dev/check-test-hooks --self-test
crates/xmtp_sdk/dev/check-test-hooks "$generated"
crates/xmtp_sdk/dev/check-conformance-exports "$generated"
crates/xmtp_sdk/dev/check-encoded-content-shape "$generated"
python3 crates/xmtp_sdk/dev/check-storage-path-async "$generated"
crates/xmtp_sdk/dev/check-message-lifts "$generated"
node crates/xmtp_sdk/dev/check-pure-wasm.mjs
# Any @xmtp-name is marker text, unless it starts a package path (@xmtp-org/pkg).
if rg -n '@xmtp-[a-z][a-z0-9-]*([^a-z0-9/-]|$)' "$generated" --glob '*.swift' --glob '*.kt' --glob '*.ts'; then
  echo 'a metadata marker leaked into generated bindings' >&2
  exit 1
fi

echo "Linting the runtime and generated files; stock ubrn output stays excluded."
bash crates/xmtp_sdk/dev/check-wasm-init
bash crates/xmtp_sdk/dev/link-runtime-packages \
  "$generated/typescript-napi" "$generated/typescript-wasm" "$generated/typescript-pure"
# The runtime imports the binding and the files generated beside it, so its
# copies in the generated trees are linted and typechecked, with the real
# binding. A target replaces some runtime files with its own.
node_modules/.bin/oxfmt --config .oxfmtrc.json --check apps/xmtp_sdk_bindgen/runtime/ts
for tree in typescript-napi typescript-wasm typescript-pure; do
  runtime="$generated/$tree/runtime"
  # oxlint and oxfmt without a path read the whole repository.
  if [ ! -d "$runtime" ]; then
    echo "missing $runtime: run \`just sdk generate\` first" >&2
    exit 1
  fi
  runtime_files=()
  while IFS= read -r -d '' file; do
    runtime_files+=("$file")
  done < <(find "$runtime" -name '*.ts' -print0 | sort -z)
  if [ "${#runtime_files[@]}" -eq 0 ]; then
    echo "$runtime has no TypeScript files" >&2
    exit 1
  fi
  node_modules/.bin/oxlint --config .oxlintrc.json "${runtime_files[@]}"
  node_modules/.bin/oxfmt --config .oxfmtrc.json --check "${runtime_files[@]}"
  if [ "$tree" != typescript-pure ]; then
    sdks/node/node_modules/.bin/tsc --noEmit --strict --skipLibCheck --isolatedModules --esModuleInterop \
      --module preserve --moduleResolution bundler --target es2024 --lib ES2024,DOM,WebWorker \
      --typeRoots sdks/node/node_modules/@types --types node "${runtime_files[@]}"
  fi
done
node_modules/.bin/oxlint --config .oxlintrc.json "$generated/typescript-napi/"*.gen.ts "$generated/typescript-napi/index.ts"
node_modules/.bin/oxlint --config .oxlintrc.json "$generated/typescript-wasm/"*.gen.ts "$generated/typescript-wasm/"*.gen.test.ts "$generated/typescript-wasm/index.ts"
node_modules/.bin/oxfmt --config apps/xmtp_sdk_bindgen/templates/bridge/oxfmt.json --check "$generated/typescript-wasm/"*.gen.ts "$generated/typescript-wasm/"*.gen.test.ts
sdks/node/node_modules/.bin/tsc --noEmit --strict --skipLibCheck --module preserve --moduleResolution bundler --target es2022 --allowImportingTsExtensions --typeRoots sdks/node/node_modules/@types --types node "$generated/typescript-wasm/"*.gen.ts
node crates/xmtp_sdk/dev/check-bridge-casts.mjs
# The pure module's public entry: lint and strict types.
node_modules/.bin/oxlint --config .oxlintrc.json "$generated/typescript-pure/"*.gen.ts "$generated/typescript-pure/index.ts"
sdks/node/node_modules/.bin/tsc --noEmit --strict --skipLibCheck --module preserve --moduleResolution bundler --target es2022 --allowImportingTsExtensions "$generated/typescript-pure/index.ts"
node_modules/.bin/tsc --noEmit --skipLibCheck --target es2022 --module preserve --moduleResolution bundler --allowImportingTsExtensions \
  sdks/browser/test/platform/suite.worker.ts sdks/browser/test/platform/attachment-lifetime.chromium.ts \
  sdks/browser/test/platform/storage.layout.chromium.ts
