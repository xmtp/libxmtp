#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
fixtures=crates/xmtp_sdk/conformance/public
log="$(mktemp)"
swift_negative="$fixtures/swift/Sources/PublicConsumer/RawAccess.swift"
kotlin_negative="$fixtures/kotlin/consumer/src/main/kotlin/RawAccess.kt"
trap 'rm -f "$log" "$swift_negative" "$kotlin_negative"' EXIT

swift_build() {
  NIX_DEVSHELL=ios dev/nix-shell "swift build --package-path $fixtures/swift -Xswiftc -strict-concurrency=complete"
}
kotlin_build() {
  NIX_DEVSHELL=android dev/nix-shell "sdks/android/gradlew -p $fixtures/kotlin :consumer:compileDebugKotlin --no-daemon -q"
}

failed=0
for host in swift kotlin; do
  if [ "$host" = swift ]; then
    cases="$fixtures/swift/Negative/CodecRecords"
    negative="$swift_negative"
  else
    cases="$fixtures/kotlin/negative/codec_records"
    negative="$kotlin_negative"
  fi
  rm -f "$negative"
  if ! "${host}_build" >"$log" 2>&1; then
    cat "$log" >&2
    echo "$host positive package control failed" >&2
    exit 1
  fi
  for source in "$cases"/*; do
    cp "$source" "$negative"
    name="$(basename "$source")"
    call_line="$(rg -n 'StandardContent\.(text|Text)' "$source" | cut -d: -f1)"
    test "$(printf '%s\n' "$call_line" | wc -l | tr -d ' ')" -eq 1
    echo "CASE: $host $name $(sed -n "${call_line}p" "$source")"
    if "${host}_build" >"$log" 2>&1; then
      echo "UNEXPECTED ACCEPT: $host $name"
      failed=1
    elif [ "$host" = swift ] && rg -q "RawAccess.swift:${call_line}:[0-9]+: error:.*cannot convert value of type 'StandardContent'" "$log"; then
      echo "REJECTED: $host $name"
      rg "RawAccess.swift:${call_line}:[0-9]+: error:" "$log" | head -1
    elif [ "$host" = kotlin ] && rg -q "RawAccess.kt:${call_line}:[0-9]+ (Argument type mismatch.*StandardContent.*${name%%-*}Content)" "$log"; then
      echo "REJECTED: $host $name"
      rg "RawAccess.kt:${call_line}:[0-9]+" "$log" | head -1
    else
      cat "$log" >&2
      echo "$host $name failed outside the expected wrong-value call" >&2
      exit 1
    fi
  done
  rm -f "$negative"
done
exit "$failed"
