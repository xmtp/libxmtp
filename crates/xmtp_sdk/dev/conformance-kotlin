#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
bash crates/xmtp_sdk/dev/conformance-generate --targets kotlin
NIX_DEVSHELL=android dev/nix-shell 'export RUST_MIN_STACK=16777216; sdks/android/gradlew -p crates/xmtp_sdk/conformance/kotlin run --no-daemon'
negative=crates/xmtp_sdk/conformance/kotlin/src/main/kotlin/ConsumerNegative.kt
log="$(mktemp)"
trap 'rm -f "$negative" "$log"' EXIT
cp crates/xmtp_sdk/conformance/kotlin/negative/ConsumerNegative.kt "$negative"
if NIX_DEVSHELL=android dev/nix-shell 'sdks/android/gradlew -p crates/xmtp_sdk/conformance/kotlin compileKotlin --no-daemon' >"$log" 2>&1; then
  echo "Kotlin negative consumer compiled" >&2
  exit 1
fi
grep -q "ConversationId" "$log"
grep -q "EncodedContent" "$log"
grep -q "Group" "$log"
grep -q "MessageId" "$log"
cp crates/xmtp_sdk/conformance/kotlin/negative/CodecTypeNegative.kt "$negative"
if NIX_DEVSHELL=android dev/nix-shell 'sdks/android/gradlew -p crates/xmtp_sdk/conformance/kotlin compileKotlin --no-daemon' >"$log" 2>&1; then
  echo "Kotlin codec type negative consumer compiled" >&2
  exit 1
fi
# The encode, Group and Dm send and prepareMessage, Conversation send, and
# reply calls each reject an Int value with a type mismatch: seven distinct
# source lines. The compiler reports a send against the envelope overload, and
# the reply as no applicable candidate.
test "$(grep -E "^e: .*ConsumerNegative.kt:[0-9]+:[0-9]+ (Argument type mismatch: actual type is 'kotlin.Int'|None of the following candidates is applicable)" "$log" | grep -o "ConsumerNegative.kt:[0-9]*:" | sort -u | wc -l | tr -d ' ')" -eq 7
grep -q "Argument type mismatch: actual type is 'kotlin.Int', but 'kotlin.String' was expected." "$log"
grep -q "Unresolved reference 'SDKContentCodec'" "$log"
echo "Kotlin ID, content, and Group/Dm consumer checks passed"
