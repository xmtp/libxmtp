#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
bash crates/xmtp_sdk/dev/conformance-generate
runtime=target/sdk-conformance/kotlin/runtime/SDKClient.kt
cp apps/xmtp_sdk_bindgen/runtime/kotlin/SDKClient.kt "$runtime"
python3 crates/xmtp_sdk/conformance/inject_reader_gate.py kotlin "$runtime"
NIX_DEVSHELL=android dev/nix-shell 'export RUST_MIN_STACK=16777216; export SDK_SIGN_KEY="$(openssl rand -hex 32)"; export SDK_NODE_BIN="$(command -v node)"; export SDK_SIGN_SCRIPT="$PWD/crates/xmtp_sdk/conformance/ts/sign.mjs"; sdks/android/gradlew -p crates/xmtp_sdk/conformance/kotlin run --no-daemon'
negative=crates/xmtp_sdk/conformance/kotlin/src/main/kotlin/ConsumerNegative.kt
log="$(mktemp)"
trap 'rm -f "$negative" "$log"' EXIT
cp crates/xmtp_sdk/conformance/kotlin/negative/ConsumerNegative.kt "$negative"
if NIX_DEVSHELL=android dev/nix-shell 'sdks/android/gradlew -p crates/xmtp_sdk/conformance/kotlin compileKotlin --no-daemon' >"$log" 2>&1; then
  echo "Kotlin negative consumer compiled" >&2
  exit 1
fi
grep -q "ConversationID" "$log"
grep -q "EncodedContent" "$log"
grep -q "Group" "$log"
echo "Kotlin ID, content, and Group/Dm consumer checks passed"
