#!/usr/bin/env bash
# shellcheck disable=SC2016
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
swift_dir=crates/xmtp_sdk/conformance/swift
bash crates/xmtp_sdk/dev/check-swift-entrypoint "$swift_dir/Sources/Conformance"
bash crates/xmtp_sdk/dev/conformance-generate --targets swift
bash crates/xmtp_sdk/dev/stage-conformance-swift
NIX_DEVSHELL=ios dev/nix-shell 'export RUST_MIN_STACK=8388608; export SDK_SIGN_KEY="$(openssl rand -hex 32)"; export SDK_NODE_BIN="$(command -v node)"; export SDK_SIGN_SCRIPT="$PWD/crates/xmtp_sdk/conformance/ts/sign.mjs"; export SDK_OPENSSL_LIB_DIR="$(pkg-config --variable=libdir openssl)"; SDK_RELAY_TARGET="$XMTP_BACKEND_URL" bash crates/xmtp_sdk/dev/with-object-store bash crates/xmtp_sdk/dev/run-conformance-swift-app'
if [[ "${SDK_CALLBACK_LIFETIME:-}" == 1 || "${SDK_SWIFT_CALLER_CANCELLATION:-}" == 1 ]]; then exit 0; fi
fixture_dir=target/sdk-conformance-apple/crates/xmtp_sdk/conformance/swift
negative="$fixture_dir/Sources/Conformance/ConsumerNegative.swift"
log="$(mktemp)"
trap 'rm -f "$negative" "$log"' EXIT
cp "$swift_dir/Negative/ConsumerNegative.swift" "$negative"
if NIX_DEVSHELL=ios dev/nix-shell 'export SDK_OPENSSL_LIB_DIR="$(pkg-config --variable=libdir openssl)"; swift build --package-path target/sdk-conformance-apple/crates/xmtp_sdk/conformance/swift -Xswiftc -enable-testing -Xswiftc -strict-concurrency=complete' >"$log" 2>&1; then
  echo "Swift negative consumer compiled" >&2
  exit 1
fi
# A codec value type must be Sendable (a diagnostic in Swift 5 language mode).
grep -q "type 'NonSendableValue' does not conform to the 'Sendable' protocol" "$log"
grep -q "stored property 'count' of 'Sendable'-conforming class 'MutableCodec' is mutable" "$log"
cp "$swift_dir/Negative/CodecTypeNegative.swift" "$negative"
if NIX_DEVSHELL=ios dev/nix-shell 'export SDK_OPENSSL_LIB_DIR="$(pkg-config --variable=libdir openssl)"; swift build --package-path target/sdk-conformance-apple/crates/xmtp_sdk/conformance/swift -Xswiftc -enable-testing -Xswiftc -strict-concurrency=complete' >"$log" 2>&1; then
  echo "Swift codec type negative consumer compiled" >&2
  exit 1
fi
# The encode, Group and Dm send and prepareMessage, Conversation send, and
# reply calls each reject an Int value: seven distinct source lines (the
# compiler prints each error twice).
test "$(grep -o "ConsumerNegative.swift:[0-9]*:[0-9]*: .*cannot convert value of type 'Int' to expected argument type 'String'" "$log" | cut -d: -f2 | sort -u | wc -l | tr -d ' ')" -eq 7
grep -q "cannot find type 'SDKContentCodec' in scope" "$log"
cp "$swift_dir/Negative/ConsumerTypeNegative.swift" "$negative"
if NIX_DEVSHELL=ios dev/nix-shell 'export SDK_OPENSSL_LIB_DIR="$(pkg-config --variable=libdir openssl)"; swift build --package-path target/sdk-conformance-apple/crates/xmtp_sdk/conformance/swift -Xswiftc -enable-testing -Xswiftc -strict-concurrency=complete' >"$log" 2>&1; then
  echo "Swift negative consumer compiled" >&2
  exit 1
fi
grep -q "cannot convert value of type 'Int' to specified type 'ConversationId'" "$log"
grep -q "cannot convert value of type 'MessageContent' to specified type 'EncodedContent'" "$log"
grep -q "cannot convert value of type 'Conversation' to specified type 'Group'" "$log"
grep -q "cannot convert value of type 'Int' to expected argument type 'MessageId'" "$log"
echo "Swift ID, content, and Group/Dm consumer checks passed"
