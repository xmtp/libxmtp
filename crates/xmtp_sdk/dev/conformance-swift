#!/usr/bin/env bash
# shellcheck disable=SC2016
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
swift_dir=crates/xmtp_sdk/conformance/swift
bash crates/xmtp_sdk/dev/check-swift-entrypoint "$swift_dir/Sources/Conformance"
bash crates/xmtp_sdk/dev/conformance-generate
bash crates/xmtp_sdk/dev/stage-conformance-swift
NIX_DEVSHELL=ios dev/nix-shell 'export RUST_MIN_STACK=8388608; export SDK_SIGN_KEY="$(openssl rand -hex 32)"; export SDK_NODE_BIN="$(command -v node)"; export SDK_SIGN_SCRIPT="$PWD/crates/xmtp_sdk/conformance/ts/sign.mjs"; export SDK_OPENSSL_LIB_DIR="$(pkg-config --variable=libdir openssl)"; swift run --package-path crates/xmtp_sdk/conformance/swift XmtpSdkConformance'
negative="$swift_dir/Sources/Conformance/ConsumerNegative.swift"
log="$(mktemp)"
trap 'rm -f "$negative" "$log"' EXIT
cp "$swift_dir/Negative/ConsumerNegative.swift" "$negative"
if NIX_DEVSHELL=ios dev/nix-shell 'export SDK_OPENSSL_LIB_DIR="$(pkg-config --variable=libdir openssl)"; swift build --package-path crates/xmtp_sdk/conformance/swift -Xswiftc -strict-concurrency=complete' >"$log" 2>&1; then
  echo "Swift negative consumer compiled" >&2
  exit 1
fi
grep -q "cannot convert value of type 'String' to specified type 'ConversationID'" "$log"
grep -q "cannot convert value of type 'MessageContent' to specified type 'EncodedContent'" "$log"
grep -q "cannot convert value of type 'Conversation' to specified type 'Group'" "$log"
grep -q "cannot convert value of type 'String' to expected argument type 'MessageID'" "$log"
grep -q "NonSendableCodec.*does not conform to protocol 'SDKContentCodec'" "$log"
grep -q "stored property 'count' of 'Sendable'-conforming class 'MutableCodec' is mutable" "$log"
echo "Swift ID, content, and Group/Dm consumer checks passed"
