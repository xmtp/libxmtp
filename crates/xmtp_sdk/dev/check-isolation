#!/usr/bin/env bash
set -euo pipefail

# GitHub runs a stacked PR's checks against the stack trunk, so this diff
# includes the PRs below it. Only shipped code in sdks/ and bindings/ is
# guarded: tests and changelogs there may change. The four Task 1 SDK source
# files may contain only their reviewed PROC-032 backlink removal. Compare
# their full bytes with the base after that one replacement. This does not
# mistake string content or text outside KDoc for a comment.
base=$(git merge-base HEAD origin/self-hosted)
if [ -z "$(git diff --name-only "$base" -- crates/xmtp_sdk/ apps/xmtp_sdk_bindgen/)" ]; then
  exit 0
fi

changed=$(git diff --no-renames --name-only "$base" -- sdks/ bindings/)
blocked=""
while IFS= read -r path; do
  [ -z "$path" ] && continue
  status=$(git diff --no-renames --name-status "$base" -- "$path" | cut -f1)
  case "$path" in
    *.sh|*.bash|*.zsh|*.command|*.ps1|*.d.ts|*generated*|*Generated*|*/script/*|*/scripts/*|*/dev/*|*/bin/*|sdks/ios/Sources/XMTPiOS/Libxmtp/xmtpv3.swift)
      blocked+="$path"$'\n'; continue ;;
  esac
  if [[ "$status" == M ]] &&
    [ -n "$(git diff --no-renames --summary "$base" -- "$path")" ]; then
    blocked+="$path"$'\n'
    continue
  fi
  case "$path" in
    */test/*|*/tests/*|*/Tests/*|*/androidTest/*|*.test.ts|*.test.js|*_test.rs|*/CHANGELOG.md)
      continue ;;
  esac
  case "$path" in
    sdks/node/src/MessageStream.ts|sdks/browser/src/MessageStream.ts|sdks/ios/Sources/XMTPiOS/MessageDeliveryStream.swift|sdks/android/library/src/main/java/org/xmtp/android/library/MessageDeliveryFlow.kt) ;;
    *) blocked+="$path"$'\n'; continue ;;
  esac
  if [[ "$status" != M ]] ||
    ! git show "$base:$path" | python3 -c '
import sys

lines = {
    "sdks/node/src/MessageStream.ts": b"  // implements: PROC-028, PROC-031, PROC-032\n",
    "sdks/browser/src/MessageStream.ts": b"  // implements: PROC-028, PROC-031, PROC-032\n",
    "sdks/ios/Sources/XMTPiOS/MessageDeliveryStream.swift": b"\t// implements: PROC-028, PROC-031, PROC-032\n",
    "sdks/android/library/src/main/java/org/xmtp/android/library/MessageDeliveryFlow.kt": b" * implements: PROC-028, PROC-031, PROC-032\n",
}
data = sys.stdin.buffer.read()
old = lines[sys.argv[1]]
if data.count(old) != 1:
    sys.exit(1)
sys.stdout.buffer.write(data.replace(old, old.replace(b", PROC-032", b""), 1))
' "$path" | cmp -s - "$path"; then
    blocked+="$path"$'\n'
  fi
done <<< "$changed"
if [ -n "$blocked" ]; then
  echo "SDK facade changes cannot alter shipped code in sdks/ or bindings/:" >&2
  printf '%s' "$blocked" >&2
  exit 1
fi
