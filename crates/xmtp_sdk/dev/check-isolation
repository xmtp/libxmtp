#!/usr/bin/env bash
set -euo pipefail

# Phase 1 shared preparation may change package.json, pnpm-lock.yaml,
# flake.nix, nix/package/xmtp-sdk*.nix, nix/{node,android}-packages.nix,
# crates/xmtp_sdk/dev and sdk.just, and .github/workflows/test-sdk.yml.
# These paths do not switch a shipped SDK source or remove old bindings.
# Only shipped code in sdks/ and bindings/ is guarded: tests and changelogs there may change
# (spec evidence, and owner-approved behaviour changes made in core). The four Task 1 SDK source
# files may contain only their reviewed PROC-032 backlink removal. Compare their full bytes with
# the base after that one replacement. This does not mistake string content or text outside KDoc
# for a comment.
# Reviewed SDK-040 files, native CI documentation, and the build-only WASM
# log recipe have content pins in crates/xmtp_sdk/dev/isolation-pins.tsv.
# The reviewed PROC-052 reader repair pins the retained WASM reader and four
# legacy SDK stream wrappers. Switched SDK deletions keep their own admission.
# Each pin is a reviewed Git blob hash. A listed
# file passes only while its content hashes to that pin, so a later pull request cannot change it
# freely. After the last reviewed change to a listed file, refresh the pins with
# `crates/xmtp_sdk/dev/check-isolation --pin` and commit the table with that change.
# A stacked pull request is checked against its own base, so a lower PR's changes do not count.
# A given base branch wins. In a pull request run (no argument), HEAD is GitHub's merge commit
# and its first parent is the base; the workflow's base_ref can name the stack's trunk instead,
# so the merge commit wins over self-hosted. A local branch whose tip merges trunk also has a
# second parent, so run the gate locally with a base branch, for example
# `just sdk check-isolation self-hosted`.
fail_query() {
  echo "SDK isolation gate could not inspect Git state: $1" >&2
  exit 1
}

pins_file="$(dirname "${BASH_SOURCE[0]}")/isolation-pins.tsv"
if [ "${1:-}" = "--pin" ]; then
  # Rewrite every pin with the hash of the file's current content.
  tmp=$(mktemp)
  while IFS=$'\t' read -r path _; do
    [ -z "$path" ] && continue
    printf '%s\t%s\n' "$path" "$(git hash-object "$path")" >> "$tmp"
  done < "$pins_file"
  mv "$tmp" "$pins_file"
  echo "Pinned $(wc -l < "$pins_file" | tr -d ' ') reviewed exception files" >&2
  exit 0
fi

if [ -n "${1:-}" ]; then
  base_ref="origin/$1"
  if ! base=$(git merge-base HEAD "$base_ref"); then
    fail_query "merge base"
  fi
elif git rev-parse -q --verify HEAD^2 >/dev/null; then
  base_ref="HEAD^1"
  if ! base=$(git rev-parse HEAD^1); then
    fail_query "merge commit base"
  fi
else
  base_ref="origin/self-hosted"
  if ! base=$(git merge-base HEAD "$base_ref"); then
    fail_query "merge base"
  fi
fi
echo "Checking SDK isolation against $base_ref" >&2
if ! facade_changed=$(git diff --name-only "$base" -- crates/xmtp_sdk/ apps/xmtp_sdk_bindgen/); then
  fail_query "façade paths"
fi
if [ -z "$facade_changed" ]; then
  exit 0
fi

if ! changed=$(git diff --no-renames --name-only "$base" -- sdks/ bindings/); then
  fail_query "SDK and binding paths"
fi
if ! base_file=$(mktemp); then
  fail_query "temporary base file"
fi
trap 'rm -f "$base_file"' EXIT
# A Phase 2 switch admits only its own SDK directory. Old sibling SDKs and
# retained binding producers still use the exact pre-switch guard below.
if ! switched=$(python3 dev/sdk/switches.py); then
  fail_query "SDK switch markers"
fi
blocked=""
while IFS= read -r path; do
  [ -z "$path" ] && continue
  if ! name_status=$(git diff --no-renames --name-status "$base" -- "$path"); then
    fail_query "status for $path"
  fi
  status=${name_status%%$'\t'*}
  if [ -z "$status" ]; then
    fail_query "empty status for $path"
  fi
  # A file-mode change fails on every path, allowlisted or not.
  if [[ "$status" == M ]]; then
    if ! summary=$(git diff --no-renames --summary "$base" -- "$path"); then
      fail_query "mode summary for $path"
    fi
    if [ -n "$summary" ]; then
      blocked+="$path"$'\n'
      continue
    fi
  fi
  # Native CI retires these three Fly helpers. Permit only deletion of their
  # reviewed base contents; changes or replacement files remain guarded.
  retired_fly_blob=""
  case "$status:$path" in
    D:sdks/ios/dev/fly/cleanup) retired_fly_blob=8a7ef210cb53a4574a5b544742de0343463a7de6 ;;
    D:sdks/ios/dev/fly/deploy) retired_fly_blob=96ac06464aa6c9be33f5e79de2dadc8c55b1a49e ;;
    D:sdks/ios/dev/fly/machine-config.json) retired_fly_blob=3aa94864bfd2c52f4f1833f55c36793fe517e3a6 ;;
  esac
  if [ -n "$retired_fly_blob" ]; then
    if ! actual=$(git rev-parse "$base:$path"); then
      fail_query "base hash for $path"
    fi
    if [ "$actual" = "$retired_fly_blob" ]; then
      continue
    fi
    blocked+="$path"$'\n'
    continue
  fi
  admitted=false
  while IFS= read -r directory; do
    if [ -n "$directory" ] && [[ "$path" == "$directory"* ]]; then
      admitted=true
      break
    fi
  done <<< "$switched"
  if $admitted; then
    continue
  fi
  # Scripts and generated output fail on every unswitched path. The one carve-out is the
  # regenerated Swift bindings as a modification under SDK-040 exception 1
  # (below); the bindings-check job matches that file against the Rust source.
  case "$path" in
    *.sh|*.bash|*.zsh|*.command|*.ps1|*.d.ts|*generated*|*Generated*|*/script/*|*/scripts/*|*/dev/*|*/bin/*|sdks/ios/Sources/XMTPiOS/Libxmtp/xmtpv3.swift)
      if [ "$status:$path" != "M:sdks/ios/Sources/XMTPiOS/Libxmtp/xmtpv3.swift" ]; then
        blocked+="$path"$'\n'; continue
      fi ;;
  esac
  case "$path" in
    */test/*|*/tests/*|*/Tests/*|*/androidTest/*|*.test.ts|*.test.js|*_test.rs|*/CHANGELOG.md|*/AGENTS.md)
      continue ;;
  esac
  # Design SDK-040 names two narrow pre-cutover exceptions, each an exact file
  # list pinned to reviewed content (see the header). Every other shipped
  # change still fails, and so does any change to a listed file whose content
  # is not the pinned one. The regenerated Swift bindings are matched against
  # the Rust source by the bindings-check job.
  # 1. Retained undecodable content (CTYPE-008): the legacy binding records
  #    and variants, their regenerated outputs, and the wrapper projections
  #    that expose exact received bytes and the typed cause.
  # 2. Foreign Restored DM peer getter: mobile returns None; Node and WASM
  #    return a typed no-peer error.
  # The build-only bindings/wasm/wasm.just pin permits only the reviewed
  # --print-build-logs addition. Its tests, timeouts, retries, and mode stay fixed.
  # bindings/node/src/client/identity.rs is a test-module-only edit
  # (CONF-077, b04a2c97e) listed as a whole file; the pin holds its shipped
  # part to the reviewed content. The native CI update to sdks/ios/VALIDATION.md
  # is also pinned to its reviewed documentation content.
  if pin=$(grep -F -- "$path"$'\t' "$pins_file" | awk -F '\t' -v p="$path" '$1 == p { print $2 }') && [ -n "$pin" ]; then
    if [[ "$status" != M ]]; then
      blocked+="$path"$'\n'
      continue
    fi
    if ! actual=$(git hash-object "$path"); then
      fail_query "hash for $path"
    fi
    if [ "$actual" = "$pin" ]; then
      continue
    fi
    echo "$path is allowlisted only at blob $pin; this change ($actual) is not" >&2
    blocked+="$path"$'\n'
    continue
  fi
  case "$path" in
    sdks/node/src/MessageStream.ts|sdks/browser/src/MessageStream.ts|sdks/ios/Sources/XMTPiOS/MessageDeliveryStream.swift|sdks/android/library/src/main/java/org/xmtp/android/library/MessageDeliveryFlow.kt) ;;
    *) blocked+="$path"$'\n'; continue ;;
  esac
  if [[ "$status" != M ]]; then
    blocked+="$path"$'\n'
    continue
  fi
  if ! git show "$base:$path" > "$base_file"; then
    fail_query "base content for $path"
  fi
  if ! python3 -c '
import sys

lines = {
    "sdks/node/src/MessageStream.ts": b"  // implements: PROC-028, PROC-031, PROC-032\n",
    "sdks/browser/src/MessageStream.ts": b"  // implements: PROC-028, PROC-031, PROC-032\n",
    "sdks/ios/Sources/XMTPiOS/MessageDeliveryStream.swift": b"\t// implements: PROC-028, PROC-031, PROC-032\n",
    "sdks/android/library/src/main/java/org/xmtp/android/library/MessageDeliveryFlow.kt": b" * implements: PROC-028, PROC-031, PROC-032\n",
}
data = sys.stdin.buffer.read()
old = lines[sys.argv[1]]
if data.count(old) != 1:
    sys.exit(1)
sys.stdout.buffer.write(data.replace(old, old.replace(b", PROC-032", b""), 1))
' "$path" < "$base_file" | cmp -s - "$path"; then
    blocked+="$path"$'\n'
  fi
done <<< "$changed"
if [ -n "$blocked" ]; then
  echo "SDK facade changes cannot alter shipped code in sdks/ or bindings/:" >&2
  printf '%s' "$blocked" >&2
  exit 1
fi
