#!/usr/bin/env bash
set -euo pipefail

# GitHub runs a stacked PR's checks against the stack trunk, so this diff
# includes the PRs below it. Only shipped code in sdks/ and bindings/ is
# guarded: tests and changelogs there may change (spec evidence, and
# owner-approved behaviour changes made in core).
base=$(git merge-base HEAD origin/self-hosted)
if [ -z "$(git diff --name-only "$base"...HEAD -- crates/xmtp_sdk/ apps/xmtp_sdk_bindgen/)" ]; then
  exit 0
fi

changed=$(git diff --name-only "$base"...HEAD -- sdks/ bindings/ \
  | grep -vE '(^|/)(tests?|Tests|androidTest)/|\.test\.[cm]?[jt]s$|_tests?\.rs$|(^|/)CHANGELOG\.md$' \
  || true)
if [ -n "$changed" ]; then
  echo "SDK facade changes cannot alter shipped code in sdks/ or bindings/:" >&2
  echo "$changed" >&2
  exit 1
fi
