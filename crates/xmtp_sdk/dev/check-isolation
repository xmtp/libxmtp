#!/usr/bin/env bash
set -euo pipefail

# Only shipped code in sdks/ and bindings/ is guarded: tests and changelogs there may change
# (spec evidence, and owner-approved behaviour changes made in core).
# A stacked pull request is checked against its own base, so a lower PR's changes do not count.
# An explicit base branch wins. In a pull request run, HEAD is GitHub's merge commit and its first
# parent is the base. Otherwise compare against self-hosted.
if [ -n "${1:-}" ]; then
  base_ref="origin/$1"
  base=$(git merge-base HEAD "$base_ref")
elif git rev-parse -q --verify HEAD^2 >/dev/null; then
  base_ref="HEAD^1"
  base=$(git rev-parse HEAD^1)
else
  base_ref="origin/self-hosted"
  base=$(git merge-base HEAD "$base_ref")
fi
echo "Checking SDK isolation against $base_ref" >&2
if [ -z "$(git diff --name-only "$base"...HEAD -- crates/xmtp_sdk/ apps/xmtp_sdk_bindgen/)" ]; then
  exit 0
fi

changed=$(git diff --name-only "$base"...HEAD -- sdks/ bindings/ \
  | grep -vE '(^|/)(tests?|Tests|androidTest)/|\.test\.[cm]?[jt]s$|_tests?\.rs$|(^|/)CHANGELOG\.md$' \
  || true)
if [ -n "$changed" ]; then
  echo "SDK facade changes cannot alter shipped code in sdks/ or bindings/:" >&2
  echo "$changed" >&2
  exit 1
fi
