#!/usr/bin/env bash
# Compile and run a separate codec package through the supported ESM roots.
set -euo pipefail
root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
mode="${1:-types}"
case "$mode" in types|node|browser) ;; *) echo "expected types, node, or browser" >&2; exit 2 ;; esac
export XMTP_SDK_GENERATED_DIR="${XMTP_SDK_GENERATED_DIR:-target/sdk-generated}"
if [ -z "${XMTP_SDK_PACKAGES_DIR:-}" ]; then
  for part in typescript-napi typescript-wasm typescript-pure; do
    test -f "$XMTP_SDK_GENERATED_DIR/$part/index.ts" || {
      echo "missing $XMTP_SDK_GENERATED_DIR/$part; generate the SDK first" >&2
      exit 1
    }
  done
else
  for target in node browser; do
    test -f "$XMTP_SDK_PACKAGES_DIR/$target/package.json" || {
      echo "missing $XMTP_SDK_PACKAGES_DIR/$target/package.json; stage the SDK packages first" >&2
      exit 1
    }
  done
fi
if [ -z "${XMTP_SDK_PACKAGES_DIR:-}" ]; then
  nix build --no-link .#ubjs-core .#ubjs-node .#ubjs-wasm
  SDK_AUTHOR_CORE="$(nix path-info .#ubjs-core)/lib/node_modules/@ubjs/core"
  SDK_AUTHOR_NODE="$(nix path-info .#ubjs-node)/lib/node_modules/@ubjs/node"
  SDK_AUTHOR_WASM="$(nix path-info .#ubjs-wasm)/lib/node_modules/@ubjs/wasm"
  export SDK_AUTHOR_CORE SDK_AUTHOR_NODE SDK_AUTHOR_WASM
fi
python3 crates/xmtp_sdk/dev/stage-codec-author.py
stage=target/sdk-codec-author
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
args=(--noEmit --strict --skipLibCheck --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions)
for target in node browser; do
  node_modules/.bin/tsc "${args[@]}" "$stage/$target/positive.ts" "$stage/$target/node_modules/@example/reading-codec/src/round-trip.ts"
  if node_modules/.bin/tsc "${args[@]}" "$stage/$target/negative.ts" >"$log" 2>&1; then
    echo "$target codec author accepted wrong input values" >&2
    exit 1
  fi
  # Every encode/send/prepare/reply call must reject its own wrong value.
  for line in 9 10 11 12 13 14; do
    if ! grep -Eq "negative.ts\($line,[0-9]+\): error TS(2345|2769)" "$log"; then
      cat "$log" >&2
      echo "$target codec author missed the rejection on line $line" >&2
      exit 1
    fi
  done
  test "$(grep -c 'negative.ts([0-9]*,[0-9]*): error' "$log")" -eq 6
  echo "$target independent codec package: positive calls and six wrong-value rejections passed"
done
if [ "$mode" != types ]; then
  SDK_AUTHOR_PROTOC="$(dev/nix-shell --shell rust --command which protoc)"
  export SDK_AUTHOR_PROTOC
fi
case "$mode" in
  types) ;;
  node) NODE_OPTIONS=--preserve-symlinks sdks/node/node_modules/.bin/tsx crates/xmtp_sdk/conformance/codec-author/node.test.mts ;;
  browser) NODE_OPTIONS='' sdks/node/node_modules/.bin/tsx crates/xmtp_sdk/conformance/codec-author/browser.test.mts ;;
esac
