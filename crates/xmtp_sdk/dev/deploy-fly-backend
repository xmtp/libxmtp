#!/usr/bin/env bash
# Deploy the iOS test machine to Fly.io for the SDK Swift conformance run.
#
# Usage:
#   crates/xmtp_sdk/dev/deploy-fly-backend APP_NAME BACKEND_IMAGE
#
# It reads sdks/ios/dev/fly/machine-config.json but does not change it. The
# backend runs dev/backend/local-s3.toml and presigns uploads for loopback port
# 9067, where the Swift job runs the conformance object store.
#
# Environment:
#   FLY_API_TOKEN - Required for Fly.io authentication
#   FLY_ORG       - Organization to deploy to (default: xmtp-labs)
#   FLY_REGION    - Region to deploy to (default: sjc)
set -euo pipefail

if [ -z "${FLY_API_TOKEN:-}" ]; then
  echo "Error: FLY_API_TOKEN is not set" >&2
  exit 1
fi

root="$(cd "$(dirname "$0")/../../.." && pwd)"
app_name="${1:?Pass the Fly app name}"
backend_image="${2:?Pass the backend image for the commit under test}"
# flyctl needs the .json extension, so the file goes in a temporary directory.
config_dir="$(mktemp -d)"
trap 'rm -rf "$config_dir"' EXIT
config="$config_dir/machine-config.json"
machine_config="$root/sdks/ios/dev/fly/machine-config.json"
if ! jq -e 'any(.containers[]; .name == "backend")' "$machine_config" >/dev/null; then
  echo "Error: $machine_config has no backend container" >&2
  exit 1
fi
backend_config="$(base64 < "$root/dev/backend/local-s3.toml" | tr -d '\n')"
jq --arg cfg "$backend_config" --arg image "$backend_image" '.containers |= map(if .name == "backend" then .image = $image | .env.XMTP_REPLICA_URL = .env.XMTP_DATABASE_URL | .env.XMTP_S3_URL = "http://127.0.0.1:9067" | .env.XMTP_S3_BASE_URL = "http://127.0.0.1:9067/attachments" | .files = [{guest_path: "/config.toml", raw_value: $cfg}] else . end)' \
  "$machine_config" > "$config"

fly_org="${FLY_ORG:-xmtp-labs}"
fly_region="${FLY_REGION:-sjc}"

echo "Creating app: $app_name" >&2
flyctl apps create "$app_name" --org "$fly_org" 2>/dev/null || {
  flyctl apps show "$app_name" >/dev/null 2>&1 || {
    echo "Failed to create app: $app_name" >&2
    exit 1
  }
}
flyctl ips allocate-v4 --shared --app "$app_name" 2>/dev/null || true
flyctl machine run \
  --app "$app_name" \
  --region "$fly_region" \
  --rm \
  --restart no \
  --machine-config "$config"
