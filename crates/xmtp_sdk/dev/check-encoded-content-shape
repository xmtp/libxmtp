#!/usr/bin/env python3
"""Keep wire compression out of the public, uncompressed EncodedContent record."""

from pathlib import Path
import re
import sys


root = Path(sys.argv[1] if len(sys.argv) > 1 else "target/sdk-generated")
bindings = {
    "swift": (root / "swift/xmtp_sdk.swift", r"public struct EncodedContent:.*?\n}\n"),
    "kotlin": (
        root / "kotlin/uniffi/xmtp_sdk/xmtp_sdk.kt",
        r"data class EncodedContent \(.*?\n\)",
    ),
    "typescript-napi": (
        root / "typescript-napi/xmtp_sdk.ts",
        r"export type EncodedContent = \{.*?\n}",
    ),
    "typescript-wasm": (
        root / "typescript-wasm/xmtp_sdk.ts",
        r"export type EncodedContent = \{.*?\n}",
    ),
}

for language, (path, pattern) in bindings.items():
    match = re.search(pattern, path.read_text(), re.DOTALL)
    if match is None or re.search(r"\bcompression\b", match.group()):
        raise SystemExit(f"{language}: EncodedContent must omit compression")

print("Generated EncodedContent has no compression field.")
