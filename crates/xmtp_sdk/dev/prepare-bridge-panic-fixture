#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"

fixture=target/sdk-bridge-panic-fixture
wasm="$fixture/xmtp_sdk.wasm"
out="$fixture/typescript-wasm"
mkdir -p "$fixture" "$out"

dev/agent-run cargo build --locked -p xmtp_sdk \
  --target wasm32-unknown-unknown --target-dir "$fixture/build" \
  --features bridge-panic-test,conformance
cp "$fixture/build/wasm32-unknown-unknown/debug/xmtp_sdk.wasm" "$wasm"
target/debug/xmtp-sdk-bindgen generate \
  --lib "$wasm" --language typescript-wasm --out "$out" \
  --config apps/xmtp_sdk_bindgen/uniffi-global.toml
target/debug/xmtp-sdk-bindgen stage-wasm --lib "$wasm" --out "$out"
ln -sfn ../../sdk-generated/typescript-wasm/node_modules "$out/node_modules"
