#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
# The small fixture covers reuse and stale cleanup. One real render checks
# cleanup with the artifacts already built by this job.
python3 crates/xmtp_sdk/dev/test-sdk-artifacts.py
out=target/sdk-cleanup-real
stale="$out/swift/runtime/Stale.swift"
mkdir -p "$(dirname "$stale")"
printf '%s\n' '// stale generated file' > "$stale"
trap 'rm -rf "$out"' EXIT
python3 crates/xmtp_sdk/dev/sdk-artifacts.py render --targets swift --out "$out"
if [ -e "$stale" ]; then
  echo "SDK rendering kept $stale" >&2
  exit 1
fi
echo 'One real SDK render removed stale output without a Rust build.'
