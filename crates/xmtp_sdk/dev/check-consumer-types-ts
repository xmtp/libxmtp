#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
bash crates/xmtp_sdk/dev/check-wasm-init
nix build --no-link .#ubjs-core .#ubjs-node
core="$(nix path-info .#ubjs-core)"
node="$(nix path-info .#ubjs-node)"
package_dir=target/sdk-generated/typescript-napi/node_modules/@ubjs
mkdir -p "$package_dir"
ln -sfn "$core/lib/node_modules/@ubjs/core" "$package_dir/core"
ln -sfn "$node/lib/node_modules/@ubjs/node" "$package_dir/node"
args=(--noEmit --strict --module esnext --moduleResolution bundler --target es2022 --allowImportingTsExtensions --skipLibCheck --typeRoots sdks/node/node_modules/@types --types node)
node_modules/.bin/tsc "${args[@]}" crates/xmtp_sdk/conformance/ts/consumers/positive.ts
node_modules/.bin/tsc "${args[@]}" crates/xmtp_sdk/conformance/ts/public-layer/positive.ts
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
if node_modules/.bin/tsc "${args[@]}" crates/xmtp_sdk/conformance/ts/consumers/negative.ts >"$log" 2>&1; then
  echo "TypeScript negative consumer compiled" >&2
  exit 1
fi
# Each rejected statement of the negative consumer fails for its own reason.
expect() {
  if ! grep -q "negative.ts.*$1" "$log"; then
    cat "$log" >&2
    echo "missing root type rejection: $1" >&2
    exit 1
  fi
}
expect "TS2305.*'MainSession'"
expect "TS2724.*'StandardContent_Tags'"
expect "TS2322: Type 'number' is not assignable to type 'string'."
expect "TS2322: Type 'MessageContent' is not assignable to type 'EncodedContent'."
expect "TS2339: Property 'tag' does not exist"
expect "TS2339: Property 'inner' does not exist"
expect "TS2673: Constructor of class 'Group' is private"
expect "TS2339: Property 'new' does not exist"
expect "TS6234: This expression is not callable because it is a 'get' accessor"
expect "TS2339: Property 'handle' does not exist"
test "$(grep -c 'negative.ts([0-9]*,[0-9]*): error' "$log")" -eq 10
bash crates/xmtp_sdk/dev/check-public-values
echo "TypeScript ID, content, and Group/Dm consumer checks passed"
