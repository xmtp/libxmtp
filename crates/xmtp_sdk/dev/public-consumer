#!/usr/bin/env bash
# Stage the generated SDK as separate public products, then compile separate
# consumer projects against them. The consumers call the retained public
# surface from the approved plan. Negative probes must fail on visibility.
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
generated="${XMTP_SDK_GENERATED_DIR:-target/sdk-generated}"
stage=target/sdk-public
fixtures=crates/xmtp_sdk/conformance/public
for language in swift kotlin typescript-napi typescript-wasm; do
  if [ ! -d "$generated/$language/runtime" ]; then
    echo "missing $generated/$language; run 'just sdk generate' first" >&2
    exit 1
  fi
done
rm -rf -- "$stage"

# Swift: a SwiftPM package with the XmtpSdk library product.
swift_stage="$stage/XmtpSdk"
mkdir -p "$swift_stage/Sources/XmtpSdk" "$swift_stage/Sources/xmtp_sdkFFI"
cp "$generated/swift/xmtp_sdk.swift" "$swift_stage/Sources/XmtpSdk/"
cp -R "$generated/swift/runtime/." "$swift_stage/Sources/XmtpSdk/"
cp "$generated/swift/xmtp_sdkFFI.h" "$swift_stage/Sources/xmtp_sdkFFI/"
cp "$generated/swift/xmtp_sdkFFI.modulemap" "$swift_stage/Sources/xmtp_sdkFFI/module.modulemap"
cat > "$swift_stage/Package.swift" <<'SWIFT'
// swift-tools-version: 6.1
import PackageDescription

let package = Package(
    name: "XmtpSdk",
    platforms: [.macOS(.v15)],
    products: [.library(name: "XmtpSdk", targets: ["XmtpSdk"])],
    targets: [
        .systemLibrary(name: "xmtp_sdkFFI", path: "Sources/xmtp_sdkFFI"),
        .target(name: "XmtpSdk", dependencies: ["xmtp_sdkFFI"], path: "Sources/XmtpSdk"),
    ],
    swiftLanguageModes: [.v5]
)
SWIFT

# Kotlin: the generated sources and Android helpers, compiled by the fixture
# as a separate Android library module.
mkdir -p "$stage/kotlin"
for part in uniffi runtime android; do
  cp -R "$generated/kotlin/$part" "$stage/kotlin/$part"
done

# TypeScript consumers use the same compiled products as package smoke.
node crates/xmtp_sdk/dev/stage-package.mjs node
node crates/xmtp_sdk/dev/stage-package.mjs browser
packages="${XMTP_SDK_PACKAGES_DIR:-target/sdk-packages}"
node_consumer="$stage/node-consumer"
node_package="$node_consumer/node_modules/xmtp-sdk"
browser_consumer="$stage/browser-consumer"
browser_package="$browser_consumer/node_modules/xmtp-sdk-browser"
mkdir -p "$node_consumer/node_modules" "$browser_consumer/node_modules"
cp -R "$packages/node" "$node_package"
cp -R "$packages/browser" "$browser_package"
cp -R "$fixtures/node/src" "$fixtures/node/negative" "$fixtures/node/root" "$node_consumer/"
cp -R "$fixtures/browser/src" "$fixtures/browser/negative" "$browser_consumer/"

log="$(mktemp)"
swift_negative="$fixtures/swift/Sources/PublicConsumer/RawAccess.swift"
kotlin_negative="$fixtures/kotlin/consumer/src/main/kotlin/RawAccess.kt"
trap 'rm -f "$log" "$swift_negative" "$kotlin_negative"' EXIT

swift_build() {
  NIX_DEVSHELL=ios dev/nix-shell "swift build --package-path $fixtures/swift -Xswiftc -strict-concurrency=complete"
}
kotlin_build() {
  NIX_DEVSHELL=android dev/nix-shell "sdks/android/gradlew -p $fixtures/kotlin :consumer:compileDebugKotlin --no-daemon -q"
}

# A missing retained member fails here even if the raw binding still has it.
if ! swift_build >"$log" 2>&1; then
  cat "$log" >&2
  echo "Swift public consumer failed to compile" >&2
  exit 1
fi
echo "Swift public consumer compiled against the staged XmtpSdk product"
cp "$fixtures/swift/Negative/RawAccess.swift" "$swift_negative"
if swift_build >"$log" 2>&1; then
  echo "Swift raw-access probe compiled" >&2
  exit 1
fi
grep -q "cannot find 'sdkLogSinkHandoff' in scope" "$log"
grep -q "'raw' is inaccessible due to 'internal' protection level" "$log"
grep -q "'create' is inaccessible due to 'internal' protection level" "$log"
grep -q "'createGroupWithIdentities' is inaccessible due to 'internal' protection level" "$log"
grep -q "'addMembersByIdentity' is inaccessible due to 'internal' protection level" "$log"
cp "$fixtures/swift/Negative/CodecValues.swift" "$swift_negative"
if swift_build >"$log" 2>&1; then
  echo "Swift typed codec probe compiled" >&2
  exit 1
fi
# A typed codec rejects a value of another type in encode, send, and reply:
# three distinct source lines (the compiler prints each error twice).
test "$(grep -o "RawAccess.swift:[0-9]*:[0-9]*: .*cannot convert value of type 'Int' to expected argument type 'String'" "$log" | cut -d: -f2 | sort -u | wc -l | tr -d ' ')" -eq 3
echo "Swift codec_typed_consumers passed (positive Codecs.swift, negative CodecValues.swift)"
rm -f "$swift_negative"
echo "Swift public consumer cannot reach the generated Client or send a wrong codec value"

if ! kotlin_build >"$log" 2>&1; then
  cat "$log" >&2
  echo "Kotlin public consumer failed to compile" >&2
  exit 1
fi
echo "Android public consumer compiled against the staged SDK library"
cp "$fixtures/kotlin/negative/RawAccess.kt" "$kotlin_negative"
if kotlin_build >"$log" 2>&1; then
  echo "Kotlin raw-access probe compiled" >&2
  exit 1
fi
grep -Eqi "(Cannot access|Unresolved reference).*sdkLogSinkHandoff" "$log"
grep -q "Cannot access 'val raw: Client': it is internal" "$log"
grep -q "Cannot access 'suspend fun create(" "$log"
grep -q "Cannot access 'suspend fun createGroupWithIdentities" "$log"
grep -q "Cannot access 'suspend fun addMembersByIdentity" "$log"
cp "$fixtures/kotlin/negative/CodecValues.kt" "$kotlin_negative"
if kotlin_build >"$log" 2>&1; then
  echo "Kotlin typed codec probe compiled" >&2
  exit 1
fi
# A typed codec rejects a value of another type in encode, send, and reply:
# three distinct source lines.
test "$(grep -E "^e: .*RawAccess.kt:[0-9]+:[0-9]+ (Argument type mismatch: actual type is 'kotlin.Int'|None of the following candidates is applicable)" "$log" | grep -o "RawAccess.kt:[0-9]*:" | sort -u | wc -l | tr -d ' ')" -eq 3
echo "Kotlin codec_typed_consumers passed (positive Codecs.kt, negative CodecValues.kt)"
rm -f "$kotlin_negative"
echo "Kotlin public consumer cannot reach the generated Client or send a wrong codec value"

node_build() {
  node_modules/.bin/tsc --noEmit --strict --skipLibCheck --target es2022 --module esnext \
    --moduleResolution bundler --allowImportingTsExtensions "$@"
}
if ! node_build "$node_consumer"/src/*.ts >"$log" 2>&1; then
  cat "$log" >&2
  echo "Node public consumer failed to compile" >&2
  exit 1
fi
echo "Node public consumer compiled against the installed xmtp-sdk package"
if node_build "$node_consumer/negative/raw.ts" >"$log" 2>&1; then
  echo "Node raw-access probe compiled" >&2
  exit 1
fi
grep -q "Module '\"xmtp-sdk\"' has no exported member 'bindingClient'" "$log"
grep -q "TS2307: Cannot find module 'xmtp-sdk/xmtp_sdk'" "$log"
grep -q "TS2339: Property 'raw' does not exist on type 'Client'" "$log"
grep -q "Property 'createGroupWithIdentities' does not exist on type 'Conversations'" "$log"
grep -q "has no exported member 'sdkLogSinkHandoff'" "$log"
echo "Node public consumer cannot reach the binding Client or log admission helper"
if node_build "$node_consumer/negative/codecs.ts" >"$log" 2>&1; then
  echo "Node typed codec probe compiled" >&2
  exit 1
fi
# A typed codec rejects a value of another type in encode, Group and Dm send
# and prepareMessage, reply, and a standard variant codec: seven distinct lines.
test "$(grep -E "codecs\.ts\([0-9]+,[0-9]+\): error TS(2345|2769)" "$log" | grep -oE "codecs\.ts\([0-9]+," | sort -u | wc -l | tr -d ' ')" -eq 7
echo "Node codec_typed_consumers passed (positive src/codecs.ts, negative negative/codecs.ts)"

# The ESM package root exports the public names. This check loads the
# package, so the package needs its native library.
node_build --types node --typeRoots sdks/node/node_modules/@types "$node_consumer/root/load-esm.mts"
(cd "$node_consumer" && SDK_EXPECTED_NODE_PATH="$(realpath "$generated/typescript-napi")" NODE_OPTIONS=--preserve-symlinks node --import "$(realpath "$root/sdks/node/node_modules/tsx/dist/loader.mjs")" root/load-esm.mts)

browser_build() {
  node_modules/.bin/tsc --noEmit --strict --skipLibCheck --target es2022 --module esnext \
    --moduleResolution bundler --allowImportingTsExtensions --lib es2022,dom,dom.iterable "$@"
}
if ! browser_build "$browser_consumer"/src/*.ts >"$log" 2>&1; then
  cat "$log" >&2
  echo "Browser public consumer failed to compile" >&2
  exit 1
fi
echo "Browser public consumer compiled against the installed xmtp-sdk-browser package"
if browser_build "$browser_consumer/negative/raw.ts" >"$log" 2>&1; then
  echo "Browser raw-access probe compiled" >&2
  exit 1
fi
grep -q "has no exported member 'wrapClient'" "$log"
grep -q "TS2307: Cannot find module 'xmtp-sdk-browser/typescript-wasm/runtime/bridge/main/session'" "$log"
grep -q "TS2339: Property 'raw' does not exist on type 'Client'" "$log"
grep -q "Property 'createGroupWithIdentities' does not exist on type 'Conversations'" "$log"
grep -q "has no exported member 'sdkLogSinkHandoff'" "$log"
echo "Browser public consumer cannot reach the worker proxy, its session, or log admission helper"
if browser_build "$browser_consumer/negative/codecs.ts" >"$log" 2>&1; then
  echo "Browser typed codec probe compiled" >&2
  exit 1
fi
# A typed codec rejects a value of another type in encode, Group and Dm send
# and prepareMessage, reply, and a standard variant codec: seven distinct lines.
test "$(grep -E "codecs\.ts\([0-9]+,[0-9]+\): error TS(2345|2769)" "$log" | grep -oE "codecs\.ts\([0-9]+," | sort -u | wc -l | tr -d ' ')" -eq 7
echo "Browser codec_typed_consumers passed (positive src/codecs.ts, negative negative/codecs.ts)"

# Each variant codec rejects one wrong value per compiler invocation.
bash crates/xmtp_sdk/dev/check-codec-record-values
