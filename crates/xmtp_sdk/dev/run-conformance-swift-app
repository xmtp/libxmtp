#!/usr/bin/env bash
set -euo pipefail

package=target/sdk-conformance-apple/crates/xmtp_sdk/conformance/swift
swift build --package-path "$package" --product XmtpSdkConformance -Xswiftc -enable-testing
bin_dir="$(swift build --package-path "$package" --show-bin-path)"
executable="$bin_dir/XmtpSdkConformance"
if [[ "${SDK_CALLBACK_LIFETIME:-}" == 1 ]]; then
  exec "$executable"
fi
"$executable" --missing-bundle

bundle_root="$(mktemp -d)"
trap 'rm -rf -- "$bundle_root"' EXIT
app="$bundle_root/XmtpSdkConformance.app"
mkdir -p "$app/Contents/MacOS"
cp "$executable" "$app/Contents/MacOS/XmtpSdkConformance"
cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>org.xmtp.sdk.conformance</string>
<key>CFBundleExecutable</key><string>XmtpSdkConformance</string>
<key>CFBundleName</key><string>XmtpSdkConformance</string>
<key>CFBundlePackageType</key><string>APPL</string>
</dict></plist>
PLIST
"$app/Contents/MacOS/XmtpSdkConformance"
