#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
args=(--noEmit --strict --module esnext --moduleResolution bundler --target es2022 --allowImportingTsExtensions --skipLibCheck --typeRoots sdks/node/node_modules/@types --types node)
node_modules/.bin/tsc "${args[@]}" crates/xmtp_sdk/conformance/ts/public-values/positive.ts
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
if node_modules/.bin/tsc "${args[@]}" crates/xmtp_sdk/conformance/ts/public-values/negative.ts >"$log" 2>&1; then
  echo "Public value negative consumer compiled" >&2
  exit 1
fi
expect() {
  if ! grep -q "$1" "$log"; then
    cat "$log" >&2
    echo "missing public type rejection: $1" >&2
    exit 1
  fi
}
expect 'TS2540.*identifier.*read-only'
expect 'TS2540.*kind.*read-only'
expect "TS2339.*tag"
expect "TS2339.*inner"
expect "TS2561.*credential"
expect "TS2740.*ArrayBuffer.*Uint8Array"
echo "Shared public value types and negative consumer checks passed"
