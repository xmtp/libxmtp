#!/usr/bin/env bash
# Link the pinned @ubjs runtime packages into generated TypeScript trees.
# Generation replaces a tree with a new one, so every job that loads or
# typechecks a generated binding links them first.
# usage: link-runtime-packages <tree>...
#   typescript-napi gets @ubjs/core and @ubjs/node;
#   typescript-wasm and typescript-pure get @ubjs/core and @ubjs/wasm.
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: $0 <generated TypeScript tree>..." >&2
  exit 2
fi
# The flake outputs resolve from the repository root; a tree may be given
# relative to the caller's directory.
trees=()
for tree in "$@"; do trees+=("$(realpath -m "$tree")"); done
root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"

packages() {
  case "$(basename "$1")" in
    typescript-napi) echo core node ;;
    typescript-wasm | typescript-pure) echo core wasm ;;
    *)
      echo "$1: not a generated TypeScript tree" >&2
      return 2
      ;;
  esac
}

wanted=()
for tree in "${trees[@]}"; do
  if [ ! -d "$tree" ]; then
    echo "missing $tree: run \`just sdk generate\` first" >&2
    exit 1
  fi
  names="$(packages "$tree")"
  for name in $names; do wanted+=(".#ubjs-$name"); done
done
mapfile -t wanted < <(printf '%s\n' "${wanted[@]}" | sort -u)
if [[ -z "${XMTP_SDK_RUNTIME_DIR:-}" ]]; then
  nix build --no-link "${wanted[@]}"
else
  runtime_root="$(realpath -m "$XMTP_SDK_RUNTIME_DIR")"
  for tree in "${trees[@]}"; do
    for name in $(packages "$tree"); do
      if [[ ! -f "$runtime_root/$name/package.json" &&
            ! -f "$runtime_root/lib/node_modules/@ubjs/$name/package.json" ]]; then
        echo "missing pinned runtime: $name in $runtime_root" >&2
        exit 1
      fi
    done
  done
fi

for tree in "${trees[@]}"; do
  package_dir="$tree/node_modules/@ubjs"
  mkdir -p "$package_dir"
  for name in $(packages "$tree"); do
    if [[ -n "${XMTP_SDK_RUNTIME_DIR:-}" ]]; then
      runtime="$runtime_root/$name"
      if [[ ! -f "$runtime/package.json" ]]; then
        runtime="$runtime_root/lib/node_modules/@ubjs/$name"
      fi
    else
      runtime="$(nix path-info ".#ubjs-$name")/lib/node_modules/@ubjs/$name"
    fi
    ln -sfn "$runtime" "$package_dir/$name"
  done
done
