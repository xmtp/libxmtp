#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: check-public-names <generated-dir>" >&2
  exit 2
fi

root="$1"
if rg -n 'pub (async fn|fn) [a-z_]*_at_ns\b|pub [a-z_]*_at_ns:' crates/xmtp_sdk/src --glob '*.rs'; then
  echo "an exported nanosecond timestamp still has an _at_ns name" >&2
  exit 1
fi
if rg -n '_i_d' crates/xmtp_sdk/uniffi.toml; then
  echo "a cosmetic ID rename remains" >&2
  exit 1
fi
if [ -e apps/xmtp_sdk_bindgen/src/id_names.rs ]; then
  echo "the cosmetic ID rewrite remains" >&2
  exit 1
fi
if rg -n '[a-z]ID\b' "$root" --glob '*.swift' --glob '*.kt' --glob '*.ts'; then
  echo "a generated public name still uses ID suffix casing" >&2
  exit 1
fi
if rg -n '(^|[[:space:]])(class|struct) (InboxId|InstallationId|ConversationId|MessageId)\b|\b(fromString|fromBytes)\(' apps/xmtp_sdk_bindgen/runtime \
  --glob '*.swift' --glob '*.kt' --glob '*.ts'; then
  echo "a host ID wrapper or factory remains" >&2
  exit 1
fi

echo "Public names use stock casing and timestamp values"
