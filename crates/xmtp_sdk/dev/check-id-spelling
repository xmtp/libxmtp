#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 2 ] && [ "$#" -ne 4 ]; then
  echo "usage: check-id-spelling <swift-dir> <kotlin-dir> [<node-ts-dir> <wasm-ts-dir>]" >&2
  exit 2
fi

check_dir() {
  local directory="$1"
  local glob="$2"
  local spelling
  for spelling in \
    InboxID InstallationID ConversationID MessageID ContentTypeID \
    inboxID installationID conversationID senderInboxID \
    authorityID typeID chainID; do
    if ! rg -q --glob "$glob" "\\b${spelling}\\b" "$directory"; then
      echo "missing $spelling in $directory" >&2
      return 1
    fi
  done
  for spelling in \
    InboxId InstallationId ConversationId MessageId ContentTypeId \
    inboxId installationId conversationId senderInboxId \
    authorityId typeId chainId; do
    if rg -q --glob "$glob" "\\b${spelling}\\b" "$directory"; then
      echo "wrong ID spelling $spelling in $directory" >&2
      return 1
    fi
  done
  if rg -q --glob "$glob" '\b[A-Za-z][A-Za-z0-9_]*Ids?\b' "$directory"; then
    echo "a generated name still ends in Id or Ids in $directory" >&2
    return 1
  fi
}

check_dir "$1" '*.swift'
check_dir "$2" '*.kt'
if [ "$#" -eq 4 ]; then
  check_dir "$3" '*.ts'
  check_dir "$4" '*.ts'
fi
echo "Generated ID spellings are correct"
