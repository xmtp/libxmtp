#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"

fixture=target/sdk-pure-codec-fixture/typescript-pure
raw=target/sdk-pure-codec-fixture/build/wasm32-unknown-unknown/release/xmtp_sdk.wasm
dev/agent-run cargo build --locked --release -p xmtp_sdk \
  --target wasm32-unknown-unknown --target-dir target/sdk-pure-codec-fixture/build \
  --features pure-only,conformance
oxfmt="${XMTP_SDK_OXFMT:-$(nix build --no-link --print-out-paths --inputs-from . nixpkgs#oxfmt)/bin/oxfmt}"
rm -rf "$fixture"
# A test fixture: its receipt names no real source identity.
target/sdk-artifacts/bindgen/xmtp-sdk-bindgen render --lib "$raw" \
  --target browser-pure --oxfmt "$oxfmt" --out "$fixture" \
  --source fixture --generator fixture --features pure-only,conformance
ln -sfn ../../sdk-generated/typescript-pure/node_modules "$fixture/node_modules"
