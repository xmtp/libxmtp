#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
generated=target/sdk-conformance
python3 crates/xmtp_sdk/dev/sdk-artifacts.py build --features conformance --artifacts target/sdk-conformance-artifacts "$@"
# Render replaces only the selected trees and keeps the others. Start from an
# empty output so it holds only the selected target directories.
rm -rf "$generated"
python3 crates/xmtp_sdk/dev/sdk-artifacts.py render --artifacts target/sdk-conformance-artifacts --out "$generated" "$@"
