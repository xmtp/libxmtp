#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"
python3 crates/xmtp_sdk/dev/sdk-artifacts.py build --features conformance --artifacts target/sdk-conformance-artifacts "$@"
python3 crates/xmtp_sdk/dev/sdk-artifacts.py render --artifacts target/sdk-conformance-artifacts --out target/sdk-conformance "$@"

generated=target/sdk-conformance
# The renderer writes only the selected target directories.
# Read real foreign callback tables only in these conformance copies.
if [[ -d "$generated/swift" ]]; then
  cp "$generated/swift/xmtp_sdk.swift" "$generated/swift/xmtp_sdk.swift.uninstrumented"
  python3 crates/xmtp_sdk/conformance/inject_callback_counts.py swift \
    "$generated/swift/xmtp_sdk.swift"
fi
if [[ -d "$generated/kotlin" ]]; then
  python3 crates/xmtp_sdk/conformance/inject_callback_counts.py kotlin \
    "$generated/kotlin/uniffi/xmtp_sdk/xmtp_sdk.kt"
fi
if [[ -d "$generated/typescript-napi" ]]; then
  python3 crates/xmtp_sdk/conformance/inject_callback_counts.py typescript \
    "$generated/typescript-napi/xmtp_sdk.ts"
fi
