{
  "name": "@xmtp/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r --filter './sdks/js/*' --filter './apps/*' --filter './dev/*' run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r --filter './sdks/js/*' --filter './apps/*' --filter './dev/*' run test"
  },
  "devDependencies": {
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "catalog:"
  }
}
