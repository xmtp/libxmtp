#!/usr/bin/env bash
# Check that warm sets of nix/ci-sets.nix substitute: an empty-store dry run
# of every member of the selected sets and every crane dependency layer.
# .github/workflows/post-merge.yml runs it after it pushes the sets.
#
# Usage: dev/ci/warm-closure [--system SYSTEM]... SELECT
#
# SELECT is a Nix function from one system's `ciSets` to the sets to check,
# such as 'sets: removeAttrs sets [ "rn" ]'. Each --system limits the check to
# that system; with none, it checks every system.
#
# An empty-store dry run reads the narinfo of each path from the configured
# substituters and walks the reference closure. It lists each set member (an
# output path) and each crane dependency layer (a build-time input outside
# the runtime closure). The link farms set allowSubstitutes = false;
# always-allow-substitutes overrides that.
set -euo pipefail

usage="usage: dev/ci/warm-closure [--system SYSTEM]... SELECT"
systems=""
while [[ $# -gt 1 && "$1" == --system ]]; do
  if [[ ! "$2" =~ ^[a-z0-9_]+-[a-z0-9_]+$ ]]; then
    echo "$usage" >&2
    exit 2
  fi
  systems+="\"$2\" "
  shift 2
done
if [[ $# -ne 1 ]]; then
  echo "$usage" >&2
  exit 2
fi
select=$1
if [[ -n "$systems" ]]; then
  only="builtins.intersectAttrs (builtins.listToAttrs (map (name: { inherit name; value = null; }) [ $systems]))"
else
  only="(ciSets: ciSets)"
fi
store="$RUNNER_TEMP/empty"
# Write the drvs into the empty store: a drv of the host store is unknown
# there. Every set evaluates with allow-import-from-derivation false, so the
# evaluation builds nothing in that store.
nix eval --store "$store" --json .#ciSets --apply "
  ciSets: builtins.mapAttrs (_: sets: builtins.mapAttrs (_: set: {
    members = builtins.attrValues set.passthru.members;
    drv = set.drvPath;
  }) (($select) sets)) ($only ciSets)" > "$RUNNER_TEMP/ci-sets.json"
# Each list goes through a file: bash ignores the exit status of a process
# substitution, so a failed jq or nix would shrink the check.
jq -r '.[][].members[]' "$RUNNER_TEMP/ci-sets.json" > "$RUNNER_TEMP/members.txt"
jq -r '.[][].drv' "$RUNNER_TEMP/ci-sets.json" > "$RUNNER_TEMP/drvs.txt"
paths=()
while read -r member; do
  paths+=("$member")
done < "$RUNNER_TEMP/members.txt"
drvs=()
while read -r drv; do
  drvs+=("$drv")
done < "$RUNNER_TEMP/drvs.txt"
# Lock-only stores and native download farms are explicit set members, so
# their fixed-output closures are checked below too.
# Crane sets CRANE_BUILD_DEPS_ONLY on each dependency layer.
nix derivation show --store "$store" -r "${drvs[@]}" |
  jq -r '(.derivations // .) | to_entries[]
    | select(.value.env.CRANE_BUILD_DEPS_ONLY != null) | .key
    | if startswith("/") then . else "/nix/store/" + . end' \
    > "$RUNNER_TEMP/dependency-layers.txt"
# Every set holds crane builds, so an empty list means the query broke.
if [[ ! -s "$RUNNER_TEMP/dependency-layers.txt" ]]; then
  echo "::error title=Warm closure::found no crane dependency layer in the set derivations"
  exit 1
fi
while read -r layer; do
  paths+=("$layer^out")
done < "$RUNNER_TEMP/dependency-layers.txt"
echo "Checking ${#paths[@]} set members, fixed-output inputs, and dependency layers"
# The dry run exits 0 also when a path cannot substitute, and has no
# machine-readable form (--json lists the requested paths only).
nix build --dry-run --store "$store" --option always-allow-substitutes true \
  "${paths[@]}" 2>&1 | tee "$RUNNER_TEMP/dry-run.txt"
# Fail closed: accept only one "will be fetched" header (it holds the count
# and the sizes) and exactly as many indented store paths as it announces. A
# "will be built" or "don't know how to build" section, or any other line,
# fails. The store is empty, so a run that fetches nothing checked nothing.
# Nix 2.31 prints sizes in MiB; Nix 2.34 picks the unit (KiB to GiB and up)
# with one decimal. dev/tests/test_post_merge_closure.py holds both forms.
header='^(this path|these ([0-9]+) paths) will be fetched \([0-9.]+ [KMGTPEZY]iB download, [0-9.]+ [KMGTPEZY]iB unpacked\):$'
path='^  /nix/store/[0-9a-df-np-sv-z]{32}-[^[:space:]]+$'
fetching=false
headers=0
announced=0
fetched=0
unexpected=()
while IFS= read -r line; do
  if [[ -z "$line" ]]; then
    continue
  elif [[ "$line" =~ $header ]]; then
    headers=$((headers + 1))
    # "this path" announces one.
    announced=${BASH_REMATCH[2]:-1}
    fetching=true
  elif $fetching && [[ "$line" =~ $path ]]; then
    fetched=$((fetched + 1))
  else
    fetching=false
    unexpected+=("$line")
  fi
done < "$RUNNER_TEMP/dry-run.txt"
if ((${#unexpected[@]} > 0 || headers != 1 || fetched == 0 || fetched != announced)); then
  echo "::error title=Warm closure::$headers fetch headers announce $announced paths and list $fetched; ${#unexpected[@]} lines show a path that cannot substitute or output this check does not know"
  printf '%s\n' "${unexpected[@]}"
  exit 1
fi
echo "Every set member and dependency layer substitutes ($fetched paths)."
