#!/usr/bin/env python3.11
"""Measure CI runs with read-only GitHub API calls.

`runs` prints, for each run, the wall time, the runner minutes by runner
class, the three slowest steps, and the change class of the tested diff. For a
merge run (a push run), it also prints whether the trunk tree equals the tree
that the PR's last run tested, and whether the `nextest` and WASM test outputs
were fetched or built. A summary follows.

Wall time runs from the run's creation to the end of its last job. Runner
minutes count every job that ran, in every attempt of the run: the jobs of a
failed first attempt cost minutes too. A re-run attempt lists the jobs it
reused from an earlier attempt again, with the same times; those count once.
Test outputs and the PR checkout come from the latest attempt of each job.

The change class of a merge run covers every commit since the previous push
run on the branch that started: GitHub replaces a pending run, so a run tests
the commits of the runs it replaced too. The search pages back at most 10
pages of 100 runs. The class is `?` when GitHub lists only part of the diff,
or when the search ends before it finds that run (unless a listed file
already proves class L).

    dev/ci/metrics runs 38294462023 38279019973
    dev/ci/metrics runs --workflow ci.yml --branch main --event push --limit 10
    dev/ci/metrics runs --branch main --event push --class R

`marker` reads one job log and prints only the lines that match a regular
expression. The repository allows only filtered CI log reads.

    dev/ci/metrics marker 115531426546 'will be fetched'

Change classes:

- L: `Cargo.lock`, any `Cargo.toml`, `.cargo/config.toml`, a `build.rs` under
  `crates/` or `apps/`, a file under `proto/`, or an added, removed, or renamed
  `src/lib.rs`, `src/main.rs`, or `src/bin/*` file.
- R: another `*.rs` change.
- N: a Nix change (`*.nix` or `flake.lock`) and no L or R change.
- 0: none of the above.
"""

from __future__ import annotations

import argparse
import functools
import json
import re
import statistics
import subprocess
import sys
from datetime import datetime

REPO = "xmtp/libxmtp"
# GitHub returns 30 jobs per page by default, and a run can have 56 jobs.
PAGE = 100
# A run lists at most this many pages when it searches for runs of one class.
MAX_LIST_PAGES = 10
MAX_MARKER_LINES = 200
# GitHub lists at most this many files of a comparison, and of a commit or a
# pull request through pagination.
COMPARE_FILE_CAP = 300
LISTED_FILE_CAP = 3000

TIMESTAMP = re.compile(r"^\d{4}-\d{2}-\d{2}T[0-9:.]+Z ")
# Terminal escape sequences: CSI; OSC, DCS, SOS, PM, and APC strings, with a
# 7-bit (ESC ] P X ^ _) or 8-bit (U+009D U+0090 U+0098 U+009E U+009F)
# introducer, which end at BEL, at ST (ESC \ or U+009C), or at the end of the
# line; and other ESC sequences.
ESCAPE_SEQUENCE = re.compile(
    r"\x1b\[[0-?]*[ -/]*[@-~]"
    r"|(?:\x1b[\]PX^_]|[\x90\x98\x9d\x9e\x9f])[^\x07\x1b\x9c]*(?:\x07|\x1b\\|\x9c)?"
    r"|\x1b[ -/]*[0-~]"
)
# C0 controls except tab, DEL, and C1 controls.
CONTROL = re.compile(r"[\x00-\x08\x0a-\x1f\x7f-\x9f]")
# actions/checkout fetches refs/pull/N/merge into this ref.
PULL_REF = re.compile(r"refs/remotes/pull/(\d+)/merge")
# actions/checkout prints this line after it checks out refs/pull/N/merge.
MERGE_CHECKOUT = re.compile(
    r"HEAD is now at ([0-9a-f]{7,40}) Merge ([0-9a-f]{40}) into ([0-9a-f]{40})"
)
# The Nix plan headers. Indented store paths under a header belong to it.
FETCH_HEADER = re.compile(r"^(this path|these \d+ paths) will be fetched")
BUILD_HEADER = re.compile(r"^(this derivation|these \d+ derivations) will be built")
STORE_ITEM = re.compile(r"^\s+/nix/store/(\S+)$")
BUILDING = re.compile(r"^building '/nix/store/([^']+)'")
# The test outputs: for each, the jobs that build it and their derivations. A
# digit after the name excludes dependency layers such as
# `cargo-package-nextest-deps-…`. The WASM tests ran in one job until 4
# partition jobs replaced it; a run has one shape or the other. The archive
# job only compiles the tests, so its build does not count as a test run.
WASM_PARTITIONS = 4
TEST_OUTPUTS = {
    "nextest": [
        (
            "Test (Rust Workspace)",
            re.compile(r"^[0-9a-z]{32}-cargo-package-nextest-\d"),
        )
    ],
    "wasm": [
        ("Test (WASM)", re.compile(r"^[0-9a-z]{32}-wasm-nextest-\d")),
    ]
    + [
        (
            f"Test (WASM {part})",
            re.compile(rf"^[0-9a-z]{{32}}-wasm-nextest-part-{part}-\d"),
        )
        for part in range(1, WASM_PARTITIONS + 1)
    ],
}

L_NAMES = {"Cargo.lock", "Cargo.toml"}
L_ENTRY_POINTS = re.compile(r"(^|/)src/(lib\.rs|main\.rs|bin/.+)$")


def clean(text):
    """Make text from a job log or from GitHub safe to print to a terminal.

    Any PR author controls the CI logs and the job and step names. Remove the
    escape sequences, then show every other control character as `\\xNN`.
    """
    return CONTROL.sub(
        lambda match: f"\\x{ord(match.group()):02x}", ESCAPE_SEQUENCE.sub("", text)
    )


def say(text, file=None):
    print(clean(text), file=file)


def fail(message):
    say(f"metrics: {message}", file=sys.stderr)
    raise SystemExit(1)


def gh(*args):
    result = subprocess.run(["gh", *args], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        fail(f"gh {' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout


def api(path):
    return json.loads(gh("api", f"repos/{REPO}/{path}"))


def api_pages(path):
    """Read every page of a list endpoint."""
    return json.loads(gh("api", "--paginate", "--slurp", f"repos/{REPO}/{path}"))


@functools.cache
def escape_flag():
    # gh 2.97 and later refuse to print a log with ANSI escapes unless asked.
    # Older gh has no such flag.
    return (
        ["--allow-escape-sequences"]
        if "--allow-escape-sequences" in gh("api", "--help")
        else []
    )


class LogUnavailable(Exception):
    pass


def stamped_lines(job_id):
    """Yield the lines of one job log, safe to print (see `clean`)."""
    args = ["gh", "api", *escape_flag(), f"repos/{REPO}/actions/jobs/{job_id}/logs"]
    with subprocess.Popen(
        args,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        encoding="utf-8",
        errors="replace",
    ) as process:
        for line in process.stdout:
            yield clean(line.rstrip("\n"))
        error = process.stderr.read().strip()
    if process.returncode != 0:
        raise LogUnavailable(f"cannot read the log of job {job_id}: {error}")


def log_lines(job_id):
    """Yield the lines of one job log without timestamps."""
    for line in stamped_lines(job_id):
        yield TIMESTAMP.sub("", line)


def parse_time(text):
    return datetime.fromisoformat(text.replace("Z", "+00:00")) if text else None


def seconds(start, end):
    start, end = parse_time(start), parse_time(end)
    if start is None or end is None:
        return 0.0
    return max(0.0, (end - start).total_seconds())


def runner_class(labels):
    """Return (system, runner class) for the labels of a job."""
    label = " ".join(labels)
    blacksmith = re.search(r"blacksmith-(\d+)vcpu-ubuntu", label)
    if blacksmith:
        return "Linux", f"Blacksmith {blacksmith.group(1)} vCPU"
    if "warp-macos" in label:
        return "macOS", "Warp macOS"
    if "macos" in label:
        return "macOS", "GitHub macOS"
    if "windows" in label:
        return "Windows", "GitHub Windows"
    if "ubuntu" in label:
        return "Linux", "GitHub Linux"
    return "other", label or "unknown"


def change_class(files):
    """Classify a diff. `files` holds GitHub file entries (filename, status)."""
    rust = nix = False
    for entry in files:
        names = [entry["filename"], entry.get("previous_filename")]
        for name in filter(None, names):
            base = name.rsplit("/", 1)[-1]
            if (
                base in L_NAMES
                or name == ".cargo/config.toml"
                or name.startswith("proto/")
                or (base == "build.rs" and name.startswith(("crates/", "apps/")))
                or (
                    entry["status"] in ("added", "removed", "renamed")
                    and L_ENTRY_POINTS.search(name)
                )
            ):
                return "L"
            rust = rust or name.endswith(".rs")
            nix = nix or name.endswith(".nix") or name == "flake.lock"
    return "R" if rust else "N" if nix else "0"


def pr_checkout(jobs):
    """Return the PR number and the merge, head, and base commits of a PR run.

    The PR run's selection job fetches and checks out refs/pull/N/merge. It
    is named `Select suites`; runs before the ci.yml redesign name it
    `detect-changes`.
    """
    job = next(
        (job for job in jobs if job["name"] in ("Select suites", "detect-changes")),
        None,
    )
    if job is None:
        return None
    number = None
    try:
        for line in log_lines(job["id"]):
            ref = PULL_REF.search(line)
            if ref:
                number = int(ref.group(1))
            merge = MERGE_CHECKOUT.search(line)
            if merge:
                return {
                    "number": number,
                    "merge": merge.group(1),
                    "head": merge.group(2),
                    "base": merge.group(3),
                }
    except LogUnavailable:
        pass
    return None


@functools.cache
def run_jobs(run_id):
    """Return every job that ran, in every attempt of a run.

    A re-run attempt lists each job that it reused from an earlier attempt
    again, under a new ID and with the same name and times. Keep the first.
    """
    pages = api_pages(f"actions/runs/{run_id}/jobs?per_page={PAGE}&filter=all")
    jobs, seen = [], set()
    listed = [job for page in pages for job in page["jobs"]]
    for job in sorted(listed, key=lambda item: item.get("run_attempt", 1)):
        key = (job["name"], job.get("started_at"), job.get("completed_at"))
        if key not in seen:
            seen.add(key)
            jobs.append(job)
    return jobs


def latest_jobs(jobs):
    """Return the job of the latest attempt for each job name."""
    latest = {}
    for job in jobs:
        if job.get("run_attempt", 1) >= latest.get(job["name"], {}).get(
            "run_attempt", 1
        ):
            latest[job["name"]] = job
    return list(latest.values())


def pr_files(checkout):
    """Return the files of the PR diff that a run tested, and whether GitHub
    listed all of them."""
    number = checkout["number"]
    if number is not None:
        pull = api(f"pulls/{number}")
        if pull["head"]["sha"] == checkout["head"]:
            pages = api_pages(f"pulls/{number}/files?per_page={PAGE}")
            files = [entry for page in pages for entry in page]
            return files, len(files) == pull["changed_files"]
    # The PR has a newer head than this run. Three dots give the diff from
    # the merge base, which is the PR's diff, but list at most 300 files.
    compared = api(f"compare/{checkout['base']}...{checkout['head']}")
    files = compared.get("files", [])
    return files, len(files) < COMPARE_FILE_CAP


def started(run):
    return any(job.get("steps") for job in run_jobs(run["id"]))


# `previous_tested_sha` found no earlier run within MAX_LIST_PAGES pages.
UNKNOWN = "unknown"


def previous_tested_sha(run):
    """Return the head of the previous push run on the branch that started.

    GitHub lists the newest runs first. Page back at most MAX_LIST_PAGES
    pages. Return None if the branch has no earlier run that started, and
    UNKNOWN if the pages end before the search does.
    """
    workflow = run["path"].rsplit("/", 1)[-1]
    for page in range(1, MAX_LIST_PAGES + 1):
        listed = api(
            f"actions/workflows/{workflow}/runs?branch={run['head_branch']}"
            f"&event=push&per_page={PAGE}&page={page}"
        )["workflow_runs"]
        earlier = [item for item in listed if item["created_at"] < run["created_at"]]
        for item in sorted(earlier, key=lambda item: item["created_at"], reverse=True):
            if started(item):
                return item["head_sha"]
        if len(listed) < PAGE:
            return None
    return UNKNOWN


def push_files(run):
    """Return the files that a push run tested, and whether GitHub listed all
    of them."""
    pages = api_pages(f"commits/{run['head_sha']}?per_page={PAGE}")
    parents = [parent["sha"] for parent in pages[0].get("parents", [])] if pages else []
    base = previous_tested_sha(run)
    if base in (None, UNKNOWN) or parents == [base]:
        # The run tested its head commit alone, or at least its head commit
        # when the earlier runs are unknown.
        files = [entry for page in pages for entry in page.get("files", [])]
        return files, base != UNKNOWN and len(files) < LISTED_FILE_CAP
    # The run also tested the commits of the runs that it replaced.
    files = api(f"compare/{base}...{run['head_sha']}").get("files", [])
    return files, len(files) < COMPARE_FILE_CAP


def run_class(run, jobs):
    """Return the change class of the diff that a run tested, or `?`.

    An L file in a partial list proves class L. Any other class of a partial
    list is unknown, because an unlisted file can raise it.
    """
    if run["event"] == "pull_request":
        checkout = pr_checkout(latest_jobs(jobs))
        if checkout is None:
            return "?"
        files, complete = pr_files(checkout)
    else:
        files, complete = push_files(run)
    kind = change_class(files)
    return kind if complete or kind == "L" else "?"


def tested_tree(run):
    """Compare the trunk tree with the tree that the PR's last run tested.

    The PR's last run tested `refs/pull/N/merge`, not the PR head. Its
    detect-changes job prints that merge commit when it checks it out.
    """
    sha = run["head_sha"]
    # The PR whose merge commit is the trunk commit. Its number names the
    # refs/pull/N/merge ref that its runs checked out.
    pulls = [
        pull
        for pull in api(f"commits/{sha}/pulls")
        if pull.get("merge_commit_sha") == sha
    ]
    if not pulls:
        return "no-pr"
    head = pulls[0]["head"]["sha"]
    workflow = run["path"].rsplit("/", 1)[-1]
    listed = api(
        f"actions/workflows/{workflow}/runs?event=pull_request&head_sha={head}&per_page={PAGE}"
    )
    for pr_run in sorted(
        listed["workflow_runs"], key=lambda item: item["created_at"], reverse=True
    ):
        checkout = pr_checkout(latest_jobs(run_jobs(pr_run["id"])))
        # A PR to another base can have the same head. Read only the runs of
        # the PR that this commit merged.
        if checkout and checkout["number"] == pulls[0]["number"]:
            tree = api(f"commits/{checkout['merge']}")["commit"]["tree"]["sha"]
            return "same" if tree == run["head_commit"]["tree_id"] else "differs"
    return "unknown"


def test_output(jobs, job_name, pattern):
    """Return whether a job fetched or built a test output.

    Nix can plan to fetch an output and then build it, when a path in its
    closure cannot be substituted. So a build line wins over a fetch plan.
    Nix prints nothing for a path that is already valid, so a log with no
    plan for the output (for example, a job that failed before `nix build`)
    gives `?`.
    """
    job = next(
        (job for job in latest_jobs(jobs) if job["name"].endswith(job_name)), None
    )
    if job is None or job.get("conclusion") == "skipped":
        return "-"
    section, fetched = None, False
    try:
        for line in log_lines(job["id"]):
            building = BUILDING.match(line)
            if building and pattern.search(building.group(1)):
                return "built"
            if FETCH_HEADER.search(line):
                section = "fetched"
                continue
            if BUILD_HEADER.search(line):
                section = "built"
                continue
            item = STORE_ITEM.match(line)
            if item is None:
                section = None
            elif section and pattern.search(item.group(1)):
                if section == "built":
                    return "built"
                fetched = True
    except LogUnavailable:
        return "?"
    return "fetched" if fetched else "?"


def test_outputs(jobs, specs):
    """Return whether the jobs of one test output fetched or built it.

    A build in any job means the tests ran, so it wins; a job with no result
    (`?`) wins over a fetch; jobs that did not run (`-`) do not count.
    """
    results = [test_output(jobs, *spec) for spec in specs]
    ran = [result for result in results if result != "-"]
    if not ran:
        return "-"
    for result in ("built", "?"):
        if result in ran:
            return result
    return "fetched"


def measure(run, jobs):
    # Terms: wall time runs from run creation to run end. `run_started_at` is
    # the start of the latest attempt only.
    start = run["created_at"]
    ends = [job["completed_at"] for job in jobs if job.get("completed_at")]
    by_class, by_system, steps = {}, {}, []
    for job in jobs:
        duration = seconds(job.get("started_at"), job.get("completed_at"))
        if duration == 0:
            continue
        system, kind = runner_class(job.get("labels") or [])
        by_class[kind] = by_class.get(kind, 0.0) + duration / 60
        by_system[system] = by_system.get(system, 0.0) + duration / 60
        short = job["name"].rsplit(" / ", 1)[-1]
        for step in job.get("steps") or []:
            steps.append(
                (
                    seconds(step.get("started_at"), step.get("completed_at")),
                    short,
                    step["name"],
                )
            )
    steps.sort(key=lambda item: item[0], reverse=True)
    return {
        "wall": seconds(start, max(ends)) / 60
        if ends
        else seconds(start, run["updated_at"]) / 60,
        "class_min": by_class,
        "system_min": by_system,
        "slowest": steps[:3],
    }


def list_runs(args):
    query = f"per_page={PAGE}&status=completed"
    if args.branch:
        query += f"&branch={args.branch}"
    if args.event:
        query += f"&event={args.event}"
    for page in range(1, MAX_LIST_PAGES + 1):
        listed = api(f"actions/workflows/{args.workflow}/runs?{query}&page={page}")[
            "workflow_runs"
        ]
        yield from listed
        if len(listed) < PAGE:
            return


def selected_runs(args):
    if args.run_ids:
        return (api(f"actions/runs/{run_id}") for run_id in args.run_ids)
    return list_runs(args)


def runs(args):
    reports, cancelled_in_progress, replaced = [], 0, 0
    for run in selected_runs(args):
        if not args.run_ids and len(reports) >= args.limit:
            break
        jobs = run_jobs(run["id"])
        kind = run_class(run, jobs)
        if args.change_class and kind != args.change_class:
            continue
        if run["conclusion"] == "cancelled":
            # GitHub cancels a pending run that a newer run replaces before
            # any job starts. Only a run with a started job was in progress.
            if started(run):
                cancelled_in_progress += 1
                say(f"{run['id']} {run['event']} cancelled in progress class={kind}")
            else:
                replaced += 1
                say(
                    f"{run['id']} {run['event']} cancelled before it started class={kind}"
                )
            continue
        report = measure(run, jobs)
        report["kind"] = kind
        line = (
            f"{run['id']} {run['event']} {run['conclusion']} class={kind} "
            + (
                f"attempts={run['run_attempt']} "
                if run.get("run_attempt", 1) > 1
                else ""
            )
            + f"wall={report['wall']:.1f} "
            + " ".join(
                f"{system}={minutes:.1f}"
                for system, minutes in sorted(report["system_min"].items())
            )
        )
        if run["event"] == "push":
            report["tree"] = tested_tree(run)
            report["outputs"] = {
                name: test_outputs(jobs, specs) for name, specs in TEST_OUTPUTS.items()
            }
            line += f" tree={report['tree']} " + " ".join(
                f"{k}={v}" for k, v in report["outputs"].items()
            )
        say(line)
        for duration, job, step in report["slowest"]:
            say(f"  {duration:6.0f}s {job} > {step}")
        reports.append(report)
    summarize(reports, cancelled_in_progress, replaced)


def summarize(reports, cancelled_in_progress, replaced):
    say(
        f"runs: {len(reports)} measured; cancelled in progress {cancelled_in_progress}; "
        f"cancelled before start {replaced}"
    )
    if not reports:
        return
    say(f"median wall: {statistics.median(r['wall'] for r in reports):.1f} min")
    # Runner minutes are a cost that adds across runs, so the mean leads.
    for key, title in (
        ("system_min", "runner-min per run, mean (median)"),
        ("class_min", "runner-min per run by class, mean (median)"),
    ):
        names = sorted({name for r in reports for name in r[key]})
        values = {name: [r[key].get(name, 0.0) for r in reports] for name in names}
        summary = ", ".join(
            f"{name} {statistics.mean(values[name]):.1f} "
            f"({statistics.median(values[name]):.1f})"
            for name in names
        )
        say(f"{title}: {summary}")
    merges = [r for r in reports if "tree" in r]
    if merges:
        say(
            "merge tree equals the PR's last tested tree: "
            + share([r["tree"] for r in merges], "same", ("same", "differs"))
        )
        for name in TEST_OUTPUTS:
            say(
                f"merge runs that fetched the {name} output: "
                + share(
                    [r["outputs"][name] for r in merges],
                    "fetched",
                    ("fetched", "built"),
                )
            )


def share(results, wanted, known):
    """Count `wanted` among the runs with a known result; name the others."""
    counted = [result for result in results if result in known]
    text = f"{counted.count(wanted)} of {len(counted)}"
    unknown = len(results) - len(counted)
    return text + (f" ({unknown} without a result)" if unknown else "")


def marker(args):
    pattern = re.compile(args.pattern)
    printed = extra = 0
    try:
        for line in stamped_lines(args.job_id):
            if pattern.search(TIMESTAMP.sub("", line)):
                if printed < args.max:
                    say(line)
                    printed += 1
                else:
                    extra += 1
    except LogUnavailable as error:
        fail(str(error))
    if extra:
        say(
            f"metrics: {extra} more matching lines not shown (--max {args.max})",
            file=sys.stderr,
        )


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    commands = parser.add_subparsers(dest="command", required=True)

    runs_parser = commands.add_parser("runs", help="measure runs")
    runs_parser.add_argument(
        "run_ids", nargs="*", help="run IDs; without them, list runs"
    )
    runs_parser.add_argument("--workflow", default="ci.yml")
    runs_parser.add_argument("--branch")
    runs_parser.add_argument("--event", help="for example push or pull_request")
    runs_parser.add_argument(
        "--limit",
        type=int,
        default=10,
        help="measured runs to report when listing; cancelled runs do not count",
    )
    runs_parser.add_argument(
        "--class", dest="change_class", choices=("L", "R", "N", "0")
    )
    runs_parser.set_defaults(handler=runs)

    marker_parser = commands.add_parser(
        "marker", help="print the matching lines of one job log"
    )
    marker_parser.add_argument("job_id")
    marker_parser.add_argument("pattern", help="a Python regular expression")
    marker_parser.add_argument("--max", type=int, default=MAX_MARKER_LINES)
    marker_parser.set_defaults(handler=marker)

    args = parser.parse_args(argv)
    args.handler(args)


if __name__ == "__main__":
    main()
