#!/usr/bin/env python3
"""Select CI suites and product groups for the changed paths and record the decision."""

from __future__ import annotations

import functools
import html
import json
import os
from pathlib import Path
import re
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parents[1]
MANIFEST_PATH = ROOT / ".github/ci-suites.json"
# Generated by dev/ci-suites from .github/ci-suites.yml. Do not edit by hand.
MANIFEST = json.loads(MANIFEST_PATH.read_text())
SUITES = MANIFEST["suites"]
EVENT_KINDS = ("draft_pr_push", "ready_pr_push", "merge")
LARGE_PR = 3000


@functools.lru_cache(maxsize=None)
def glob_regex(pattern):
    """Compile a path glob: `**` spans directories, `*` and `?` do not."""

    def convert(text):
        out, i = "", 0
        while i < len(text):
            if text.startswith("**/", i):
                out, i = out + "(?:.*/)?", i + 3
            elif text.startswith("**", i):
                out, i = out + ".*", i + 2
            elif text[i] == "*":
                out, i = out + "[^/]*", i + 1
            elif text[i] == "?":
                out, i = out + "[^/]", i + 1
            elif text[i] == "{":
                depth, j = 0, i
                while True:
                    depth += {"{": 1, "}": -1}.get(text[j], 0)
                    if depth == 0:
                        break
                    j += 1
                parts, depth, last = [], 0, i + 1
                for k in range(i + 1, j):
                    depth += {"{": 1, "}": -1}.get(text[k], 0)
                    if text[k] == "," and depth == 0:
                        parts.append(text[last:k])
                        last = k + 1
                parts.append(text[last:j])
                out += "(?:" + "|".join(convert(p) for p in parts) + ")"
                i = j + 1
            else:
                out, i = out + re.escape(text[i]), i + 1
        return out

    return re.compile(convert(pattern) + r"\Z", re.DOTALL)


def glob_match(pattern, path):
    return glob_regex(pattern).match(path) is not None


def any_match(patterns, path):
    return any(glob_match(p, path) for p in patterns)


class Rules:
    """Path rules from the generated manifest."""

    def __init__(self, manifest):
        self.manifest = manifest
        self.suites = {
            name: self._split(suite["crates"] + suite["workflow_files"], suite["paths"])
            for name, suite in manifest["suites"].items()
        }
        # Each list's exclusions apply to that list's matches only.
        self.advisory = {
            name: self._split(suite["advisory"]["crates"], suite["advisory"]["paths"])
            for name, suite in manifest["suites"].items()
        }
        self.products = {
            group: self._split(spec["crates"], spec["paths"])
            for group, spec in manifest.get("products", {}).items()
        }

    @staticmethod
    def _split(include, paths):
        include = include + [p for p in paths if not p.startswith("!")]
        return include, [p[1:] for p in paths if p.startswith("!")]

    def _matching(self, rules, path):
        # Neutral files select only through a repository-wide glob.
        neutral = self.neutral(path)
        found = []
        for name, (include, exclude) in rules.items():
            if neutral:
                include = [p for p in include if p.startswith("**/")]
            if any_match(include, path) and not any_match(exclude, path):
                found.append(name)
        return found

    def neutral(self, path):
        return any_match(self.manifest["neutral"], path)

    def shared(self, path):
        return not self.neutral(path) and any_match(self.manifest["shared"], path)

    def suites_for(self, path):
        """The suites whose blocking filters (pr_filters) match the path."""
        return self._matching(self.suites, path)

    def advisory_for(self, path):
        """The suites whose advisory_filters match the path."""
        return self._matching(self.advisory, path)

    def products_for(self, path):
        return self._matching(self.products, path)

    def known(self, path):
        return (
            self.neutral(path)
            or self.shared(path)
            or any(
                any_match(include, path)
                for rules in (self.suites, self.advisory)
                for include, _ in rules.values()
            )
        )


def has_advisory_tier(suite):
    advisory = suite["advisory"]
    return bool(advisory["crates"] or advisory["paths"] or advisory["labels"])


def json_strings(value):
    """Require a JSON array of strings. Empty arrays are valid."""
    items = json.loads(value) if isinstance(value, str) else value
    if not isinstance(items, list) or any(not isinstance(x, str) for x in items):
        raise ValueError("Expected a JSON array of strings")
    return items


def event_kind(event_name, event):
    if event_name == "workflow_dispatch":
        return "manual"
    if event_name == "push":
        return "merge"
    if event.get("pull_request", {}).get("draft"):
        return "draft_pr_push"
    return "ready_pr_push"


class RequestError(ValueError):
    """A manual run asked for a suite that the declaration does not have."""


def requested_suites(event):
    """The suites of a manual run's `suites` input. Empty means every suite."""
    text = str((event.get("inputs") or {}).get("suites") or "")
    names = [name.strip() for name in text.split(",") if name.strip()]
    unknown = sorted(set(names) - set(SUITES))
    if unknown:
        # JSON quoting keeps a line break in the input on one line.
        raise RequestError(
            "Unknown suites in the suites input: "
            + ", ".join(json.dumps(name) for name in unknown)
            + ". Use suite keys of .github/ci-suites.yml: "
            + ", ".join(SUITES)
            + "."
        )
    return list(dict.fromkeys(names))


def select_suites(
    files,
    event_name,
    event,
    outcome,
    changed_files=None,
    metadata_error=None,
    deleted=(),
    pr_cache_token=True,
):
    """Choose suites and their tiers. `files` is None when the changed-file list
    is unavailable.

    `deleted` lists changed paths that are not in the checkout.
    `pr_cache_token` says whether the run can push to xmtp-pr.
    """
    pr = event.get("pull_request", {}) if event_name == "pull_request" else {}
    # A deleted fork has no head repository.
    head_repo = (pr.get("head") or {}).get("repo") or {}
    fork = bool(pr) and head_repo.get("full_name") != (
        event.get("repository", {}).get("full_name")
    )
    kind = event_kind(event_name, event)
    rules = Rules(MANIFEST)
    # Suites matched by a blocking filter, and by an advisory filter.
    matched, advisory_matched = set(), set()
    shared, unknown, details, reasons = [], [], [], []
    labels = {label["name"] for label in pr.get("labels", [])}
    matched_labels = set()
    for name, suite in SUITES.items():
        for found, into in (
            (labels.intersection(suite["labels"]), matched),
            (labels.intersection(suite["advisory"]["labels"]), advisory_matched),
        ):
            if found:
                into.add(name)
                matched_labels.update(found)
    matched_products = set()
    requested = []
    if kind == "manual":
        requested = requested_suites(event)
        reasons.append("explicit_request")
    elif kind == "merge":
        reasons.append("merge")
    if kind != "manual":
        if metadata_error:
            details.append(metadata_error)
        if event_name == "pull_request":
            if type(changed_files) is not int or changed_files < 0:
                details.append("The PR changed-file total is unavailable.")
            elif changed_files > LARGE_PR:
                reasons.append("large_pr")
        if outcome != "success":
            details.append(f"Path filter result: {outcome}.")
        if files is None:
            details.append("The changed-file list is unavailable.")
        if details:
            reasons.append("detection_failed")
        else:
            for path in files:
                matched.update(rules.suites_for(path))
                advisory_matched.update(rules.advisory_for(path))
                matched_products.update(rules.products_for(path))
            # A deletion or rename can leave a rule that names no file.
            if deleted:
                matched.update(MANIFEST["on_deleted_path"])
            shared = sorted({p for p in files if rules.shared(p)})
            unknown = sorted({p for p in files if not rules.known(p)})
            if shared:
                reasons.append("shared_input")
            if unknown:
                reasons.append("unknown_paths")
    eligible = {
        name
        for name, suite in SUITES.items()
        if (kind == "manual" or kind in suite["run_on"])
        and not (fork and suite["disable_on_forks"])
    }
    if requested:
        selected = set(requested) & eligible
    elif reasons:
        selected = eligible
    else:
        selected = (matched | advisory_matched) & eligible

    def tier(name):
        # A suite is advisory only on a pull request where no blocking filter
        # matched it: an advisory filter selected it, or a full run did.
        if kind in ("merge", "manual") or name in matched:
            return "blocking"
        return "advisory" if has_advisory_tier(SUITES[name]) else "blocking"

    tiers = {name: tier(name) for name in selected}

    def covered(name):
        # A cover replaces a suite only when it runs in the same or a
        # stronger tier, so a blocking suite never gives way to an advisory one.
        cover = SUITES[name]["covered_by"]
        return cover in tiers and (
            tiers[cover] == "blocking" or tiers[name] == "advisory"
        )

    tiers = {name: t for name, t in tiers.items() if not covered(name)}
    # A suite whose group does not run builds the products itself. A group
    # runs only when it can push to xmtp-pr for the suites to substitute.
    waited = {group for name in tiers for group in SUITES[name]["products"]}
    if not pr_cache_token:
        products = set()
    elif reasons:
        products = waited
    else:
        products = waited & matched_products
    considered = matched | advisory_matched | set(requested)
    if reasons and not requested:
        considered = set(SUITES)
    return {
        "event_kind": kind,
        "fork": fork,
        "pr_cache_token": pr_cache_token,
        "changed_files": changed_files,
        "reasons": reasons,
        "details": details,
        "requested_suites": requested,
        "matched_suites": sorted(matched),
        "advisory_matched_suites": sorted(advisory_matched - matched),
        "matched_labels": sorted(matched_labels),
        "deleted_paths": sorted(deleted),
        "shared_paths": shared,
        "unknown_paths": unknown,
        "policy_excluded": sorted(considered - eligible),
        "suites": {
            phase: [
                n
                for n in SUITES
                if tiers.get(n) == "blocking" and SUITES[n]["phase"] == phase
            ]
            for phase in ("lint", "test")
        },
        "advisory": [n for n in SUITES if tiers.get(n) == "advisory"],
        "matched_products": sorted(matched_products),
        "products": [g for g in MANIFEST["products"] if g in products],
    }


def code(text):
    """Keep text from a path, a label, or an input as text in Markdown."""
    text = str(text).replace("\n", "\\n").replace("\r", "\\r")
    return "<code>" + html.escape(text).replace("|", "&#124;") + "</code>"


def summary(result):
    if result["requested_suites"]:
        selection = "requested"
    elif result["reasons"]:
        selection = "full"
    else:
        selection = "filter-selected"
    lines = ["## CI selection", "", "| Field | Value |", "| --- | --- |"]
    fields = {
        "Event": result["event_kind"],
        "Fork": str(result["fork"]).lower(),
        "PR cache token": "present" if result["pr_cache_token"] else "absent",
        "Selection": selection,
        "PR changed files": result["changed_files"]
        if result["changed_files"] is not None
        else "Not applicable or unavailable",
        "Full-run reasons": ", ".join(result["reasons"]) or "None",
    }
    lines.extend(f"| {key} | {code(value)} |" for key, value in fields.items())
    lists = {
        "Detection details": result["details"],
        "Requested suites": result["requested_suites"],
        "Suites matched by blocking PR filters": result["matched_suites"],
        "Suites matched only by advisory PR filters": result["advisory_matched_suites"],
        "Matching PR labels": result["matched_labels"],
        "Deleted or renamed paths": result["deleted_paths"],
        "Shared paths": result["shared_paths"],
        "Unknown paths": result["unknown_paths"],
        "Suites excluded by event or fork policy": result["policy_excluded"],
        "Blocking lint suites": result["suites"]["lint"],
        "Blocking test suites": result["suites"]["test"],
        "Advisory suites (Lint and Test do not wait for these)": result["advisory"],
        "Product groups matched by paths": result["matched_products"],
        "Selected product groups": result["products"],
    }
    for title, values in lists.items():
        lines.extend(["", f"### {title}", ""])
        lines.extend("- " + code(value) for value in values[:200])
        if len(values) > 200:
            lines.append(f"- {len(values) - 200} more entries.")
        if not values:
            lines.append("None.")
    return "\n".join(lines) + "\n"


def pr_changed_files(event, env):
    pr = event["pull_request"]
    total = pr.get("changed_files")
    if type(total) is int and total >= 0:
        return total, None
    try:
        url = f"{env['GITHUB_API_URL']}/repos/{env['GITHUB_REPOSITORY']}/pulls/{pr['number']}"
        request = Request(
            url,
            headers={
                "Authorization": "Bearer " + env["GITHUB_TOKEN"],
                "Accept": "application/vnd.github+json",
                "User-Agent": "libxmtp-ci-select",
            },
        )
        with urlopen(request, timeout=20) as response:
            current = json.load(response)
        if current["head"]["sha"] != pr["head"]["sha"]:
            return None, "The PR head changed after this event."
        return current.get("changed_files"), None
    except (KeyError, HTTPError, URLError, TimeoutError, ValueError):
        return None, "Could not read PR metadata from the API."


def read_files(text):
    """Return the changed paths from the path filter, or None if they are unusable."""
    try:
        detected = json.loads(text)
        files = json_strings(detected["all_files_files"])
        if ("all_files" in json_strings(detected["changes"])) != bool(files):
            return None
        return files
    except (KeyError, TypeError, ValueError):
        return None


def main():
    env = os.environ
    event = json.loads(Path(env["GITHUB_EVENT_PATH"]).read_text())
    event_name = env["GITHUB_EVENT_NAME"]
    total, error = (
        pr_changed_files(event, env) if event_name == "pull_request" else (None, None)
    )
    files = read_files(sys.stdin.read())
    deleted = [p for p in files or [] if not (ROOT / p).exists()]
    try:
        result = select_suites(
            files,
            event_name,
            event,
            env.get("PATHS_OUTCOME", ""),
            total,
            error,
            deleted,
            env.get("PR_CACHE_TOKEN") == "true",
        )
    except RequestError as problem:
        with open(env["GITHUB_STEP_SUMMARY"], "a") as output:
            output.write(f"## CI selection\n\n{code(problem)}\n")
        print(f"::error title=Unknown suites::{problem}")
        sys.exit(1)

    def compact(value):
        return json.dumps(value, separators=(",", ":"))

    with open(env["GITHUB_OUTPUT"], "a") as output:
        for phase, names in result["suites"].items():
            output.write(f"{phase}_suites={compact(names)}\n")
        output.write(f"advisory_suites={compact(result['advisory'])}\n")
        output.write(f"products={compact(result['products'])}\n")
    with open(env["GITHUB_STEP_SUMMARY"], "a") as output:
        output.write(summary(result))


if __name__ == "__main__":
    main()
