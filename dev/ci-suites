#!/usr/bin/env python3.11
"""Compile .github/ci-suites.yml into the files that CI reads.

Commands:
  generate          Write .github/ci-suites.json and .github/workflows/ci.yml.
  check             Fail when the generated files are stale or the declaration is wrong.
  explain PATH...   Show the suites, by tier, and the product groups that each path selects.
  replay [N] [REF]  Replay the last N first-parent commits of REF as pull requests.
"""

from __future__ import annotations

import collections
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib

import yaml

ROOT = Path(__file__).resolve().parents[1]
DECLARATION = ".github/ci-suites.yml"
MANIFEST = ".github/ci-suites.json"
CI_WORKFLOW = ".github/workflows/ci.yml"
WORKFLOWS = ".github/workflows"
# The suite keys, in the order the declaration lists them.
SUITE_KEYS = (
    "title",
    "phase",
    "workflow",
    "run_on",
    "disable_on_forks",
    "secrets",
    "permissions",
    "covered_by",
    "skip_full_runs",
    "kache",
    "products",
    "runners",
    "with",
    "pr_filters",
    "advisory_filters",
)
OPTIONAL_SUITE_KEYS = {
    "covered_by",
    "skip_full_runs",
    "runners",
    "with",
    "advisory_filters",
}
REQUIRED_SUITE_KEYS = set(SUITE_KEYS) - OPTIONAL_SUITE_KEYS
FILTER_KEYS = {"cargo_package", "path_group"}
EVENT_KINDS = ("draft_pr_push", "ready_pr_push", "merge")
TOP_KEYS = {
    "version",
    "on_deleted_path",
    "shared",
    "neutral",
    "runners",
    "path_groups",
    "products",
    "suites",
}
# The jobs that ci.yml defines itself: Select suites, the products jobs, and
# the Lint and Test gates.
GENERATED_RUNNERS = ("select", "products", "gates")
KACHE_SECRETS = ("KACHE_S3_ACCESS_KEY_ID", "KACHE_S3_SECRET_ACCESS_KEY")
# Scoped modes forward only their named cache credentials.
SCOPED_SECRETS = {"kache": KACHE_SECRETS, "cachix-pr": ("CACHIX_PR_AUTH_TOKEN",)}
SECRET_MODES = ("inherit", "kache", "none", "cachix-pr")
# Runner labels a declaration may name. Blacksmith x64 Ubuntu 24.04 sizes
# (docs.blacksmith.sh/blacksmith-runners/overview), GitHub-hosted images, and
# the WarpBuild macOS labels in use. A new label is added here on purpose.
RUNNER_LABELS = frozenset(
    {
        "blacksmith-2vcpu-ubuntu-2404",
        "blacksmith-4vcpu-ubuntu-2404",
        "blacksmith-8vcpu-ubuntu-2404",
        "blacksmith-16vcpu-ubuntu-2404",
        "blacksmith-32vcpu-ubuntu-2404",
        "ubuntu-24.04",
        "ubuntu-24.04-arm",
        "macos-15",
        "warp-macos-15-arm64-6x",
        "warp-macos-15-arm64-12x",
        "warp-macos-26-arm64-6x",
        "warp-macos-26-arm64-12x",
    }
)
PRODUCTS_SYSTEM = "x86_64-linux"
# A group name is part of a job id and a flake attribute.
GROUP_NAME = re.compile(r"[a-z][a-z0-9_]*\Z")
# A suite key is a job id of ci.yml.
SUITE_NAME = re.compile(r"[a-z][a-z0-9_]*\Z")
INPUT_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_-]*\Z")
# A title becomes a job name, so a check reads `<title> / <job name>`. No `/`,
# which separates those parts, and no `$`, which could start an expression.
TITLE = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9 _.,()+-]*[A-Za-z0-9)])?\Z")
TITLE_LENGTH = 30
ADVISORY_SUFFIX = " (advisory)"
# The gate names: required, on drafts, and on manual runs of some suites.
# Branch protection requires `Lint` and `Test`. A draft run and a manual run
# of a subset of the suites do not check everything, so their gates take
# other names and cannot satisfy the required checks.
GATE_NAMES = {
    "lint": ("Lint", "Lint (draft)", "Lint (manual subset)"),
    "test": ("Test", "Test (not run on drafts)", "Test (manual subset)"),
}
# Job names that ci.yml uses itself. A skipped job with a required name counts
# as passing, so no caller job may take one of these names.
RESERVED_NAMES = ("Select suites",) + tuple(
    name for names in GATE_NAMES.values() for name in names
)
PERMISSION_LEVELS = {"none": 0, "read": 1, "write": 2}
CHECKOUT = "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0"


def load_selector():
    loader = importlib.machinery.SourceFileLoader(
        "ci_select", str(ROOT / "dev/ci-select")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class DeclarationError(Exception):
    pass


# --- Cargo graph -------------------------------------------------------------


class CargoGraph:
    """Path dependencies between workspace members, read from Cargo.toml files."""

    def __init__(self, root: Path):
        self.root = root
        manifest = tomllib.loads((root / "Cargo.toml").read_text())
        workspace = manifest["workspace"]
        self.workspace_dependencies = workspace.get("dependencies", {})
        self.patches = manifest.get("patch", {}).get("crates-io", {})
        self.members = self._expand(workspace["members"])
        self.default_members = self._expand(workspace.get("default-members", []))
        self.by_name = {}
        self.manifests = {}
        for member in self.members:
            data = tomllib.loads((root / member / "Cargo.toml").read_text())
            self.manifests[member] = data
            self.by_name[data["package"]["name"]] = member

    def _expand(self, patterns):
        found = []
        for pattern in patterns:
            for path in sorted(self.root.glob(pattern)):
                if (path / "Cargo.toml").is_file():
                    found.append(path.relative_to(self.root).as_posix())
        return found

    def _relative(self, path: Path) -> str:
        return Path(os.path.normpath(path)).relative_to(self.root).as_posix()

    def _tables(self, manifest, dev):
        kinds = ("dependencies", "build-dependencies") + (
            ("dev-dependencies",) if dev else ()
        )
        tables = [manifest.get(kind, {}) for kind in kinds]
        for target in manifest.get("target", {}).values():
            tables.extend(target.get(kind, {}) for kind in kinds)
        return tables

    def dependencies(self, member, dev=False):
        found = set()
        for table in self._tables(self.manifests[member], dev):
            for name, spec in table.items():
                base = self.root / member
                if isinstance(spec, dict) and spec.get("workspace"):
                    spec = self.workspace_dependencies.get(name, {})
                    base = self.root
                package = spec.get("package", name) if isinstance(spec, dict) else name
                if isinstance(spec, dict) and "path" in spec:
                    found.add(self._relative(base / spec["path"]))
                elif "path" in self.patches.get(package, {}):
                    found.add(self._relative(self.root / self.patches[package]["path"]))
        return found

    def closure(self, roots):
        start = []
        for root in roots:
            if root == "@default-members":
                start.extend(self.default_members)
            elif root in self.by_name:
                start.append(self.by_name[root])
            else:
                raise DeclarationError(f"Unknown Cargo package: {root}")
        # Cargo builds dev-dependencies only for the packages under test.
        queue = [dep for member in start for dep in self.dependencies(member, dev=True)]
        seen = set(start)
        while queue:
            member = queue.pop()
            if member in seen:
                continue
            seen.add(member)
            if member in self.manifests:
                queue.extend(self.dependencies(member) - seen)
        return sorted(seen)


# --- Workflows ---------------------------------------------------------------


def local_uses(document):
    """Yield local `uses:` targets anywhere in a workflow or action file."""
    if isinstance(document, dict):
        for key, value in document.items():
            if key == "uses" and isinstance(value, str) and value.startswith("./"):
                yield value[2:]
            else:
                yield from local_uses(value)
    elif isinstance(document, list):
        for item in document:
            yield from local_uses(item)


def kache_values(document):
    if isinstance(document, dict):
        for key, value in document.items():
            if key == "with" and isinstance(value, dict) and "kache-scope" in value:
                yield str(value["kache-scope"])
            yield from kache_values(value)
    elif isinstance(document, list):
        for item in document:
            yield from kache_values(item)


def kache_scopes(value):
    """Turn a workflow value into scopes; an expression without literals is `*`."""
    if "${{" not in value:
        return {value}
    # `cond && 'a' || 'b'` yields a or b; the literal in the condition is not a scope.
    literals = re.findall(r"(?:&&|\|\|)\s*'([^']+)'", value)
    if literals:
        return set(literals)
    return {re.sub(r"\$\{\{.*?\}\}", "*", value)}


def workflow_closure(root: Path, workflow: str):
    """The workflow file plus every local workflow and action it uses."""
    files, scopes, queue, seen = [], set(), [workflow], set()
    while queue:
        target = queue.pop()
        if target in seen:
            continue
        seen.add(target)
        path = root / target
        if path.is_dir():
            files.append(f"{target}/**")
            path = next(
                (
                    path / n
                    for n in ("action.yml", "action.yaml")
                    if (path / n).exists()
                ),
                None,
            )
            if path is None:
                continue
        elif path.is_file():
            files.append(target)
        else:
            raise DeclarationError(f"Missing workflow or action: {target}")
        document = yaml.safe_load(path.read_text())
        for value in kache_values(document):
            scopes |= kache_scopes(value)
        queue.extend(local_uses(document))
    return sorted(files), scopes


# --- Compile -----------------------------------------------------------------


def as_list(value, where):
    if value is None:
        return []
    if not isinstance(value, list) or any(not isinstance(v, str) for v in value):
        raise DeclarationError(f"{where} must be a list of strings")
    return value


def expand_filters(filters, groups, where, stack=()):
    """Return the Cargo packages and globs that a path_filters list names."""
    if not isinstance(filters, list):
        raise DeclarationError(f"{where} must be a list")
    packages, globs = [], []
    for item in filters:
        if isinstance(item, str):
            globs.append(item)
            continue
        if not isinstance(item, dict) or len(item) != 1 or set(item) - FILTER_KEYS:
            raise DeclarationError(
                f"{where} has an unknown filter {item!r}; use a glob, cargo_package, or path_group"
            )
        ((kind, value),) = item.items()
        if kind == "cargo_package":
            packages += (
                [value]
                if isinstance(value, str)
                else as_list(value, f"{where}.cargo_package")
            )
        elif value in stack:
            raise DeclarationError(f"path_group {value} includes itself")
        elif value not in groups:
            raise DeclarationError(f"{where} uses unknown path_group {value}")
        else:
            more_packages, more_globs = expand_filters(
                groups[value], groups, f"path_groups.{value}", stack + (value,)
            )
            packages += more_packages
            globs += more_globs
    return packages, globs


def compile_filters(filters, groups, graph, where):
    """The Cargo roots, crate globs, and path globs that a path_filters list selects."""
    cargo, paths = expand_filters(filters, groups, where)
    crates = graph.closure(sorted(set(cargo))) if cargo else []
    if crates:
        paths += ["Cargo.toml", "Cargo.lock"]
    return {
        "cargo_roots": sorted(set(cargo)),
        "crates": [f"{c}/**" for c in crates],
        "paths": sorted({p for p in paths if not p.startswith("!")})
        + sorted({p for p in paths if p.startswith("!")}),
    }


def compile_pr_filters(filters, groups, graph, where):
    """Separate label matches from the path filters of one filter list."""
    if not isinstance(filters, list):
        raise DeclarationError(f"{where} must be a list")
    paths, labels = [], []
    for item in filters:
        if isinstance(item, dict) and "pr_label" in item:
            label = item["pr_label"]
            if (
                set(item) != {"pr_label"}
                or not isinstance(label, str)
                or not label.strip()
            ):
                raise DeclarationError(
                    f"{where} pr_label must be one nonempty label name"
                )
            labels.append(label)
        else:
            paths.append(item)
    return {
        **compile_filters(paths, groups, graph, where),
        "labels": sorted(set(labels)),
    }


def selects(filters):
    """Whether a compiled filter list can select anything."""
    return bool(
        filters["crates"]
        or filters["labels"]
        or any(not p.startswith("!") for p in filters["paths"])
    )


def compile_title(title, where):
    if (
        not isinstance(title, str)
        or len(title) > TITLE_LENGTH
        or not TITLE.match(title)
    ):
        raise DeclarationError(
            f"{where} title must have 1-{TITLE_LENGTH} characters: letters, "
            "digits, spaces, and _.,()+-, starting with a letter or digit"
        )
    reserved = {name.casefold() for name in RESERVED_NAMES}
    if title.casefold() in reserved or title.endswith(ADVISORY_SUFFIX):
        raise DeclarationError(f"{where} title {title!r} is reserved")
    return title


def compile_runner(value, where):
    """A {pr, merge} pair of runner labels from the allowlist."""
    if not isinstance(value, dict) or set(value) != {"pr", "merge"}:
        raise DeclarationError(f"{where} needs exactly the keys pr and merge")
    for key in ("pr", "merge"):
        if value[key] not in RUNNER_LABELS:
            raise DeclarationError(
                f"{where}.{key} {value[key]!r} is not an allowed runner label: "
                + ", ".join(sorted(RUNNER_LABELS))
            )
    return {"pr": value["pr"], "merge": value["merge"]}


def compile_inputs(suite, name):
    """The `with` values and runner inputs that the caller passes."""
    given = suite.get("with", {})
    if not isinstance(given, dict):
        raise DeclarationError(f"Suite {name} with must map input names to values")
    for key, value in given.items():
        if not isinstance(key, str) or not INPUT_NAME.match(key):
            raise DeclarationError(f"Suite {name} with has a bad input name {key!r}")
        # YAML reads `yes`, numbers, and dates in surprising ways; only these
        # types reach a workflow input unchanged.
        if not isinstance(value, (str, bool, int, float)):
            raise DeclarationError(
                f"Suite {name} with.{key} must be a string, boolean, or number"
            )
    runners = suite.get("runners", {})
    if not isinstance(runners, dict):
        raise DeclarationError(
            f"Suite {name} runners must map input names to {{pr, merge}} labels"
        )
    compiled = {}
    for key, value in runners.items():
        if not isinstance(key, str) or not INPUT_NAME.match(key):
            raise DeclarationError(f"Suite {name} runners has a bad input name {key!r}")
        if key in given:
            raise DeclarationError(
                f"Suite {name} passes input {key} in both with and runners"
            )
        compiled[key] = compile_runner(value, f"{name}.runners.{key}")
    return dict(given), compiled


def compile_products(products, groups, graph):
    if not isinstance(products, dict):
        raise DeclarationError(
            "products must map product group names to their title and path_filters"
        )
    compiled = {}
    for group, spec in products.items():
        if not isinstance(group, str) or not GROUP_NAME.match(group):
            raise DeclarationError(
                f"Product group {group!r} needs a name of lowercase letters, digits, and underscores"
            )
        if not isinstance(spec, dict) or set(spec) != {"title", "path_filters"}:
            raise DeclarationError(
                f"Product group {group} needs exactly the keys title and path_filters"
            )
        filters = compile_filters(
            spec["path_filters"], groups, graph, f"products.{group}"
        )
        if not filters["crates"] and not filters["paths"]:
            raise DeclarationError(f"Product group {group} needs path_filters")
        compiled[group] = {
            "title": compile_title(spec["title"], f"Product group {group}"),
            **filters,
        }
    return compiled


def compile_declaration(root: Path = ROOT, declaration=None):
    data = (
        declaration
        if declaration is not None
        else yaml.safe_load((root / DECLARATION).read_text())
    )
    # Every key is explicit. Nothing has a default.
    if not isinstance(data, dict) or set(data) != TOP_KEYS:
        raise DeclarationError(
            f"The declaration needs exactly these keys: {sorted(TOP_KEYS)}"
        )
    if data["version"] != 1:
        raise DeclarationError("Unsupported declaration version")
    runners = data["runners"]
    if not isinstance(runners, dict) or set(runners) != set(GENERATED_RUNNERS):
        raise DeclarationError(
            f"runners needs exactly the keys {', '.join(GENERATED_RUNNERS)}"
        )
    runners = {
        key: compile_runner(runners[key], f"runners.{key}") for key in GENERATED_RUNNERS
    }
    graph = CargoGraph(root)
    groups = data["path_groups"]
    products = compile_products(data["products"], groups, graph)
    suites = {}
    for name, suite in data["suites"].items():
        if (
            not isinstance(name, str)
            or not SUITE_NAME.match(name)
            or name in ("lint", "test")
            or name.startswith("products_")
            or name.endswith("_advisory")
        ):
            raise DeclarationError(
                f"Suite {name!r} needs a key of lowercase letters, digits, and "
                "underscores that is not lint, test, products_*, or *_advisory"
            )
        if not isinstance(suite, dict) or not REQUIRED_SUITE_KEYS <= set(suite) <= set(
            SUITE_KEYS
        ):
            keys = set(suite) if isinstance(suite, dict) else set()
            missing = sorted(REQUIRED_SUITE_KEYS - keys)
            extra = sorted(keys - set(SUITE_KEYS))
            raise DeclarationError(
                f"Suite {name} is missing keys {missing} or has unknown keys {extra}"
            )
        title = compile_title(suite["title"], f"Suite {name}")
        if suite["phase"] not in ("lint", "test") or not isinstance(
            suite["workflow"], str
        ):
            raise DeclarationError(
                f"Suite {name} needs a phase (lint or test) and a workflow"
            )
        run_on = as_list(suite["run_on"], f"{name}.run_on")
        if not run_on or set(run_on) - set(EVENT_KINDS):
            raise DeclarationError(
                f"Suite {name} run_on must use {', '.join(EVENT_KINDS)}"
            )
        # The draft name of the Test gate says that no test suite runs on drafts.
        if suite["phase"] == "test" and "draft_pr_push" in run_on:
            raise DeclarationError(
                f"Suite {name} is a test suite; test suites do not run on drafts"
            )
        if not isinstance(suite["disable_on_forks"], bool):
            raise DeclarationError(
                f"Suite {name} disable_on_forks must be true or false"
            )
        if suite["secrets"] not in SECRET_MODES:
            raise DeclarationError(
                f"Suite {name} secrets must be one of {', '.join(SECRET_MODES)}"
            )
        permissions = suite["permissions"]
        if (
            not isinstance(permissions, dict)
            or not permissions
            or any(
                value not in ("read", "write", "none") for value in permissions.values()
            )
        ):
            raise DeclarationError(
                f"Suite {name} permissions must map scopes to read, write, or none"
            )
        if "covered_by" in suite and not isinstance(suite["covered_by"], str):
            raise DeclarationError(f"Suite {name} covered_by must be a suite name")
        if suite.get("skip_full_runs", True) is not True:
            raise DeclarationError(
                f"Suite {name} skip_full_runs must be true; omit it otherwise"
            )
        filters = compile_pr_filters(
            suite["pr_filters"], groups, graph, f"{name}.pr_filters"
        )
        advisory = compile_pr_filters(
            suite.get("advisory_filters", []),
            groups,
            graph,
            f"{name}.advisory_filters",
        )
        # A list of exclusions alone would make the suite advisory on full
        # runs without any path that selects it.
        if "advisory_filters" in suite and not selects(advisory):
            raise DeclarationError(
                f"Suite {name} advisory_filters must select something; omit an empty list"
            )
        given, runner_inputs = compile_inputs(suite, name)
        waits = as_list(suite["products"], f"{name}.products")
        unknown = sorted(set(waits) - set(products))
        if unknown:
            raise DeclarationError(
                f"Suite {name} waits for unknown product groups {unknown}"
            )
        # The products jobs build for the test phase; the Lint gate does not
        # wait for them.
        if waits and suite["phase"] != "test":
            raise DeclarationError(
                f"Suite {name} is a lint suite and cannot wait for products"
            )
        workflow_files, scopes = workflow_closure(
            root, f"{WORKFLOWS}/{suite['workflow']}"
        )
        declared = set(as_list(suite["kache"], f"{name}.kache"))
        if declared != scopes:
            raise DeclarationError(
                f"Suite {name} declares Kache scopes {sorted(declared)}, "
                f"but its workflows use {sorted(scopes)}"
            )
        suites[name] = {
            "title": title,
            "phase": suite["phase"],
            "workflow": suite["workflow"],
            "run_on": [kind for kind in EVENT_KINDS if kind in run_on],
            "disable_on_forks": suite["disable_on_forks"],
            "secrets": suite["secrets"],
            "permissions": permissions,
            "covered_by": suite.get("covered_by"),
            "skip_full_runs": suite.get("skip_full_runs", False),
            "kache": sorted(declared),
            "products": [group for group in products if group in waits],
            "runners": runner_inputs,
            "with": given,
            "cargo_roots": filters["cargo_roots"],
            "crates": filters["crates"],
            "workflow_files": workflow_files,
            # The workflow files select the suite in its strongest pull request
            # tier: advisory only when pr_filters select nothing, so an
            # always-advisory suite stays advisory when its workflow changes.
            "workflow_tier": "advisory"
            if not selects(filters) and selects(advisory)
            else "blocking",
            "paths": filters["paths"],
            "labels": filters["labels"],
            # A match here selects the suite as advisory, unless a filter
            # above also matches.
            "advisory": advisory,
        }
    # Check names read `<title> / <job name>`, so a title names one suite or
    # product group in its phase.
    titles = collections.Counter(
        [(s["phase"], s["title"].casefold()) for s in suites.values()]
        + [("test", g["title"].casefold()) for g in products.values()]
    )
    repeated = sorted(
        f"{phase} {title!r}" for (phase, title), n in titles.items() if n > 1
    )
    if repeated:
        raise DeclarationError(
            f"Titles must be unique in each phase: {', '.join(repeated)}"
        )
    # A full run keeps a skip_full_runs suite only when its own paths match.
    # A local workflow or action that another suite's workflow also uses
    # (setup-nix, setup-js) is not its own, so it does not select the suite.
    closures = {name: list(suite["workflow_files"]) for name, suite in suites.items()}
    for name, suite in suites.items():
        if suite["skip_full_runs"]:
            others = {
                path
                for other, files in closures.items()
                if suites[other]["workflow"] != suite["workflow"]
                for path in files
            }
            suite["workflow_files"] = [p for p in closures[name] if p not in others]
    for name, suite in suites.items():
        if suite["covered_by"] and suite["covered_by"] not in suites:
            raise DeclarationError(
                f"Suite {name} is covered by unknown suite {suite['covered_by']}"
            )
        # A cycle would drop every suite in it, even from merge runs.
        seen, cover = {name}, suite["covered_by"]
        while cover:
            if cover in seen:
                raise DeclarationError(f"Suite {name} is in a covered_by cycle")
            seen.add(cover)
            cover = suites[cover]["covered_by"]
    unused = [
        g for g in products if not any(g in s["products"] for s in suites.values())
    ]
    if unused:
        raise DeclarationError(f"No suite waits for product groups {unused}")
    on_deleted = as_list(data["on_deleted_path"], "on_deleted_path")
    if not on_deleted or set(on_deleted) - set(suites):
        raise DeclarationError("on_deleted_path must name one or more suites")
    return {
        "generated_by": "dev/ci-suites generate. Edit .github/ci-suites.yml instead.",
        "on_deleted_path": on_deleted,
        "shared": as_list(data["shared"], "shared"),
        "neutral": as_list(data["neutral"], "neutral"),
        "runners": runners,
        "products": products,
        "suites": suites,
    }


def has_advisory_tier(suite):
    advisory = suite["advisory"]
    return bool(advisory["crates"] or advisory["paths"] or advisory["labels"])


def render_manifest(manifest):
    return json.dumps(manifest, indent=2) + "\n"


def scalar(value):
    """A YAML scalar that reads back as `value`: plain when that is safe."""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    text = str(value)
    try:
        if yaml.safe_load(f"key: {text}") == {"key": text}:
            return text
    except yaml.YAMLError:
        pass
    return json.dumps(text)


def runner_value(runner):
    """A label, or an expression that picks the merge label outside pull requests.

    ci.yml runs on pushes only for main, so `push` means a merge run. Manual
    runs use the merge label too, so a dispatch on a branch measures the
    runners of a merge run before the change merges. Pull requests use the
    `pr` label.
    """
    if runner["pr"] == runner["merge"]:
        return runner["pr"]
    return (
        f"${{{{ github.event_name == 'pull_request' && '{runner['pr']}' "
        f"|| '{runner['merge']}' }}}}"
    )


def caller_job(name, suite, tier):
    """One job that calls the suite's workflow when the suite runs in `tier`."""
    blocking = tier == "blocking"
    job = name if blocking else f"{name}_advisory"
    title = suite["title"] if blocking else suite["title"] + ADVISORY_SUFFIX
    output = f"{suite['phase']}_suites" if blocking else "advisory_suites"
    selected = f"contains(fromJSON(needs.detect-changes.outputs.{output}), '{name}')"
    waits = [f"products_{group}" for group in suite["products"]]
    lines = [
        f"  {job}:",
        f"    name: {scalar(title)}",
        "    needs:",
        "    - detect-changes",
    ]
    lines += [f"    - {need}" for need in waits]
    if waits:
        # Without a status function GitHub skips a job whose needed job was
        # skipped; !cancelled() lets the suite build the products itself.
        built = " && ".join(f"needs.{need}.result != 'failure'" for need in waits)
        lines.append(
            f"    if: ${{{{ !cancelled() && needs.detect-changes.result == 'success'"
            f" && {selected} && {built} }}}}"
        )
    else:
        lines.append(f"    if: {selected}")
    lines += [f"    uses: ./{WORKFLOWS}/{suite['workflow']}", "    permissions:"]
    lines += [f"      {key}: {value}" for key, value in suite["permissions"].items()]
    if suite["secrets"] == "inherit":
        lines.append("    secrets: inherit")
    elif suite["secrets"] in SCOPED_SECRETS:
        lines.append("    secrets:")
        lines += [
            f"      {secret}: ${{{{ secrets.{secret} }}}}"
            for secret in SCOPED_SECRETS[suite["secrets"]]
        ]
    inputs = dict(suite["with"])
    inputs.update((key, runner_value(r)) for key, r in suite["runners"].items())
    if inputs:
        lines.append("    with:")
        lines += [f"      {key}: {scalar(value)}" for key, value in inputs.items()]
    return lines


# The gates fail unless detection passed, and then fail on each selected
# blocking suite that did not pass. A failed products job skips the suites that
# wait for it; the gate names the products job once instead of each skipped
# suite. It counts a products job only when a selected blocking suite waits for
# it.
GATE_SCRIPT = r"""if [ "$DETECTED" != success ]; then
  echo "Select suites: $DETECTED"
  exit 1
fi
jq -enr \
  --argjson selected "$SELECTED" \
  --argjson products "$PRODUCTS" \
  --argjson waits "$WAITS" \
  --argjson results "$RESULTS" \
  '[$products[] | select(. as $group | any($selected[]; any(($waits[.] // [])[]; . == $group)))
      | "products_\(.)" | select($results[.].result != "success")] as $broken
  | [$selected[] | select($results[.].result != "success")
      | select(any(($waits[.] // [])[]; "products_\(.)" | IN($broken[])) | not)] as $failed
  | ($broken[] | "\(.): \($results[.].result); the suites that wait for it did not run"),
    ($failed[] | "\(.): \($results[.].result)"),
    ($broken + $failed == [])'
"""


def gate_job(manifest, phase):
    suites = {n: s for n, s in manifest["suites"].items() if s["phase"] == phase}
    groups = list(manifest["products"]) if phase == "test" else []
    name, draft, subset = GATE_NAMES[phase]
    waits = {n: s["products"] for n, s in suites.items() if s["products"]}
    lines = [
        f"  {phase}:",
        "    name: ${{ github.event_name == 'pull_request' && "
        f"toJSON(github.event.pull_request.draft) == 'true' && '{draft}' || "
        f"github.event_name == 'workflow_dispatch' && inputs.suites != '' && '{subset}' || "
        f"'{name}' }}}}",
        # A skipped job counts as a passing required check, so the gate always runs.
        "    if: always()",
        f"    runs-on: {scalar(runner_value(manifest['runners']['gates']))}",
        "    timeout-minutes: 5",
        "    needs:",
        "    - detect-changes",
    ]
    lines += [f"    - products_{group}" for group in groups]
    lines += [f"    - {suite}" for suite in suites]
    lines += [
        "    steps:",
        f"    - name: Check detection and the selected blocking {phase} suites",
        "      env:",
        "        DETECTED: ${{ needs.detect-changes.result }}",
        f"        SELECTED: ${{{{ needs.detect-changes.outputs.{phase}_suites }}}}",
        "        PRODUCTS: "
        + ("${{ needs.detect-changes.outputs.products }}" if groups else "'[]'"),
        f"        WAITS: '{json.dumps(waits, separators=(',', ':'))}'",
        "        RESULTS: ${{ toJSON(needs) }}",
        "      run: |",
    ]
    lines += [f"        {line}" if line else "" for line in GATE_SCRIPT.splitlines()]
    return lines


def products_job(group, spec, runner):
    return [
        f"  products_{group}:",
        f"    name: {scalar(spec['title'])}",
        "    needs:",
        "    - detect-changes",
        f"    if: contains(fromJSON(needs.detect-changes.outputs.products), '{group}')",
        f"    runs-on: {scalar(runner)}",
        # A GitHub-hosted runner (merge and manual runs) has 4 vCPU.
        "    timeout-minutes: "
        + (
            "${{ github.event_name == 'pull_request' && 60 || 120 }}"
            if "${{" in runner
            else "60"
        ),
        "    steps:",
        "    - name: Check out the source",
        f"      uses: {CHECKOUT}",
        # Mode ci pushes what the job builds to xmtp-pr, where the suites'
        # jobs (also mode ci) substitute it. Select suites picks a group only
        # when this token is set.
        "    - name: Set up Nix",
        "      uses: ./.github/actions/setup-nix",
        "      with:",
        "        cache-mode: ci",
        "        cachix-pr-auth-token: ${{ secrets.CACHIX_PR_AUTH_TOKEN }}",
        "        github-token: ${{ github.token }}",
        f"    - name: Build the {group} products",
        f"      run: nix build --keep-going --no-link .#ciSets.{PRODUCTS_SYSTEM}.{group}",
    ]


CI_HEADER = """\
# Generated by dev/ci-suites from .github/ci-suites.yml. Do not edit.
#
# Select suites (job detect-changes) runs dev/ci-select. It picks the blocking
# and advisory suites and the product groups. Each suite has a caller job, and
# a suite with advisory_filters has a second one, <suite>_advisory, for runs
# where only those filters match. The Lint and Test gates need detection, the
# products jobs, and the blocking callers of their phase; they never wait for
# an advisory caller.
name: CI
'on':
  push:
    branches:
    - main
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review, converted_to_draft, labeled, unlabeled]
  workflow_dispatch:
    inputs:
      suites:
        description: Comma-separated suite keys of .github/ci-suites.yml. Empty runs every suite.
        type: string
        required: false
        default: ''
permissions:
  contents: read
concurrency:
  # A pull request push cancels the older run of that pull request. Merge runs
  # and manual runs each have their own group per ref and are never cancelled
  # while they run. GitHub keeps at most one pending run per group, so a newer
  # push to main replaces a merge run that is still waiting: merge runs are
  # latest-wins, and a manual run never replaces a merge run.
  group: ci-${{ github.event.pull_request.number || format('{0}-{1}', github.event_name, github.ref) }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
jobs:
"""

SELECT_JOB = """\
  detect-changes:
    name: Select suites
    runs-on: {runner}
    permissions:
      contents: read
      pull-requests: read
    outputs:
      lint_suites: ${{{{ steps.select.outputs.lint_suites }}}}
      test_suites: ${{{{ steps.select.outputs.test_suites }}}}
      advisory_suites: ${{{{ steps.select.outputs.advisory_suites }}}}
      products: ${{{{ steps.select.outputs.products }}}}
    steps:
    - name: Check out the source
      uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
      with:
        fetch-depth: 2
    - name: Check the shared SDK version
      run: python3 dev/sdk_version.py check
    - name: List changed paths
      id: paths
      if: github.event_name != 'workflow_dispatch'
      continue-on-error: true
      uses: dorny/paths-filter@ceb8a2b8f2d89434be7ff52d3de7ec3738c5cc9d # v4
      with:
        # The action shallow-fetches event.before by exact SHA only when it is missing.
        base: ${{{{ github.ref }}}}
        list-files: json
        filters: |
          all_files:
          - '**'
    - name: Select suites and write summary
      id: select
      env:
        PATHS_OUTCOME: ${{{{ steps.paths.outcome }}}}
        GITHUB_TOKEN: ${{{{ github.token }}}}
        # Whether this run can push to xmtp-pr. Only true or false reaches the
        # script, never the token. Fork runs have no secrets, and Dependabot
        # runs have only Dependabot secrets.
        PR_CACHE_TOKEN: ${{{{ secrets.CACHIX_PR_AUTH_TOKEN != '' }}}}
      # JSON encoding keeps quotes and line breaks in file paths inside data.
      # Use standard input so large file lists do not exceed environment limits.
      # A manual run reads its `suites` input from the event payload.
      run: |
        python3 dev/ci-select <<'CI_PATH_DATA'
        {{
          "changes": ${{{{ toJSON(steps.paths.outputs.changes) }}}},
          "all_files_files": ${{{{ toJSON(steps.paths.outputs.all_files_files) }}}}
        }}
        CI_PATH_DATA
"""


def render_ci(manifest):
    """ci.yml: Select suites, the products jobs, one caller per suite and tier,
    and the Lint and Test gates."""
    runners = manifest["runners"]
    lines = CI_HEADER.splitlines()
    lines += SELECT_JOB.format(
        runner=scalar(runner_value(runners["select"]))
    ).splitlines()
    for group, spec in manifest["products"].items():
        lines += products_job(group, spec, runner_value(runners["products"]))
    for name, suite in manifest["suites"].items():
        lines += caller_job(name, suite, "blocking")
        if has_advisory_tier(suite):
            lines += caller_job(name, suite, "advisory")
    lines += gate_job(manifest, "lint")
    lines += gate_job(manifest, "test")
    return "\n".join(lines) + "\n"


def outputs(manifest):
    return {MANIFEST: render_manifest(manifest), CI_WORKFLOW: render_ci(manifest)}


# --- Validation --------------------------------------------------------------


def tracked_files(root: Path = ROOT):
    output = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-z"], capture_output=True, check=True
    ).stdout
    return sorted(p for p in output.decode().split("\0") if p)


def brace_variants(pattern):
    """Each alternative of each top-level brace group, with the other groups kept.

    A pattern is stale when one alternative can never match, even though another
    alternative in the same group does.
    """
    groups = [(m.start(), m.end()) for m in re.finditer(r"\{[^{}]*\}", pattern)]
    if not groups:
        return [pattern]
    variants = []
    for start, end in groups:
        for option in pattern[start + 1 : end - 1].split(","):
            variants.append(pattern[:start] + option + pattern[end:])
    return variants


def input_type_error(spec, value):
    """Why `value` does not fit a workflow_call input, or None."""
    kind = (spec or {}).get("type", "string")
    if isinstance(value, str) and "${{" in value:
        return None
    if kind == "boolean" and not isinstance(value, bool):
        return "a boolean"
    if kind == "number" and (
        isinstance(value, bool) or not isinstance(value, (int, float))
    ):
        return "a number"
    if kind == "string" and not isinstance(value, str):
        return "a string"
    return None


def validate_inputs(name, suite, document, triggers):
    """The generated caller passes every required input, and only declared ones."""
    errors = []
    workflow = suite["workflow"]
    inputs = (triggers["workflow_call"] or {}).get("inputs") or {}
    given = {**suite["with"], **dict.fromkeys(suite["runners"])}
    for key in given:
        if key not in inputs:
            errors.append(f"{name}: {workflow} has no workflow_call input {key}")
    required = sorted(
        key
        for key, spec in inputs.items()
        if (spec or {}).get("required") and key not in given
    )
    if required:
        errors.append(
            f"{name}: {workflow} requires inputs {required}; pass them in with"
        )
    for key, value in suite["with"].items():
        wanted = input_type_error(inputs.get(key), value) if key in inputs else None
        if wanted:
            errors.append(f"{name}: with.{key} must be {wanted}")
    jobs = document.get("jobs") or {}
    for key in suite["runners"]:
        if key not in inputs:
            continue
        if (inputs[key] or {}).get("type") != "string":
            errors.append(f"{name}: {workflow} input {key} must have type string")
        reads = re.compile(rf"\binputs\.{re.escape(key)}(?![\w-])")
        if not any(reads.search(str(job.get("runs-on", ""))) for job in jobs.values()):
            errors.append(f"{name}: no job of {workflow} runs on inputs.{key}")
    return errors


def validate(manifest, root: Path = ROOT, files=None):
    selector = load_selector()
    errors = []
    for name, suite in manifest["suites"].items():
        document = yaml.safe_load((root / WORKFLOWS / suite["workflow"]).read_text())
        # YAML 1.1 reads the `on` key as True.
        triggers = document.get("on", document.get(True))
        if not isinstance(triggers, dict) or "workflow_call" not in triggers:
            errors.append(f"{name}: {suite['workflow']} is not a reusable workflow")
        else:
            errors += validate_inputs(name, suite, document, triggers)
        # GitHub rejects the whole run when a called job asks for more than the
        # suite grants, even when that job's `if` skips it.
        for job_id, job in (document.get("jobs") or {}).items():
            permissions = job.get("permissions") or {}
            if not isinstance(permissions, dict):
                errors.append(
                    f"{name}: {suite['workflow']} job {job_id} must list permission scopes"
                )
                continue
            for scope, level in permissions.items():
                if (
                    PERMISSION_LEVELS[level]
                    > PERMISSION_LEVELS[suite["permissions"].get(scope, "none")]
                ):
                    errors.append(
                        f"{name}: {suite['workflow']} job {job_id} needs {scope}: {level}"
                    )
        if suite["secrets"] in SCOPED_SECRETS:
            declared = (
                (triggers if isinstance(triggers, dict) else {}).get("workflow_call")
                or {}
            ).get("secrets") or {}
            missing = [s for s in SCOPED_SECRETS[suite["secrets"]] if s not in declared]
            if missing:
                errors.append(
                    f"{name}: {suite['workflow']} must declare workflow_call secrets {missing}"
                )
    files = tracked_files(root) if files is None else files
    rules = selector.Rules(manifest)
    unknown = [f for f in files if not rules.known(f)]
    if unknown:
        errors.append("Tracked files that no rule names:\n  " + "\n  ".join(unknown))
    patterns = [("shared", p) for p in manifest["shared"]]
    patterns += [("neutral", p) for p in manifest["neutral"]]
    for group, spec in manifest["products"].items():
        patterns += [(f"products.{group}", p.lstrip("!")) for p in spec["paths"]]
    for name, suite in manifest["suites"].items():
        patterns += [(name, p.lstrip("!")) for p in suite["paths"]]
        patterns += [
            (f"{name} (advisory)", p.lstrip("!")) for p in suite["advisory"]["paths"]
        ]
    stale = sorted(
        {
            f"{owner}: {variant}"
            for owner, pattern in patterns
            for variant in brace_variants(pattern)
            if not any(selector.glob_match(variant, f) for f in files)
        }
    )
    if stale:
        errors.append("Patterns that match no tracked file:\n  " + "\n  ".join(stale))
    return errors


# --- Commands ----------------------------------------------------------------


def command_generate():
    for path, text in outputs(compile_declaration()).items():
        (ROOT / path).write_text(text)
        print(f"Wrote {path}")


def command_check():
    try:
        manifest = compile_declaration()
    except DeclarationError as error:
        sys.exit(f"error: {error}")
    errors = []
    for path, text in outputs(manifest).items():
        if not (ROOT / path).exists() or (ROOT / path).read_text() != text:
            errors.append(f"{path} is stale. Run: dev/ci-suites generate")
    errors += validate(manifest)
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        sys.exit(1)
    print("CI suite declaration is valid and the generated files are current.")


def explain(rules, path):
    """What one changed path selects, by tier."""
    if rules.shared(path):
        return "shared (every suite)"
    if not rules.known(path):
        return "unknown (every suite)"
    blocking = rules.suites_for(path)
    advisory = [name for name in rules.advisory_for(path) if name not in blocking]
    parts = []
    if blocking:
        parts.append("blocking: " + ", ".join(blocking))
    if advisory:
        parts.append("advisory: " + ", ".join(advisory))
    verdict = "; ".join(parts) or "no suite"
    if rules.neutral(path):
        verdict += " (neutral)"
    # A group runs only for a blocking suite that waits for it (dev/ci-select).
    waited = {
        g for name in blocking for g in rules.manifest["suites"][name]["products"]
    }
    groups = [g for g in rules.products_for(path) if g in waited]
    if groups:
        verdict += "; products: " + ", ".join(groups)
    return verdict


def command_explain(paths):
    selector = load_selector()
    rules = selector.Rules(json.loads((ROOT / MANIFEST).read_text()))
    for path in paths:
        print(f"{path}: {explain(rules, path)}")


def command_replay(count=100, ref="origin/main"):
    selector = load_selector()
    log = subprocess.run(
        [
            "git",
            "-C",
            str(ROOT),
            "log",
            "--first-parent",
            f"-{count}",
            "--format=%H",
            ref,
        ],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.split()
    payload = {
        "repository": {"full_name": "r"},
        "pull_request": {"draft": False, "head": {"repo": {"full_name": "r"}}},
    }
    full = 0
    blocking, advisory = collections.Counter(), collections.Counter()
    reasons, causes = collections.Counter(), collections.Counter()
    for sha in log:
        files = subprocess.run(
            [
                "git",
                "-C",
                str(ROOT),
                "diff-tree",
                "--no-commit-id",
                "--name-only",
                "-r",
                f"{sha}^",
                sha,
            ],
            capture_output=True,
            text=True,
        ).stdout.split()
        result = selector.select_suites(
            files, "pull_request", payload, "success", len(files)
        )
        full += bool(result["reasons"])
        reasons.update(result["reasons"])
        causes.update(result["shared_paths"] + result["unknown_paths"])
        blocking.update(result["suites"]["lint"] + result["suites"]["test"])
        blocking.update(f"products_{group}" for group in result["products"])
        advisory.update(result["advisory"])
    total = len(log)
    print(
        f"{total} commits, {full} full runs ({100 * full / total:.0f}%), reasons {dict(reasons)}"
    )
    print(
        "Most common full-run paths:",
        ", ".join(f"{p} ({n})" for p, n in causes.most_common(10)),
    )
    print(f"  {'':26} blocking advisory")
    names = list(selector.SUITES) + [
        f"products_{g}" for g in selector.MANIFEST["products"]
    ]
    for name in sorted(names, key=lambda n: (-blocking[n], -advisory[n])):
        print(
            f"  {name:26} {100 * blocking[name] / total:7.0f}% "
            f"{100 * advisory[name] / total:7.0f}%"
        )


def main(argv):
    if not argv:
        sys.exit(__doc__)
    command, rest = argv[0], argv[1:]
    if command == "generate":
        command_generate()
    elif command == "check":
        command_check()
    elif command == "explain" and rest:
        command_explain(rest)
    elif command == "replay":
        command_replay(int(rest[0]) if rest else 100, *rest[1:2])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
