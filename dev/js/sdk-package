#!/bin/bash
# Stage a public generated SDK and copy its complete product for local imports.
source "$(dirname "$0")/.setup"

target="${1:-}"
case "$target" in
  node|browser) ;;
  *) echo "usage: $0 node|browser" >&2; exit 2 ;;
esac

cd "$ROOT"
# This helper stages what it generates. Another generated tree goes straight to
# crates/xmtp_sdk/dev/stage-package.mjs.
if [[ -n "${XMTP_SDK_GENERATED_DIR:-}" ]]; then
  echo "$0 generates its own input; unset XMTP_SDK_GENERATED_DIR (XMTP_SDK_BUILD=nix copies the Nix products)" >&2
  exit 2
fi
if [[ "${XMTP_SDK_BUILD:-cargo}" == nix ]]; then
  # The Nix route copies built trees, so it needs no Rust shell.
  crates/xmtp_sdk/dev/generate --targets "$target"
else
  NIX_DEVSHELL=rust "$ROOT/dev/nix-shell" "just sdk generate $target"
fi
node crates/xmtp_sdk/dev/stage-package.mjs "$target" --public

product="${XMTP_SDK_PACKAGES_DIR:-${ROOT}/target/sdk-packages}/${target}"
destination="${ROOT}/sdks/${target}/dist"
temporary="$(mktemp -d "${ROOT}/sdks/${target}/.sdk-dist-XXXXXX")"
trap 'rm -rf "$temporary"' EXIT
cp -RL "$product/." "$temporary/"
chmod -R u+w "$temporary"
if [[ -e "$destination" ]]; then
  chmod -R u+w "$destination"
  rm -rf "$destination"
fi
mv "$temporary" "$destination"
echo "SDK local imports staged: $destination"
