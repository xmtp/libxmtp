#!/bin/bash
# Run Compose for the TLS validation stack. Load this worktree's environment
# first, so every call resolves the backend to this worktree's image. A call
# without it would resolve the default tag and could recreate the backend.
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/../.." && pwd)"
"${repo_root}/dev/worktree-env"
# shellcheck disable=SC1091  # generated by dev/worktree-env
. "${repo_root}/dev/docker/load-env"
exec docker compose -f "$script_dir/compose.yml" -p libxmtp-tls "$@"
