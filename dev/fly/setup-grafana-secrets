#!/usr/bin/env bash
set -euo pipefail

# Run once before the first Grafana deployment. Never print credential values.
if flyctl secrets list --app xmtp-backend-dev-grafana --json |
  jq -e 'any(.[]; .Name == "GF_SECURITY_ADMIN_PASSWORD")' >/dev/null; then
  echo "Grafana already has an admin password. Use its UI to rotate it." >&2
  exit 1
fi
authorization="$(flyctl tokens create readonly --org xmtp-labs \
  --name backend-dev-grafana --expiry 8760h)"
if [[ "$authorization" != FlyV1\ * || "$authorization" == *$'\n'* ]]; then
  echo "Unexpected Fly token response; no secrets were imported." >&2
  exit 1
fi
password="$(openssl rand -hex 32)"
printf 'GF_SECURITY_ADMIN_PASSWORD=%s\nFLY_METRICS_AUTHORIZATION=%s\n' \
  "$password" "$authorization" |
  flyctl secrets import --stage --app xmtp-backend-dev-grafana
