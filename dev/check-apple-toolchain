#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != Darwin ]]; then
  echo "This check requires macOS." >&2
  exit 1
fi

# Exercise both cc-rs's native compiler selection and Cargo's native linker.
# No Xcode version or SDK path is fixed here.
compiler="${CC_aarch64_apple_darwin:-${CC:-cc}}"
linker="${CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER:-cc}"
sdk="${SDKROOT:-$(/usr/bin/xcrun --sdk macosx --show-sdk-path)}"
check_dir="$(mktemp -d -t xmtp-apple-toolchain.XXXXXX)"
trap 'rm -f "$check_dir/c" "$check_dir/rust"; rmdir "$check_dir"' EXIT

printf '#include <stdio.h>\nint main(void) { return puts("C SDK link passed") < 0; }\n' |
  "$compiler" --target=arm64-apple-macosx -isysroot "$sdk" -x c - -o "$check_dir/c"
"$check_dir/c"
printf 'fn main() { println!("Rust SDK link passed"); }\n' |
  rustc - --crate-name apple_sdk_smoke -C "linker=$linker" -o "$check_dir/rust"
"$check_dir/rust"
