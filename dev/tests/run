#!/usr/bin/env python3.11
"""Run every dev test module that `just test dev` owns.

Each start directory contributes its `test_*.py` files. A new test file in one
of these directories runs without a recipe or workflow edit.

Each module runs in its own Python process, and up to WORKERS processes run at
the same time. The tests import sibling modules by bare name, so a module's
process has its start directory first on `sys.path`. A test cannot pass here
by importing a module from another start directory, or by using state that
another module left behind.

The runner captures the output of each process. It prints a module's status
line when the module finishes. After every module finishes, it prints the
failure details to stderr in module order. The last stdout line counts the
tests and the failed modules.
"""

import concurrent.futures
import importlib
import io
import os
import subprocess
import sys
import time
import traceback
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]

START_DIRS = (
    "dev/tests",
    "dev/specs",
    "apps/example-android/fixtures",
    "apps/example-android/performance",
    "nix/lib",
)

# Past 8 processes the wall time stops falling, and more processes that start
# at once make the timing-sensitive tests slower.
WORKERS = min(8, os.cpu_count() or 1)

# The slowest modules start first, so that none of them starts last and sets
# the wall time. A stale name costs only time.
SLOW_FIRST = (
    "dev/tests/test_services.py",
    "dev/tests/test_release_push.py",
    "dev/tests/test_android_emulator_start.py",
    "dev/tests/test_ci_suites.py",
    "dev/tests/test_agents.py",
)

# The last stdout line of a module process: tests run and failed modules.
SUMMARY = "dev-tests-run-summary"


def run_module(path):
    """Import and run one module.

    Return (tests run, tests skipped, failure detail or None).
    """
    output = io.StringIO()
    try:
        module = importlib.import_module(path.stem)
        suite = unittest.defaultTestLoader.loadTestsFromModule(module)
        result = unittest.TextTestRunner(stream=output, verbosity=0).run(suite)
    except KeyboardInterrupt:
        raise
    except BaseException:  # noqa: BLE001
        # An import error, or a SystemExit from setUpModule or setUpClass.
        return 0, 0, output.getvalue() + traceback.format_exc()
    skipped = len(result.skipped)
    if not result.wasSuccessful():
        return result.testsRun, skipped, output.getvalue()
    if result.testsRun == 0:
        return 0, 0, "No tests ran. Use unittest.TestCase classes.\n"
    if skipped and skipped == result.testsRun:
        return result.testsRun, skipped, "Every test was skipped.\n"
    return result.testsRun, skipped, None


def run_one(start, label):
    """Run one module in this process, with its start directory first."""
    # Python put this script's directory first; only the start directory stays.
    runner = Path(__file__).resolve().parent
    sys.path[:] = [p for p in sys.path if not p or Path(p).resolve() != runner]
    sys.path.insert(0, str(ROOT / start))
    started = time.monotonic()
    count, skipped, detail = run_module(ROOT / label)
    seconds = time.monotonic() - started
    status = "ok" if detail is None else "FAIL"
    counts = f"{count} tests, {skipped} skipped, {seconds:.1f} s"
    print(f"{status:5} {label} ({counts})", flush=True)
    if detail is not None:
        print(detail, end="", file=sys.stderr, flush=True)
    print(f"{SUMMARY} {count} {0 if detail is None else 1}", flush=True)
    return 0 if detail is None else 1


def run_child(start, label):
    command = [sys.executable, "-B", __file__, "--module", start, label]
    return subprocess.run(
        command,
        cwd=ROOT,
        capture_output=True,
        text=True,
        errors="replace",
        check=False,
    )


def main():
    if len(sys.argv) == 4 and sys.argv[1] == "--module":
        return run_one(sys.argv[2], sys.argv[3])
    if len(sys.argv) != 1:
        print("Usage: dev/tests/run", file=sys.stderr)
        return 2
    # Module order: START_DIRS, then file names. Failure details use it.
    order = []
    details = {}
    jobs = []
    for start in START_DIRS:
        files = sorted((ROOT / start).glob("test_*.py"))
        if not files:
            order.append(start)
            details[start] = "No test_*.py files. Update START_DIRS.\n"
        for path in files:
            label = path.relative_to(ROOT).as_posix()
            order.append(label)
            jobs.append((start, label))
    # The sort is stable, so the other modules keep module order.
    rank = {label: index for index, label in enumerate(SLOW_FIRST)}
    jobs.sort(key=lambda job: rank.get(job[1], len(rank)))
    total = 0
    pool = concurrent.futures.ThreadPoolExecutor(max_workers=WORKERS)
    try:
        futures = {pool.submit(run_child, *job): job[1] for job in jobs}
        for future in concurrent.futures.as_completed(futures):
            label = futures[future]
            child = future.result()
            summary = None
            for line in child.stdout.splitlines():
                if line.startswith(SUMMARY + " "):
                    summary = line.split()[1:]
                else:
                    print(line, flush=True)
            error = None
            if summary is None:
                error = f"the test process exited {child.returncode} without a summary"
            else:
                total += int(summary[0])
                if child.returncode != 0 and int(summary[1]) == 0:
                    error = f"the test process exited {child.returncode}"
            if error is not None:
                print(f"ERROR {label}: {error}", flush=True)
                details[label] = child.stderr + f"ERROR {label}: {error}\n"
            elif int(summary[1]):
                details[label] = child.stderr
    finally:
        pool.shutdown(cancel_futures=True)
    for label in order:
        if label in details:
            print(f"\n===== {label}\n{details[label]}", file=sys.stderr, flush=True)
    print(f"{total} tests; {len(details)} failed modules", flush=True)
    return 1 if details else 0


if __name__ == "__main__":
    sys.exit(main())
