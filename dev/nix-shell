#!/usr/bin/env bash
# Run a command in a Nix dev shell of this flake.
#
#   dev/nix-shell [--shell NAME] [--refresh] STRING
#   dev/nix-shell [--shell NAME] [--refresh] --command ARGS...
#   dev/nix-shell [--refresh] --print-env [NAME]    (direnv: .envrc)
#
# The evaluated environment (`nix print-dev-env`) is cached under
# ${XDG_CACHE_HOME:-~/.cache}/xmtp/nix-shell, keyed by the system, the shell,
# and the files that the shells read (key_paths), so entry after a source edit
# needs no Nix evaluation. --refresh evaluates again.

set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
shell_name="${NIX_DEVSHELL:-default}"
refresh=false
print_env=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --shell) shell_name="${2:?Expected a shell name}"; shift 2 ;;
    --refresh) refresh=true; shift ;;
    --print-env)
      print_env=true
      shift
      if [[ $# -gt 0 ]]; then shell_name="$1"; shift; fi
      break
      ;;
    *) break ;;
  esac
done
if $print_env; then
  [[ $# -eq 0 ]] || { echo 'Usage: dev/nix-shell [--refresh] --print-env [NAME]' >&2; exit 2; }
elif [[ "${1:-}" == --command ]]; then
  shift
  [[ $# -gt 0 ]] || { echo 'Expected a command after --command' >&2; exit 2; }
  command_args=("$@")
else
  [[ $# -eq 1 ]] || { echo 'Usage: dev/nix-shell [--shell NAME] [--refresh] STRING | --command ARGS...' >&2; exit 2; }
  command_args=(bash -euc "$1")
fi

# The repository files that the dev shells read. A shell file that reads
# another file outside nix/ must add it here; dev/agents/test_agents.py checks
# this. Rust sources, Cargo files, and nested package.json files are not shell
# inputs, so an edit to them keeps the cached environment.
key_paths=(
  nix
  flake.nix
  flake.lock
  package.json
  webdriver.json
  dev/kache-env
  dev/kache-darwin-wrapper
  dev/nix-shell
)
fingerprint="$(
  cd "$REPO_ROOT"
  git ls-files -z --cached --others --exclude-standard -- "${key_paths[@]}" |
    while IFS= read -r -d '' path; do
      if [[ -f "$path" ]]; then printf '%s\0' "$path"; fi
    done |
    # Keep the ordered hash output, but avoid one process per file.
    # The guard preserves the empty-list fingerprint on BSD and GNU xargs.
    xargs -0 -n 128 sh -c 'if [ "$#" -gt 0 ]; then exec shasum -a 256 -- "$@"; fi' sh |
    shasum -a 256
)"
key="$(printf '%s\n%s\n%s\n' "$(uname -sm)" "$shell_name" "$fingerprint" | shasum -a 256)"
key="$shell_name-${key%% *}"
identity="$REPO_ROOT:$shell_name:$key"

cache="${XDG_CACHE_HOME:-$HOME/.cache}/xmtp/nix-shell"
env_file="$cache/$key.sh"
if $refresh || [[ ! -s "$env_file" ]]; then
  mkdir -p "$cache"
  # Entries unused for a week go, with their GC roots.
  find "$cache" -maxdepth 1 -name "$shell_name-*" -mtime +7 -exec rm -f {} + 2>/dev/null || true
  temporary="$(mktemp "$cache/.$key.XXXXXX")"
  # --profile makes the environment a GC root.
  if ! nix print-dev-env --profile "$cache/$key.profile" "$REPO_ROOT#$shell_name" > "$temporary"; then
    rm -f "$temporary"
    exit 1
  fi
  mv "$temporary" "$env_file"
else
  touch "$env_file"
fi

if $print_env; then
  # Keep the caller's temporary directory, not the per-entry one that the
  # environment makes (nix-direnv does the same).
  # shellcheck disable=SC2016
  printf '%s\n' 'xmtp_saved_tmpdir="${TMPDIR-}"'
  cat "$env_file"
  # shellcheck disable=SC2016
  printf '%s\n' \
    'rm -rf "$NIX_BUILD_TOP"' \
    'unset NIX_BUILD_TOP TMP TEMP TEMPDIR' \
    'if [[ -n "$xmtp_saved_tmpdir" ]]; then export TMPDIR="$xmtp_saved_tmpdir"; else unset TMPDIR; fi' \
    'unset xmtp_saved_tmpdir' \
    "export XMTP_NIX_WRAPPER_ID='$identity'"
  exit 0
fi

# This worktree's service ports and URLs (dev/worktree-env writes the file),
# so an ad-hoc `cargo test` reaches this worktree's stack, not slot 0's. A
# variable that the caller set wins.
if [[ -f "$REPO_ROOT/dev/docker/.env" ]]; then
  # shellcheck source=docker/load-env
  . "$REPO_ROOT/dev/docker/load-env"
fi
# A set DATABASE_URL makes the sqlx macros check queries against the live
# database at compile time. Use the committed metadata unless the caller asks.
export SQLX_OFFLINE="${SQLX_OFFLINE:-true}"

# Reuse only an environment entered by this wrapper with the same inputs.
if [[ "${XMTP_NIX_WRAPPER_ID:-}" == "$identity" ]]; then
  exec "${command_args[@]}"
fi
# The environment makes a temporary directory per entry; remove it on exit,
# as `nix develop` does.
# shellcheck disable=SC2016
exec bash -c '
  source "$1"
  trap "rm -rf \"\$NIX_BUILD_TOP\"" EXIT
  export XMTP_NIX_WRAPPER_ID="$2"
  shift 2
  "$@"
' nix-shell "$env_file" "$identity" "${command_args[@]}"
