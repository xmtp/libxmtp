#!/usr/bin/env bash
# Disposable services for one command on an isolated macOS runner.
set -euo pipefail
set -m

export PATH="@tools@:$PATH"
[[ $# -gt 0 ]] || { echo 'Usage: backend-ci COMMAND [ARG ...]' >&2; exit 2; }
umask 077
state="$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/backend-ci.XXXXXX")"
logs="${RUNNER_TEMP:+$RUNNER_TEMP/backend-ci-logs}"
logs="${logs:-$(mktemp -d "${TMPDIR:-/tmp}/backend-ci-logs.XXXXXX")}"
mkdir -p "$logs" "$state/socket" "$state/objects"
touch "$logs/postgres.log" "$logs/s3.log" "$logs/backend.log"
echo "Backend CI logs: $logs"
groups=()
watchdog=

cleanup() {
  result=$?
  trap - EXIT INT TERM USR1
  if [[ -n "$watchdog" ]]; then
    kill -TERM -- "-$watchdog" 2>/dev/null || true
    wait "$watchdog" 2>/dev/null || true
  fi
  # Each asynchronous command has its own process group. This also stops
  # descendants when the command has already returned or ignores TERM.
  for ((i=${#groups[@]}-1; i>=0; i--)); do
    kill -TERM -- "-${groups[i]}" 2>/dev/null || true
  done
  end=$((SECONDS + 20))
  while (( SECONDS < end )); do
    alive=false
    for pid in "${groups[@]}"; do
      if kill -0 -- "-$pid" 2>/dev/null; then alive=true; fi
    done
    "$alive" || break
    sleep 0.1
  done
  for ((i=${#groups[@]}-1; i>=0; i--)); do
    kill -KILL -- "-${groups[i]}" 2>/dev/null || true
    wait "${groups[i]}" 2>/dev/null || true
  done
  # Reap descendants that received KILL after their group leader exited.
  end=$((SECONDS + 5))
  while (( SECONDS < end )); do
    alive=false
    for pid in "${groups[@]}"; do
      if kill -0 -- "-$pid" 2>/dev/null; then alive=true; fi
    done
    "$alive" || break
    sleep 0.1
  done
  rm -rf "$state"
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'echo "Backend CI startup exceeded 120 seconds" >&2; exit 1' USR1

# Refuse existing listeners before starting any service. Keep all sockets
# until all ports have been checked, including wildcard IPv6 listeners.
python3 - <<'PORTS'
import socket
sockets = []
for port in (5050, 9464, 55432, 9067):
    for family, address in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::")):
        s = socket.socket(family)
        if family == socket.AF_INET6:
            s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
        try:
            s.bind((address, port))
        except OSError as e:
            raise SystemExit(f"Backend CI port {port} is unavailable: {e}")
        sockets.append(s)
PORTS

export XMTP_BACKEND_URL=http://127.0.0.1:5050
export DATABASE_URL=postgres://xmtp:xmtp@127.0.0.1:55432/xmtp_backend
export XMTP_DATABASE_URL="$DATABASE_URL" XMTP_REPLICA_URL="$DATABASE_URL"
export XMTP_S3_URL=http://127.0.0.1:9067
export XMTP_S3_BASE_URL=http://127.0.0.1:9067/attachments
export XMTP_CHAIN_31337_URL=http://127.0.0.1:8545
unset OTEL_EXPORTER_OTLP_ENDPOINT

# Isolate setup from caller profiles, credentials, proxies and endpoints.
aws_local() {
  env -i PATH="$PATH" HOME="$state" \
    AWS_CONFIG_FILE="$state/aws-config" AWS_SHARED_CREDENTIALS_FILE="$state/aws-credentials" \
    AWS_ACCESS_KEY_ID=xmtps3 AWS_SECRET_ACCESS_KEY=xmtps3secret \
    AWS_EC2_METADATA_DISABLED=true AWS_PAGER= AWS_MAX_ATTEMPTS=1 \
    aws --endpoint-url "$XMTP_S3_URL" --region us-east-1 \
    --cli-connect-timeout 2 --cli-read-timeout 2 "$@"
}

# Track setup subprocesses too, so cancellation can interrupt initdb or AWS.
setup() {
  "$@" &
  setup_pid=$!
  groups+=("$setup_pid")
  local result=0
  wait "$setup_pid" || result=$?
  unset 'groups[${#groups[@]}-1]'
  return "$result"
}
check_services() {
  for pid in "${services[@]}"; do
    kill -0 "$pid" 2>/dev/null || { echo 'A service exited during startup' >&2; exit 1; }
  done
}
services=()
started=$SECONDS
parent=$$
(sleep 120; kill -USR1 "$parent") &
watchdog=$!
setup initdb -D "$state/postgres" -U xmtp --encoding=UTF8 --locale=C --auth=trust >>"$logs/postgres.log" 2>&1
postgres -D "$state/postgres" -h 127.0.0.1 -p 55432 -k "$state/socket" >>"$logs/postgres.log" 2>&1 &
groups+=("$!"); services+=("$!")
env -i PATH="$PATH" HOME="$state" ROOT_ACCESS_KEY=xmtps3 ROOT_SECRET_KEY=xmtps3secret \
  versitygw --port 127.0.0.1:9067 --cors-allow-origin '*' posix "$state/objects" >>"$logs/s3.log" 2>&1 &
groups+=("$!"); services+=("$!")
until setup pg_isready -h 127.0.0.1 -p 55432 -U xmtp >/dev/null 2>&1; do
  check_services
  sleep 0.1
done
setup createdb -h 127.0.0.1 -p 55432 -U xmtp xmtp_backend >>"$logs/postgres.log" 2>&1
until setup aws_local s3api list-buckets >>"$logs/s3.log" 2>&1; do
  check_services
  sleep 0.1
done
{
  setup aws_local s3api create-bucket --bucket attachments
  setup aws_local s3api put-bucket-policy --bucket attachments --policy file://@policy@
  setup aws_local s3api put-bucket-cors --bucket attachments --cors-configuration file://@cors@
} >>"$logs/s3.log" 2>&1
check_services
@backend@ --config-file @config@ >>"$logs/backend.log" 2>&1 &
groups+=("$!"); services+=("$!")
until setup grpc-health-probe -addr=127.0.0.1:5050 -connect-timeout=1s -rpc-timeout=1s >>"$logs/backend.log" 2>&1; do
  check_services
  sleep 0.1
done
check_services
kill -TERM -- "-$watchdog" 2>/dev/null || true
wait "$watchdog" 2>/dev/null || true
watchdog=
echo "Backend CI ready after $((SECONDS - started)) seconds"
"$@" &
groups+=("$!")
wait "${groups[${#groups[@]}-1]}"
