#!/bin/bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/../.." && pwd)"
"${repo_root}/dev/worktree-env"
# shellcheck disable=SC1091  # generated by dev/worktree-env
set -a && . "${script_dir}/.env" && set +a
exec docker compose -f "$script_dir/compose.yml" -p "${XMTP_COMPOSE_PROJECT}" down "$@"
