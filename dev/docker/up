#!/bin/bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/../.." && pwd)"

# Resolve this worktree's project name and port block, then refuse to start if
# another stack already holds one of our ports. Sharing a database and backend
# between two worktrees corrupts test state in ways that are hard to diagnose,
# so fail loudly here instead.
"${repo_root}/dev/worktree-env" --check
# shellcheck disable=SC1091  # generated by dev/worktree-env
set -a && . "${script_dir}/.env" && set +a

# The pre-worktree stack used the project name `xmtp-backend`. Its containers
# are not orphans of this project, so `--remove-orphans` leaves them running.
if docker ps --filter label=com.docker.compose.project=xmtp-backend --format '{{.Ports}}' |
  grep -q ":${XMTP_BACKEND_DB_PORT}->"; then
  echo "Port ${XMTP_BACKEND_DB_PORT} is used by the old stack. Run docker compose -p xmtp-backend down once." >&2
fi

echo "stack '${XMTP_COMPOSE_PROJECT}' (slot ${XMTP_WORKTREE_SLOT}): backend ${XMTP_BACKEND_URL}, db ${XMTP_BACKEND_DB_PORT}"
exec docker compose -f "$script_dir/compose.yml" -p "${XMTP_COMPOSE_PROJECT}" up --detach --remove-orphans --wait "$@"
