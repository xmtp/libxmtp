#!/bin/bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/../.." && pwd)"

# Resolve this worktree's project name and port block, then refuse to start if
# another stack already holds one of our ports. Sharing a database and backend
# between two worktrees corrupts test state in ways that are hard to diagnose,
# so fail loudly here instead.
"${repo_root}/dev/worktree-env" --check
# shellcheck source=load-env
. "${script_dir}/load-env"

echo "stack '${XMTP_COMPOSE_PROJECT}' (slot ${XMTP_WORKTREE_SLOT}): backend ${XMTP_BACKEND_URL}, db ${XMTP_BACKEND_DB_PORT}"
if docker compose -f "$script_dir/compose.yml" -p "${XMTP_COMPOSE_PROJECT}" up --detach --remove-orphans --wait "$@"; then
  exit 0
else
  startup_status=$?
fi

# Whether the requested services, with their dependencies, run this worktree's
# backend image. Flags are dropped; a flag value makes `config` fail, and then
# the answer is no. `config` has no --no-deps, so handle that flag here: only
# the named services start, and only `backend` runs the image.
needs_backend_image() {
  local services=() arg no_deps=false
  for arg in "$@"; do
    case "${arg}" in
      --no-deps) no_deps=true ;;
      -*) ;;
      *) services+=("${arg}") ;;
    esac
  done
  if [ "${no_deps}" = true ]; then
    case " ${services[*]-} " in *" backend "*) return 0 ;; *) return 1 ;; esac
  fi
  docker compose -f "$script_dir/compose.yml" -p "${XMTP_COMPOSE_PROJECT}" \
    config --images ${services[@]+"${services[@]}"} 2>/dev/null |
    grep -qxF -- "${XMTP_BACKEND_IMAGE}"
}

# This worktree's backend tag exists only after `just backend up` loads it, so a
# bare `dev/docker/up` fails with a pull error from Compose. Name the fix, but
# only for a start that needs that image: `db-up` does not.
if [ "${XMTP_BACKEND_IMAGE:-}" = "xmtp-backend:${XMTP_COMPOSE_PROJECT}" ] &&
  ! docker image inspect "${XMTP_BACKEND_IMAGE}" >/dev/null 2>&1 &&
  needs_backend_image "$@"; then
  echo "Backend image ${XMTP_BACKEND_IMAGE} is not loaded. Run 'just backend up' to build and load it." >&2
fi

# Keep the failed project's logs and state before a runner removes its containers.
# Inspect only State: a full inspect would also retain environment credentials.
# Diagnostics are best effort and must never replace Compose's failure status.
collect_startup_diagnostics() {
  local logs_root diagnostics_dir container_id
  logs_root="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/backend-startup-logs"
  if ! mkdir -p "$logs_root" || ! diagnostics_dir="$(mktemp -d "$logs_root/startup.XXXXXX")"; then
    echo "Unable to create backend startup diagnostics in $logs_root" >&2
    return
  fi
  printf '%s\n' "$XMTP_COMPOSE_PROJECT" > "$diagnostics_dir/project.txt"
  echo "Backend startup diagnostics: $diagnostics_dir" >&2
  docker compose -f "$script_dir/compose.yml" -p "$XMTP_COMPOSE_PROJECT" logs --no-color --timestamps \
    > "$diagnostics_dir/compose.log" 2> "$diagnostics_dir/diagnostic-errors.log" || true
  docker compose -f "$script_dir/compose.yml" -p "$XMTP_COMPOSE_PROJECT" ps --all \
    > "$diagnostics_dir/compose-ps.txt" 2>> "$diagnostics_dir/diagnostic-errors.log" || true
  docker compose -f "$script_dir/compose.yml" -p "$XMTP_COMPOSE_PROJECT" ps --all --quiet \
    > "$diagnostics_dir/container-ids.txt" 2>> "$diagnostics_dir/diagnostic-errors.log" || true
  while IFS= read -r container_id; do
    [ -n "$container_id" ] || continue
    docker inspect --format '{"name":{{json .Name}},"state":{{json .State}}}' "$container_id" \
      >> "$diagnostics_dir/container-state.jsonl" 2>> "$diagnostics_dir/diagnostic-errors.log" || true
  done < "$diagnostics_dir/container-ids.txt"
}

(umask 077; collect_startup_diagnostics) || true
exit "$startup_status"
