#!/usr/bin/env python3.11
"""Check the normal dependencies among the ten xmtp_mls crates.

Usage: dev/split/crate-graph [--metadata FILE]

Reads the declared dependencies of every workspace package from
`cargo metadata --no-deps` (or FILE, the output of that command) and
compares the normal edges among the crates of dev/split/crate-graph.toml,
on every target platform, with its `allowed` table. Exits 1 and lists each
extra or missing edge when they differ. Dev and build dependencies are not
checked. Run it through `dev/nix-shell`.

Temporary split validation; Task 24 deletes it after the final graph
evidence is recorded.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[2]
CONFIG = ROOT / "dev" / "split" / "crate-graph.toml"


def metadata(path: str | None) -> dict:
    if path is not None:
        return json.loads(Path(path).read_text())
    out = subprocess.run(
        ["cargo", "metadata", "--format-version", "1", "--no-deps", "--locked"],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    return json.loads(out)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--metadata", help="cargo metadata --no-deps output")
    args = parser.parse_args()

    allowed = {
        crate: set(deps)
        for crate, deps in tomllib.loads(CONFIG.read_text())["allowed"].items()
    }
    crates = set(allowed)
    packages = {p["name"]: p for p in metadata(args.metadata)["packages"]}

    failures = []
    for crate in sorted(crates - packages.keys()):
        failures.append(f"{crate}: not a workspace package")
    for crate in sorted(crates & packages.keys()):
        actual = {
            dep["name"]
            for dep in packages[crate]["dependencies"]
            if dep["kind"] is None and dep["name"] in crates
        }
        for dep in sorted(actual - allowed[crate]):
            failures.append(f"{crate} -> {dep}: edge not in the Target crates table")
        for dep in sorted(allowed[crate] - actual):
            failures.append(f"{crate} -> {dep}: table edge missing")

    if failures:
        print("\n".join(failures), file=sys.stderr)
        return 1
    edges = sum(len(deps) for deps in allowed.values())
    print(f"crate-graph: {len(crates)} crates, {edges} normal edges match")
    return 0


if __name__ == "__main__":
    sys.exit(main())
