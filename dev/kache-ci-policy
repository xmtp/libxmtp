#!/usr/bin/env bash
# Check a job's cache mode and decide whether Kache may upload.
#
# The rule: a job that reads the CI-only Cachix cache `xmtp-pr` writes no
# trusted store (Cachix `xmtp`, Kache S3). `read` reads `xmtp` and writes
# nothing; `ci` reads `xmtp` and `xmtp-pr` and writes only `xmtp-pr`;
# `trusted` reads `xmtp` and may write `xmtp` and Kache S3, and runs only on a
# protected push to trunk.
set -euo pipefail

fail() {
  printf '::error title=Cache mode::%s\n' "$1" >&2
  exit 1
}

mode=${XMTP_CACHE_MODE:-read}
case "$mode" in
  read|ci|trusted) ;;
  *) fail "cache-mode must be read, ci, or trusted, not '$mode'" ;;
esac

protected_push=false
if [[ "${GITHUB_ACTIONS:-}" == true && "${GITHUB_EVENT_NAME:-}" == push && "${GITHUB_REF_TYPE:-}" == branch && "${GITHUB_REF_PROTECTED:-}" == true ]]; then
  case "${GITHUB_REF:-}" in
    refs/heads/main|refs/heads/self-hosted) protected_push=true ;;
  esac
fi

if [[ "$mode" == trusted && "$protected_push" != true ]]; then
  fail 'cache-mode trusted runs only on a protected push to main or self-hosted'
fi
if [[ "$mode" != ci && "${XMTP_CACHIX_PR_TOKEN:-false}" == true ]]; then
  fail "cache-mode $mode must not receive the xmtp-pr token"
fi
if [[ "$mode" == read && "${XMTP_CACHIX_TOKEN:-false}" == true ]]; then
  fail 'cache-mode read must not receive the trusted Cachix token'
fi

# Kache uploads need S3, an explicit writer opt-in, and mode trusted. Mode ci
# reads xmtp-pr, so its Kache is read-only on every event.
write=false
if [[ "$mode" == trusted && "$protected_push" == true && "${KACHE_CI_BACKEND:-}" == s3 && "${KACHE_CI_READONLY:-true}" == false ]]; then
  write=true
fi
printf 'cache-write=%s\n' "$write" >> "${GITHUB_OUTPUT:?GITHUB_OUTPUT is required}"
if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  printf 'Cache mode: %s. Kache remote writes: %s.\n' "$mode" "$write" >> "$GITHUB_STEP_SUMMARY"
fi
