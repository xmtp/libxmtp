#!/usr/bin/env bash
# This worktree's test services as native processes, without Docker: the
# PostgreSQL primary and replica, S3, anvil, the backend, and toxiproxy
# (nix/services). The ports are this worktree slot's (dev/worktree-env), so
# the URLs in dev/docker/.env reach this stack.
#
#   dev/services up       # start in the background; return when every service is ready
#   dev/services env      # export lines for this stack
#   dev/services ps       # process states
#   dev/services logs P   # the log of process P
#   dev/services down     # stop, then remove the state and the socket
#
# A variable that the caller sets wins, as in dev/worktree-env:
# XMTP_SERVICES_STATE (state directory), PC_SOCKET_PATH (the daemon socket),
# and XMTP_SERVICES_PACKAGE (a built `services` package to run instead of
# `.#services`; dev/tests/test_services.py runs the storage stack this way).
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

"${repo_root}/dev/worktree-env"
# shellcheck source=docker/load-env
. "${repo_root}/dev/docker/load-env"

state="${XMTP_SERVICES_STATE:-${TMPDIR:-/tmp}}"
[ -n "${XMTP_SERVICES_STATE:-}" ] || state="${state%/}/xmtp-services-${XMTP_COMPOSE_PROJECT}"
export XMTP_SERVICES_STATE="${state}"
# macOS limits a socket path to 104 bytes, and TMPDIR is long there.
export PC_SOCKET_PATH="${PC_SOCKET_PATH:-/tmp/xmtp-services-$(id -u)-${XMTP_WORKTREE_SLOT}.sock}"
# The Android emulator reaches the host loopback at 10.0.2.2; bind all
# interfaces as the Docker stack does.
export XMTP_BACKEND_LISTEN_HOST="${XMTP_BACKEND_LISTEN_HOST:-0.0.0.0}"

# The package that `up` started, so later calls need no evaluation.
package="${XMTP_SERVICES_PACKAGE:-}"
if [ -z "${package}" ] && [ -f "${state}/package" ]; then package="$(cat "${state}/package")"; fi
services() {
  if [ -z "${package}" ]; then
    package="$(nix build --no-link --print-out-paths "${repo_root}#services")"
  fi
  "${package}/bin/services" "$@"
}

running() { [ -S "${PC_SOCKET_PATH}" ] && services project state >/dev/null 2>&1; }

case "${1:-}" in
  up)
    if running; then
      echo "services: already running (${state})" >&2
      exit 0
    fi
    rm -rf "${state}" "${PC_SOCKET_PATH}"
    package="${XMTP_SERVICES_PACKAGE:-}"
    start=${SECONDS}
    services up --detached --use-uds
    printf '%s\n' "${package}" >"${state}/package"
    # Wait until every process is ready. Fail at once when a process failed
    # or was skipped. A service that never gets healthy fails its probe after
    # 120 tries, so the deadline is above that.
    failed='[.[] | select(.status == "Error" or .status == "Skipped"
      or (.status == "Completed" and .exit_code != 0))] | length > 0'
    until services project is-ready >/dev/null 2>&1; do
      if ((SECONDS - start > 150)) ||
        services process list --output json 2>/dev/null | jq -e "${failed}" >/dev/null; then
        diagnostics="$(mktemp -d "${TMPDIR:-/tmp}/xmtp-services-diagnostics.XXXXXX")"
        services process list --output wide >"${diagnostics}/processes.txt" 2>&1 || true
        for name in $(services process list --output json 2>/dev/null | jq -r '.[].name'); do
          services process logs "${name}" --tail 200 >"${diagnostics}/${name}.log" 2>&1 || true
        done
        cp "${state}/process-compose.log" "${diagnostics}/" 2>/dev/null || true
        echo "services: start failed; diagnostics in ${diagnostics}" >&2
        services down >/dev/null 2>&1 || true
        rm -rf "${state}" "${PC_SOCKET_PATH}"
        exit 1
      fi
      sleep 0.2
    done
    echo "services: ready after $((SECONDS - start)) s; backend ${XMTP_BACKEND_URL}" >&2
    ;;
  env) cat "${state}/env" ;;
  ps) services process list --output wide ;;
  logs) services process logs "${2:?usage: dev/services logs PROCESS}" --tail "${3:-100}" ;;
  down)
    if running; then services down; fi
    rm -rf "${state}" "${PC_SOCKET_PATH}"
    ;;
  *)
    echo "usage: dev/services up|env|ps|logs PROCESS|down" >&2
    exit 2
    ;;
esac
