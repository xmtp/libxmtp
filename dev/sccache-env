#!/usr/bin/env bash
# Opt-in shared Rust compilation cache for local development.
#
# Source this (do not execute it) inside the Nix dev shell:
#
#   source dev/sccache-env
#   dev/nix-shell 'dev/agent-run cargo build -p xmtp_common'
#
# Each worktree keeps its own target/ directory and Cargo build lock.
# A shared cache can reuse eligible dependency builds across worktrees.
#
# Keep Cargo's incremental defaults for local crates. sccache passes these
# compilations through and caches eligible non-incremental dependencies.
# Do not set CARGO_INCREMENTAL=1: sccache 0.16 rejects that explicit override.
# Different worktree paths can still cause cache misses for local crates.
#
# This file is never sourced automatically. CI and Nix package builds must not
# use it: `nix build` runs in a sandbox where the cache is unreachable, and CI
# sets its own sccache through .github/actions/setup-nix.

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  echo "dev/sccache-env must be sourced, not executed:" >&2
  echo "  source dev/sccache-env" >&2
  exit 1
fi

if ! command -v sccache >/dev/null 2>&1; then
  echo "sccache not found. Enter the dev shell first (nix develop, or direnv)." >&2
  return 1
fi

# Bounded, self-evicting cache (LRU). Unlike target/, this has a real ceiling.
export SCCACHE_DIR="${SCCACHE_DIR:-${HOME}/.cache/sccache}"
export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-10G}"
RUSTC_WRAPPER="$(command -v sccache)"
export RUSTC_WRAPPER
# Let Cargo profiles choose incremental mode, including local dev defaults.
unset CARGO_INCREMENTAL

echo "sccache enabled: requested dir=${SCCACHE_DIR} max=${SCCACHE_CACHE_SIZE}"
echo "  Cargo incremental defaults restored; eligible dependencies can be cached."
echo "  A running server keeps its cache settings. Check: sccache --show-stats"
echo "  disable: unset RUSTC_WRAPPER"
